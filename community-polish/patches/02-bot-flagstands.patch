+/* 0.39.x: a flag or capture point on a small stand or table (community maps Villa 2.1, Shozen) has no
+   floor under it for a player box, and the 64-unit lattice rarely lands within the 36 units that take a
+   flag (tickFlags). After the graph is built, add floor spots 32 units around it and link each both ways
+   to the lattice nodes a player can walk to in a straight line. The lattice itself is unchanged.
+   Returns how many spots got linked both ways. */
+static int navAttachNear(const float *p)
+{
+    static const float ring[9][2] = {{0,0},{32,0},{-32,0},{0,32},{0,-32},{23,23},{-23,23},{23,-23},{-23,-23}};
+    int linked = 0;
+    for (int k = 0; k < 9 && botNodeCount < TCP_BOT_NODES; k++) {
+        float q[3] = {p[0] + ring[k][0], p[1] + ring[k][1], p[2]}, g[3];
+        if (!navGround(q, g) || fabsf(g[2] - p[2]) > 64.f || navFind(g, 12, 30) >= 0) continue;
+        const int n = navAdd(g); if (n < 0) break;
+        int in = 0;
+        const int cx = botCell(g[0]), cy = botCell(g[1]);
+        for (int dx = -2; dx <= 2; dx++) for (int dy = -2; dy <= 2; dy++)
+            for (int i = botHash[botHashOf(cx + dx, cy + dy)]; i >= 0; i = botNodes[i].next) {
+                if (i == n || botDist(botNodes[i].pos, g) > 112.f || fabsf(botNodes[i].pos[2] - g[2]) > 20.f) continue;
+                float e[3];
+                for (int st = 0; st < 2; st++) {
+                    if (navStep(g, botNodes[i].pos[0] - g[0], botNodes[i].pos[1] - g[1], e, st) && botDist(e, botNodes[i].pos) < 16.f &&
+                        navStep(botNodes[i].pos, g[0] - botNodes[i].pos[0], g[1] - botNodes[i].pos[1], e, st) && botDist(e, g) < 16.f) {
+                        int had = botNodes[i].count; navLink(n, i, st); navLink(i, n, st); if (botNodes[i].count > had) in++;
+                        break;
+                    }
+                }
+            }
+        if (!in) { botHash[botHashOf(cx, cy)] = botNodes[n].next; botNodeCount--; continue; }   /* nothing leads in: take the spot out again (it is the newest node) */
+        linked++;
+    }
+    return linked;
+}
