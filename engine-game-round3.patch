+++ b/game_src/native/tcp_netq_cg.h
@@ -0,0 +1,71 @@
+/* Connection quality on the client (online play round 3, item 2).
+ *
+ * The server measures every player's packet loss, jitter and ping (tcp_netq.h) and sends
+ *   tcp_nq <count> {slot grade loss_x10 jitter ping}
+ * every 2 s. Grades: 0 good, 1 fair, 2 poor, 3 bad.
+ *
+ * Scoreboard: a four-bar connection icon next to each ping, coloured by grade.
+ * cg_netGraph 1: compact line under the round clock (ping, loss, jitter).
+ * cg_netGraph 2: the line plus a 6-second ping graph that marks loss spikes in red.
+ * Older servers send no tcp_nq: the icons and the server numbers simply stay hidden. */
+static vmCvar_t nqGraphCvar;
+static struct {int grade,loss10,jitter,ping,at;} nqSlots[MAX_CLIENTS];
+static int nqLast;                                    /* time of the last tcp_nq, 0 = never */
+#define NQ_HISTORY 60
+static short nqPing[NQ_HISTORY];static unsigned char nqLossMark[NQ_HISTORY];static int nqHead,nqSampleAt,nqLastLoss10;
+
+static void nqInit(void){
+    SystemCall(CG_CVAR_REGISTER,&nqGraphCvar,"cg_netGraph","0",CVAR_ARCHIVE);
+    memset(nqSlots,0,sizeof(nqSlots));nqLast=0;memset(nqPing,0,sizeof(nqPing));memset(nqLossMark,0,sizeof(nqLossMark));nqHead=nqSampleAt=nqLastLoss10=0;
+}
+static void nqServerCommand(int time){
+    char value[16];SystemCall(CG_ARGV,1,value,sizeof(value));
+    int count=atoi(value),fields=(int)SystemCall(CG_ARGC);
+    for(int i=0;i<count&&2+i*5+4<fields;i++){
+        int v[5];for(int f=0;f<5;f++){SystemCall(CG_ARGV,2+i*5+f,value,sizeof(value));v[f]=atoi(value);}
+        if(v[0]<0||v[0]>=MAX_CLIENTS)continue;
+        nqSlots[v[0]].grade=v[1]<0?0:v[1]>3?3:v[1];nqSlots[v[0]].loss10=v[2];nqSlots[v[0]].jitter=v[3];nqSlots[v[0]].ping=v[4];nqSlots[v[0]].at=time;
+    }
+    nqLast=time;
+}
+static const float *nqColor(int grade){
+    static const float c[4][4]={{.35f,.85f,.35f,1},{.95f,.85f,.25f,1},{1,.55f,.15f,1},{.95f,.25f,.25f,1}};
+    return c[grade<0?0:grade>3?3:grade];
+}
+/* Four rising bars, lit by quality: good 4, fair 3, poor 2, bad 1. */
+static void nqDrawBars(float x,float y,int slot,int time){
+    static const float dim[4]={.3f,.3f,.3f,.8f};
+    if(!nqLast||time-nqSlots[slot].at>6000)return;      /* no data for this player */
+    const int grade=nqSlots[slot].grade,lit=4-grade;
+    for(int b=0;b<4;b++){float h=3+b*2.5f;hudFill(x+b*2.5f,y-h,1.8f,h,b<lit?nqColor(grade):dim);}
+}
+static void nqFrame(const playerState_t *p,int time){
+    SystemCall(CG_CVAR_UPDATE,&nqGraphCvar);
+    if(time-nqSampleAt<100&&nqSampleAt)return;
+    nqSampleAt=time;
+    int me=p->clientNum>=0&&p->clientNum<MAX_CLIENTS?p->clientNum:0;
+    int loss10=nqLast?nqSlots[me].loss10:0;
+    nqPing[nqHead]=(short)(snap.ping>999?999:snap.ping<0?0:snap.ping);
+    nqLossMark[nqHead]=(unsigned char)(loss10>nqLastLoss10);nqLastLoss10=loss10;
+    nqHead=(nqHead+1)%NQ_HISTORY;
+}
+static void nqDrawGraph(const playerState_t *p,int time){
+    if(nqGraphCvar.integer<=0)return;
+    static const float back[4]={0,0,0,.45f},line[4]={.55f,.8f,1,.9f},red[4]={.95f,.25f,.25f,.9f};
+    const int me=p->clientNum>=0&&p->clientNum<MAX_CLIENTS?p->clientNum:0;
+    const int fresh=nqLast&&time-nqSlots[me].at<6000;
+    char text[96];
+    if(fresh)snprintf(text,sizeof(text),"%d ms  loss %d.%d%%  jitter %d",snap.ping,nqSlots[me].loss10/10,nqSlots[me].loss10%10,nqSlots[me].jitter);
+    else snprintf(text,sizeof(text),"%d ms",snap.ping);
+    hudTextRight(840,182,.17f,fresh?nqColor(nqSlots[me].grade):hudGrey,text);
+    if(nqGraphCvar.integer<2)return;
+    const float w=120,h=28,x=840-w,y=188;
+    hudFill(x,y,w,h,back);
+    int top=100;for(int i=0;i<NQ_HISTORY;i++)if(nqPing[i]>top)top=nqPing[i];
+    if(top>400)top=400;
+    for(int i=0;i<NQ_HISTORY;i++){
+        int k=(nqHead+i)%NQ_HISTORY;float v=nqPing[k]>top?1.f:nqPing[k]/(float)top;
+        float bx=x+i*(w/NQ_HISTORY);
+        hudFill(bx,y+h-v*h,w/NQ_HISTORY,v*h<1?1:v*h,nqLossMark[k]?red:line);
+    }
+}
