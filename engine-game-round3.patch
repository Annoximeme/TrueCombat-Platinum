+/**
+ * @brief Optional ban length after the target: 30m, 12h, 7d, 2w (or a bare number of minutes
+ * with a trailing 'm'). Returns minutes (0 = permanent) and the argument index the reason starts at.
+ */
+static int SV_AdminBanDuration(int arg, int *reasonStart)
+{
+	const char *s = Cmd_Argv(arg);
+	int        len = (int)strlen(s), i;
+	long       n;
+
+	*reasonStart = arg;
+	if (len < 2)
+	{
+		return 0;
+	}
+	for (i = 0; i < len - 1; i++)
+	{
+		if (s[i] < '0' || s[i] > '9')
+		{
+			return 0;
+		}
+	}
+	n = atol(s);
+	switch (s[len - 1])
+	{
+	case 'm': case 'M': break;
+	case 'h': case 'H': n *= 60; break;
+	case 'd': case 'D': n *= 60 * 24; break;
+	case 'w': case 'W': n *= 60 * 24 * 7; break;
+	default: return 0;
+	}
+	if (n <= 0 || n > 60L * 24 * 365 * 5)
+	{
+		return 0;
+	}
+	*reasonStart = arg + 1;
+	return (int)n;
+}
+
+static void SV_AdminSetExpiry(svAdminBan_t *b, int minutes)
+{
+	b->expires = minutes > 0 ? (long)time(NULL) + minutes * 60L : 0;
+}
+
+static const char *SV_AdminBanLength(int minutes)
+{
+	if (minutes <= 0)
+	{
+		return "permanent";
+	}
+	if (minutes % (60 * 24) == 0)
+	{
+		return va("for %i day(s)", minutes / (60 * 24));
+	}
+	if (minutes % 60 == 0)
+	{
+		return va("for %i hour(s)", minutes / 60);
+	}
+	return va("for %i min", minutes);
+}
