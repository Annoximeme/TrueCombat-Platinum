diff --git a/game_src/native/tcp_netq.h b/game_src/native/tcp_netq.h
new file mode 100644
index 0000000..4300e9b
--- /dev/null
+++ b/game_src/native/tcp_netq.h
@@ -0,0 +1,180 @@
+/* GPL-3.0-or-later. Online play round 3 (thread "Build next online play round"). Included by
+ * tcp_game.c after tcp_report.h.
+ *
+ * Connection quality. Once a second every human's packets received / lost (engine trap
+ * trap_TcpNetStats, absent on older engines: then loss reads 0), ping and ping jitter are
+ * sampled. Each player gets a grade (0 good, 1 fair, 2 poor, 3 bad) that is broadcast every
+ * 2 s as  tcp_nq <count> {slot grade loss_x10 jitter ping}  for the scoreboard icons and the
+ * net graph (cg_netGraph). The per-map averages, the lag compensation rewind (average, how
+ * often it hit the g_antilagMaxMs cap) and how many times a player left go into the match
+ * report (tcp-match/1 "net" object, "leaves").
+ *
+ * Fair play. g_maxPing (0 = off) with g_maxPingTime seconds of grace (default 20): a player
+ * over the limit is warned at half time and then moved to spectator (g_maxPingAction 0) or
+ * kicked (1). Players who drop and come back within g_reconnectKeep seconds (default 300)
+ * get their team, kills, deaths and damage back.
+ *
+ * Pickup teams. With g_pugTeams 1 a player whose userinfo carries tcp_team r|b (set by the
+ * launcher from a Discord pickup join link) always plays on that team.
+ *
+ * Automatic checks. g_cheatFlags 1 (default) watches for statistics no human produces
+ * (headshot rate, accuracy with automatic fire, flick-to-head hits) and files a report
+ * (schema tcp-report/1, "auto": true) for the staff channel. These are leads for an admin
+ * with the server demo, never an automatic ban. */
+#ifndef TCP_NETQ_H
+#define TCP_NETQ_H
+typedef struct {
+    int trapOk,lastRecv,lastDrop,lastPing,grade;
+    float loss,jitter;                     /* smoothed: percent, ms */
+    int highSince,highWarned;
+    /* flick detection: recent command view angles */
+    int angT[8];float angP[8],angY[8];int angHead;
+    int snapHeads,flagged;
+} tcp_netq;
+static tcp_netq netq[TCP_MAX_PLAYERS];
+static int netqTrapId,netqNextSample,netqNextSend,netqNextCheck;
+typedef struct {char guid[33];int team,kills,deaths,suicides,teamKills,damageGiven,damageReceived,teamDamage,hits;unsigned shots;int at;} tcp_netq_keep;
+static tcp_netq_keep netqKeep[TCP_MAX_PLAYERS];
+
+static int netqCvar(const char *name,int def){char v[16]="";SystemCall(G_CVAR_VARIABLE_STRING_BUFFER,name,v,sizeof(v));return v[0]?atoi(v):def;}
+static void TCP_NetqInit(void){
+    memset(netq,0,sizeof(netq));netqNextSample=netqNextSend=netqNextCheck=0;
+    char v[16]="";netqTrapId=SystemCall(G_TRAP_GETVALUE,v,(int)sizeof(v),"trap_TcpNetStats")?atoi(v):0;
+    SystemCall(G_CVAR_REGISTER,NULL,"g_maxPing","0",CVAR_ARCHIVE);
+    SystemCall(G_CVAR_REGISTER,NULL,"g_maxPingTime","20",CVAR_ARCHIVE);
+    SystemCall(G_CVAR_REGISTER,NULL,"g_maxPingAction","0",CVAR_ARCHIVE);
+    SystemCall(G_CVAR_REGISTER,NULL,"g_reconnectKeep","300",CVAR_ARCHIVE);
+    SystemCall(G_CVAR_REGISTER,NULL,"g_pugTeams","0",0);
+    SystemCall(G_CVAR_REGISTER,NULL,"g_cheatFlags","1",CVAR_ARCHIVE);
+}
+static void TCP_NetqClear(int n){if(n>=0&&n<TCP_MAX_PLAYERS)memset(&netq[n],0,sizeof(netq[n]));}
+static int netqGrade(float loss,float jitter,int ping){
+    if(loss>5.f||jitter>40.f||ping>250)return 3;
+    if(loss>2.f||jitter>20.f||ping>150)return 2;
+    if(loss>.5f||jitter>10.f||ping>90)return 1;
+    return 0;
+}
+/* lagBegin: how far this shot was rewound and whether the cap cut it short. */
+static void TCP_NetqRewind(int shooter,int rewindMs,int clamped){
+    tcp_stats_player *p=TCP_StatsOf(shooter);if(!p)return;p->rewindSum+=rewindMs;p->rewindN++;if(clamped)p->rewindClamped++;
+}
+/* GAME_CLIENT_THINK: remember view angles for the flick check. */
+static void TCP_NetqCmd(int n){
+    tcp_netq *q=&netq[n];int h=q->angHead=(q->angHead+1)&7;q->angT[h]=levelTime;q->angP[h]=clients[n].ps.viewangles[0];q->angY[h]=clients[n].ps.viewangles[1];
+}
+static float netqAngleDiff(float a,float b){float d=fmodf(a-b+540.f,360.f)-180.f;return d<0?-d:d;}
+/* A head hit: did the view swing more than 25 degrees in the 40-120 ms before it? */
+static void TCP_NetqHeadHit(int n){
+    if(n<0||n>=TCP_MAX_PLAYERS||bots[n].active)return;tcp_netq *q=&netq[n];
+    for(int k=1;k<8;k++){int i=(q->angHead-k)&7;int age=levelTime-q->angT[i];if(!q->angT[i]||age>120)break;
+        if(age>=40){float d=netqAngleDiff(clients[n].ps.viewangles[1],q->angY[i])+netqAngleDiff(clients[n].ps.viewangles[0],q->angP[i]);if(d>25.f)q->snapHeads++;break;}}
+}
+static void netqSample(void){
+    for(int i=0;i<maxClients;i++){client_t *c=&clients[i];tcp_netq *q=&netq[i];
+        if(!c->begun||bots[i].active)continue;
+        int ping=c->ps.ping>999?999:c->ps.ping,out[4]={0,0,0,0};
+        if(netqTrapId&&SystemCall(netqTrapId,i,out)){
+            int dr=out[0]-q->lastRecv,dd=out[1]-q->lastDrop;
+            if(q->trapOk&&dr>=0&&dd>=0&&dr+dd>0){float l=100.f*dd/(float)(dr+dd);q->loss=q->loss*.8f+l*.2f;
+                tcp_stats_player *p=TCP_StatsOf(i);if(p){p->netRecv+=dr;p->netDrop+=dd;}}
+            q->lastRecv=out[0];q->lastDrop=out[1];q->trapOk=1;}
+        if(q->lastPing){float j=(float)abs(ping-q->lastPing);q->jitter=q->jitter*.8f+j*.2f;}
+        q->lastPing=ping?ping:q->lastPing;q->grade=netqGrade(q->loss,q->jitter,ping);
+        tcp_stats_player *p=TCP_StatsOf(i);
+        if(p&&ping>0){p->netPingSum+=ping;p->netPingN++;if(ping>p->netPingMax)p->netPingMax=ping;p->netJitterSum+=(int)(q->jitter*10.f);}
+        /* g_maxPing */
+        int limit=netqCvar("g_maxPing",0),grace=netqCvar("g_maxPingTime",20)*1000;if(grace<5000)grace=5000;
+        if(limit<=0||c->spectator||ping<=limit){q->highSince=0;q->highWarned=0;continue;}
+        if(!q->highSince)q->highSince=levelTime;
+        int over=levelTime-q->highSince;char m[160];
+        if(over>=grace){
+            snprintf(m,sizeof(m),"TCP_NATIVE_MAXPING slot=%d ping=%d limit=%d action=%d\n",i,ping,limit,netqCvar("g_maxPingAction",0));print(m);
+            if(netqCvar("g_maxPingAction",0)){snprintf(m,sizeof(m),"Your ping stayed above this server's limit of %d ms.",limit);SystemCall(G_DROP_CLIENT,i,m,0);}
+            else{snprintf(m,sizeof(m),"chat \"^3Your ping stayed above this server's limit of %d ms, so you were moved to spectator.\"",limit);
+                SystemCall(G_SEND_SERVER_COMMAND,i,m);specEnter(i,"ping");}
+            q->highSince=0;q->highWarned=0;}
+        else if(over>=grace/2&&!q->highWarned){q->highWarned=1;
+            snprintf(m,sizeof(m),"chat \"^3Your ping is above this server's limit of %d ms. Fix your connection or you will be moved to spectator.\"",limit);
+            SystemCall(G_SEND_SERVER_COMMAND,i,m);}
+    }
+}
+static void netqBroadcast(void){
+    char line[MAX_STRING_CHARS]="",entry[48];int count=0;
+    for(int i=0;i<maxClients;i++){const client_t *c=&clients[i];if(!c->connected||!c->begun||bots[i].active)continue;
+        const tcp_netq *q=&netq[i];snprintf(entry,sizeof(entry)," %d %d %d %d %d",i,q->grade,(int)(q->loss*10.f+.5f),(int)(q->jitter+.5f),c->ps.ping>999?999:c->ps.ping);
+        if(strlen(line)+strlen(entry)>=sizeof(line)-16)break;strncat(line,entry,sizeof(line)-strlen(line)-1);count++;}
+    if(!count)return;   /* bots only: nothing to show */
+    char cmd[MAX_STRING_CHARS+16];snprintf(cmd,sizeof(cmd),"tcp_nq %d%s",count,line);SystemCall(G_SEND_SERVER_COMMAND,-1,cmd);
+}
+/* Automatic checks: one report per player and reason per map. */
+static void netqFlag(int n,int bit,const char *why){
+    tcp_netq *q=&netq[n];if(q->flagged&bit)return;q->flagged|=bit;
+    long long now=(long long)time(NULL);char iso[32],map[64]="",host[128]="",path[96],tn[48],tp[17];TCP_StatsIso(now,iso,sizeof(iso));
+    SystemCall(G_CVAR_VARIABLE_STRING_BUFFER,"mapname",map,sizeof(map));SystemCall(G_CVAR_VARIABLE_STRING_BUFFER,"sv_hostname",host,sizeof(host));
+    TCP_PlayerName(n,tn,sizeof(tn));TCP_PlayerPid(n,tp);snprintf(path,sizeof(path),"reports/%lld-auto-%d-%d.json",now,n,bit);
+    tcp_stats_out o;memset(&o,0,sizeof(o));if(SystemCall(G_FS_FOPEN_FILE,path,&o.f,FS_WRITE)<0||!o.f)return;
+    const client_t *c=&clients[n];
+    TCP_StatsPut(&o,"{\"schema\":\"tcp-report/1\",\"auto\":true,\"time\":");TCP_StatsStr(&o,iso);
+    TCP_StatsPut(&o,",\"server\":");TCP_StatsStr(&o,host);TCP_StatsPut(&o,",\"map\":");TCP_StatsStr(&o,map);
+    TCP_StatsPutf(&o,",\"level_time_ms\":%d,\"reporter\":{\"slot\":-1,\"name\":\"Automatic check\",\"id\":\"\"}",levelTime);
+    TCP_StatsPutf(&o,",\"reported\":{\"slot\":%d,\"bot\":false,\"name\":",n);TCP_StatsStr(&o,tn);TCP_StatsPut(&o,",\"id\":");TCP_StatsStr(&o,tp);
+    tcp_stats_player *p=TCP_StatsOf(n);
+    TCP_StatsPutf(&o,",\"kills\":%u,\"deaths\":%u,\"shots\":%u,\"hits\":%u,\"team_kills\":%d,\"headshots\":%d,\"flick_heads\":%d}",
+                  c->kills,c->deaths,c->shotsFired,c->hits,c->teamKills,p?p->headshots:0,q->snapHeads);
+    TCP_StatsPut(&o,",\"reason\":");TCP_StatsStr(&o,why);TCP_StatsPut(&o,"}\n");TCP_StatsFlush(&o);SystemCall(G_FS_FCLOSE_FILE,o.f);
+    char m[200];snprintf(m,sizeof(m),"TCP_NATIVE_CHEATFLAG slot=%d flag=%d file=%s\n",n,bit,path);print(m);
+}
+static void netqChecks(void){
+    if(!netqCvar("g_cheatFlags",1)||SystemCall(G_CVAR_VARIABLE_INTEGER_VALUE,"sv_cheats"))return;
+    for(int i=0;i<maxClients;i++){const client_t *c=&clients[i];if(!c->begun||bots[i].active)continue;
+        tcp_stats_player *p=TCP_StatsOf(i);if(!p)continue;char why[160];
+        if(p->kills>=15&&p->headshots*100>=p->kills*80){snprintf(why,sizeof(why),"Automatic check: %d of %d kills this map were headshots.",p->headshots,p->kills);netqFlag(i,1,why);}
+        unsigned shots=0,hits=0;for(int w=0;w<p->weaponCount;w++){const tcp_stats_weapon *ws=&p->weapons[w];if(ws->id==TCP_KNIFE_WEAPON)continue;
+            const tcp_gear_weapon *g=TCP_GearWeapon(ws->id);if(g&&g->slot!=TCP_SLOT_PRIMARY)continue;shots+=ws->shots;hits+=ws->hits;}
+        if(shots>=200&&hits*100>=shots*75){snprintf(why,sizeof(why),"Automatic check: %u%% accuracy over %u primary weapon shots this map.",hits*100/shots,shots);netqFlag(i,2,why);}
+        if(netq[i].snapHeads>=8&&p->headshots>0&&netq[i].snapHeads*2>=p->headshots){snprintf(why,sizeof(why),"Automatic check: %d headshots came right after a flick of more than 25 degrees.",netq[i].snapHeads);netqFlag(i,4,why);}
+    }
+}
+static void TCP_NetqFrame(void){
+    if(levelTime>=netqNextSample){netqNextSample=levelTime+1000;netqSample();}
+    if(levelTime>=netqNextSend){netqNextSend=levelTime+2000;netqBroadcast();}
+    if(levelTime>=netqNextCheck){netqNextCheck=levelTime+10000;netqChecks();}
+}
+/* ---- reconnects and pickup teams ---- */
+static void netqGuid(int n,char out[33]){
+    char info[MAX_INFO_STRING],g[64]="";out[0]=0;SystemCall(G_GET_USERINFO,n,info,sizeof(info));TCP_InfoValue(info,"cl_guid",g,sizeof(g));
+    if(!TCP_StatsValidGuid(g))return;for(char *p=g;*p;p++)*p=(char)toupper((unsigned char)*p);memcpy(out,g,33);
+}
+/* GAME_CLIENT_DISCONNECT, before the client is cleared. */
+static void TCP_NetqLeave(int n){
+    const client_t *c=&clients[n];tcp_stats_player *p=TCP_StatsOf(n);if(p)p->leaves++;
+    if(!c->begun||bots[n].active||!teamMode||c->spectator)return;char g[33];netqGuid(n,g);if(!g[0])return;
+    int slot=-1,oldest=0;for(int i=0;i<TCP_MAX_PLAYERS;i++){if(!netqKeep[i].guid[0]||!strcmp(netqKeep[i].guid,g)){slot=i;break;}if(slot<0||netqKeep[i].at<oldest){oldest=netqKeep[i].at;slot=i;}}
+    tcp_netq_keep *k=&netqKeep[slot];memset(k,0,sizeof(*k));memcpy(k->guid,g,33);k->team=c->pendingTeam?c->pendingTeam:c->team;
+    k->kills=(int)c->kills;k->deaths=(int)c->deaths;k->suicides=c->suicides;k->teamKills=c->teamKills;k->damageGiven=c->damageGiven;k->damageReceived=c->damageReceived;
+    k->teamDamage=c->teamDamage;k->hits=(int)c->hits;k->shots=c->shotsFired;k->at=levelTime;
+}
+static int netqPugTeam(int n){
+    if(!netqCvar("g_pugTeams",0)||!teamMode)return 0;char info[MAX_INFO_STRING],t[8]="";SystemCall(G_GET_USERINFO,n,info,sizeof(info));TCP_InfoValue(info,"tcp_team",t,sizeof(t));
+    return t[0]=='r'?TCP_TEAM_RED:t[0]=='b'?TCP_TEAM_BLUE:0;
+}
+/* GAME_CLIENT_BEGIN, before the team is picked: returns the team to use (0 = normal rules). */
+static int TCP_NetqBeginTeam(int n){
+    int pug=netqPugTeam(n);if(pug)return pug;
+    char g[33];netqGuid(n,g);if(!g[0]||!teamMode)return 0;int keep=netqCvar("g_reconnectKeep",300)*1000;
+    for(int i=0;i<TCP_MAX_PLAYERS;i++){tcp_netq_keep *k=&netqKeep[i];if(!k->guid[0]||strcmp(k->guid,g))continue;
+        if(levelTime-k->at>keep||levelTime<k->at){memset(k,0,sizeof(*k));return 0;}
+        client_t *c=&clients[n];c->kills=(unsigned)k->kills;c->deaths=(unsigned)k->deaths;c->suicides=k->suicides;c->teamKills=k->teamKills;
+        c->damageGiven=k->damageGiven;c->damageReceived=k->damageReceived;c->teamDamage=k->teamDamage;c->hits=(unsigned)k->hits;c->shotsFired=k->shots;
+        int team=k->team;char m[120];snprintf(m,sizeof(m),"TCP_NATIVE_REJOIN slot=%d team=%d kills=%d deaths=%d\n",n,team,k->kills,k->deaths);print(m);
+        SystemCall(G_SEND_SERVER_COMMAND,n,"chat \"^3Welcome back. Your team and score were kept.\"");memset(k,0,sizeof(*k));
+        return team==TCP_TEAM_RED||team==TCP_TEAM_BLUE?team:0;}
+    return 0;
+}
+/* team command: a pickup player can only play on the team the pickup gave them. */
+static int TCP_NetqTeamChoice(int n,int want){
+    int pug=netqPugTeam(n);if(pug&&want&&want!=pug){SystemCall(G_SEND_SERVER_COMMAND,n,"print \"This is a pickup match: you play on the team the pickup assigned.\n\"");return pug;}
+    return want;
+}
+static void TCP_NetqMapStart(void){memset(netqKeep,0,sizeof(netqKeep));}
