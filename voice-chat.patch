diff --git a/reference/etlegacy/src/qcommon/tcp_voip.h b/reference/etlegacy/src/qcommon/tcp_voip.h
new file mode 100644
index 0000000..3249ead
--- /dev/null
+++ b/reference/etlegacy/src/qcommon/tcp_voip.h
@@ -0,0 +1,36 @@
+/*
+ * TrueCombat: Platinum - native voice chat, wire format shared by client and server.
+ *
+ * Voice travels inside the normal game packets, so it needs no extra port.
+ *   client -> server  clc_voipOpus: byte gen, short seq, byte frames, frames x {short len, len bytes}
+ *   server -> client  svc_voipOpus: byte sender, byte gen, short seq, byte frames, frames x {short len, len bytes}
+ * Every frame is 20 ms of 48 kHz mono Opus. "gen" changes with every new transmission, so the
+ * receiver resets its decoder; "seq" is the number of the first frame and lets the receiver
+ * conceal lost frames.
+ *
+ * Compatibility: a client only sends voice to a server whose serverinfo has sv_voice 1, and a
+ * server only sends voice to a client whose userinfo has cl_voip 1. Older builds never see the
+ * new message types, so the network protocol stays 84.
+ *
+ * Who hears whom is decided by the game module (trap_TcpVoiceMatrix): team voice, dead players
+ * only to dead teammates, spectators to spectators, everyone in warmup.
+ */
+#ifndef INCLUDE_TCP_VOIP_H
+#define INCLUDE_TCP_VOIP_H
+
+#define TCP_VOIP_RATE          48000
+#define TCP_VOIP_FRAME_SAMPLES 960      ///< 20 ms
+#define TCP_VOIP_MAX_FRAMES    3        ///< frames in one message
+#define TCP_VOIP_MAX_BYTES     256      ///< one Opus frame (24 kbps is about 60 bytes)
+#define TCP_VOIP_QUEUE         32       ///< messages waiting for one receiver
+#define TCP_VOIP_STREAM_BASE   64       ///< raw sound stream of slot 0 (64 + slot, below MAX_RAW_STREAMS 128)
+
+typedef struct
+{
+	unsigned char sender, gen, frames;
+	unsigned short seq;
+	unsigned short len[TCP_VOIP_MAX_FRAMES];
+	unsigned char data[TCP_VOIP_MAX_FRAMES][TCP_VOIP_MAX_BYTES];
+} tcpVoipPacket_t;
+
+#endif
