diff --git a/game_src/native/tcp_voip.h b/game_src/native/tcp_voip.h
new file mode 100644
index 0000000..3d41a60
--- /dev/null
+++ b/game_src/native/tcp_voip.h
@@ -0,0 +1,105 @@
+/* Native voice chat, game rules (online play round 3, item 12). GPL-3.0-or-later.
+ * Included by tcp_game.c after tcp_netq.h.
+ *
+ * The engine relays the voice (sv_voip.c, cl_voip.c). This file decides who hears whom and
+ * hands that to the engine 20 times a second through trap_TcpVoiceMatrix. An older engine has
+ * no such trap: then the server never advertises voice and nothing changes.
+ *
+ * Rules (decided by Gianni, 2026-11-11):
+ *   - Waiting for players, match warmup, end of match, and modes without teams: everyone hears everyone.
+ *   - Live round: team voice. Living players talk to their whole team. Dead players hear their
+ *     team but only talk to other dead teammates, so they can't call out enemy positions.
+ *   - Countdown and round result: the whole team talks freely, dead or alive.
+ *   - Spectators talk to and hear only spectators, except when everyone hears everyone.
+ *   - userinfo cl_voipMuteEnemies 1: never hear the other team, not even in warmup.
+ *   - Players muted by an admin are heard by nobody until the next map.
+ *
+ * Cvars:    g_voice 1          0 turns voice off for this game
+ * Commands: voicemute <slot|name>, voiceunmute <slot|name>, voicemutes  (rcon / server console)
+ */
+static int voipTrapId,voipNextSend;
+static unsigned char voipMuteEnemies[TCP_MAX_PLAYERS];
+#define VOIP_MUTES 32
+static char voipMuted[VOIP_MUTES][33];        /* admin-muted cl_guids, kept for this map */
+
+static void TCP_VoipInit(void){
+    char v[16]="";voipTrapId=SystemCall(G_TRAP_GETVALUE,v,(int)sizeof(v),"trap_TcpVoiceMatrix")?atoi(v):0;
+    SystemCall(G_CVAR_REGISTER,NULL,"g_voice","1",CVAR_ARCHIVE);
+    memset(voipMuteEnemies,0,sizeof(voipMuteEnemies));memset(voipMuted,0,sizeof(voipMuted));voipNextSend=0;
+}
+static void TCP_VoipUserinfo(int n){
+    if(n<0||n>=TCP_MAX_PLAYERS)return;
+    char info[MAX_INFO_STRING],v[8]="";SystemCall(G_GET_USERINFO,n,info,sizeof(info));TCP_InfoValue(info,"cl_voipMuteEnemies",v,sizeof(v));
+    voipMuteEnemies[n]=(unsigned char)(atoi(v)>0);
+}
+static int voipIsMuted(int n){
+    char guid[33]="";clientGuid(n,guid,sizeof(guid));if(!guid[0])return 0;
+    for(int i=0;i<VOIP_MUTES;i++)if(voipMuted[i][0]&&!strcmp(voipMuted[i],guid))return 1;
+    return 0;
+}
+/* 0 nobody, 1 spectators, 2 team: the group a player belongs to right now. */
+static int voipSpectator(int n){const client_t *c=&clients[n];return c->spectator||c->team==TCP_TEAM_NONE;}
+static int voipAlive(int n){const client_t *c=&clients[n];return !voipSpectator(n)&&c->health.health>0&&(roundPhase!=TCP_ROUND_LIVE||c->inRound);}
+static int voipOpen(void){
+    if(!teamMode||roundPhase==TCP_ROUND_WAITING)return 1;
+    if(matchEnded&&roundPhase==TCP_ROUND_RESULT)return 1;
+    if(match.state==TCP_MATCH_WARMUP||match.state==TCP_MATCH_ENDED)return 1;
+    return 0;
+}
+/* Does receiver r hear speaker s? */
+static int voipHears(int r,int s,int open,const unsigned char *muted){
+    if(muted[s])return 0;
+    const int rSpec=voipSpectator(r),sSpec=voipSpectator(s);
+    const int enemies=!rSpec&&!sSpec&&clients[r].team!=clients[s].team;
+    if(enemies&&voipMuteEnemies[r])return 0;
+    if(open)return 1;
+    if(rSpec||sSpec)return rSpec&&sSpec;
+    if(enemies)return 0;
+    if(roundPhase!=TCP_ROUND_LIVE)return 1;              /* countdown, round result, respawn modes between lives */
+    if(voipAlive(s))return 1;                            /* the living talk to the whole team */
+    return !voipAlive(r);                                /* the dead only reach the dead */
+}
+static void TCP_VoipFrame(void){
+    if(!voipTrapId||levelTime<voipNextSend)return;
+    voipNextSend=levelTime+50;
+    static int masks[MAX_CLIENTS*2];memset(masks,0,sizeof(masks));
+    const int on=netqCvar("g_voice",1)>0,open=voipOpen();
+    unsigned char human[MAX_CLIENTS]={0},muted[MAX_CLIENTS]={0};
+    const int count=maxClients<MAX_CLIENTS?maxClients:MAX_CLIENTS;
+    if(on)for(int i=0;i<count&&i<TCP_MAX_PLAYERS;i++){human[i]=clients[i].connected&&clients[i].begun&&!bots[i].active;if(human[i])muted[i]=(unsigned char)voipIsMuted(i);}
+    if(on)for(int r=0;r<count;r++){if(!human[r])continue;
+        for(int s=0;s<count;s++)if(s!=r&&human[s]&&voipHears(r,s,open,muted))masks[r*2+(s>>5)]|=(int)(1u<<(s&31));}
+    SystemCall(voipTrapId,masks,count);
+}
+static int voipFindSlot(const char *arg){
+    int digits=arg[0]!=0;for(const char *s=arg;*s;s++)if(*s<'0'||*s>'9')digits=0;
+    if(digits){int v=atoi(arg);return v>=0&&v<maxClients&&clients[v].connected?v:-1;}
+    int found=-1;
+    for(int i=0;i<maxClients&&i<TCP_MAX_PLAYERS;i++){if(!clients[i].connected)continue;
+        char info[MAX_INFO_STRING],name[64]="",clean[64];size_t k=0;SystemCall(G_GET_USERINFO,i,info,sizeof(info));TCP_InfoValue(info,"name",name,sizeof(name));
+        for(const char *p=name;*p&&k+1<sizeof(clean);p++){if(*p=='^'&&p[1]){p++;continue;}clean[k++]=(char)((*p>='A'&&*p<='Z')?*p+32:*p);}clean[k]=0;
+        char want[64];k=0;for(const char *p=arg;*p&&k+1<sizeof(want);p++)want[k++]=(char)((*p>='A'&&*p<='Z')?*p+32:*p);want[k]=0;
+        if(!strcmp(clean,want))return i;if(strstr(clean,want))found=found==-1?i:-2;}
+    return found;
+}
+/* Server console / rcon. Returns 1 when handled. */
+static int TCP_VoipConsole(const char *cmd){
+    const int mute=!strcmp(cmd,"voicemute"),unmute=!strcmp(cmd,"voiceunmute");
+    char line[160];
+    if(!strcmp(cmd,"voicemutes")){int any=0;
+        for(int i=0;i<maxClients&&i<TCP_MAX_PLAYERS;i++)if(clients[i].connected&&voipIsMuted(i)){snprintf(line,sizeof(line),"voice muted: slot %d\n",i);print(line);any=1;}
+        if(!any)print("No players are voice muted.\n");return 1;}
+    if(!mute&&!unmute)return 0;
+    char arg[64];SystemCall(G_ARGV,1,arg,sizeof(arg));
+    const int slot=voipFindSlot(arg);
+    if(slot==-2){print("More than one player matches. Use the slot number.\n");return 1;}
+    if(slot<0){print("No player by that name or slot.\n");return 1;}
+    char guid[33]="";clientGuid(slot,guid,sizeof(guid));
+    if(!guid[0]){print("That player has no cl_guid, so the mute can't be kept.\n");return 1;}
+    for(int i=0;i<VOIP_MUTES;i++)if(!strcmp(voipMuted[i],guid))voipMuted[i][0]=0;
+    if(mute)for(int i=0;i<VOIP_MUTES;i++)if(!voipMuted[i][0]){snprintf(voipMuted[i],sizeof(voipMuted[i]),"%s",guid);break;}
+    snprintf(line,sizeof(line),"print \"%s\n\"",mute?"An admin muted your voice chat until the next map.":"An admin turned your voice chat back on.");
+    SystemCall(G_SEND_SERVER_COMMAND,slot,line);
+    snprintf(line,sizeof(line),"TCP_NATIVE_VOICE %s slot=%d\n",mute?"mute":"unmute",slot);print(line);
+    return 1;
+}
diff --git a/game_src/native/tcp_voip_cg.h b/game_src/native/tcp_voip_cg.h
new file mode 100644
index 0000000..8462211
--- /dev/null
+++ b/game_src/native/tcp_voip_cg.h
@@ -0,0 +1,62 @@
+/* Native voice chat, cgame side (online play round 3, item 12). GPL-3.0-or-later.
+ * Included by tcp_cgame.c after tcp_voice_cg.h. The engine does the audio (cl_voip.c); this file:
+ *   - passes the game's mute list (cg_muted: mute / unmute / mute menu) to the engine, so muted
+ *     players are silent in voice as well as in chat,
+ *   - shows who is talking: a list at the left of the screen, the voice icon over their head
+ *     (the same sprite as voice commands) and on the scoreboard next to their name,
+ *   - shows your own microphone level while you transmit,
+ *   - binds push to talk (+voip) once, to the first free key of B, H and Z.
+ * The engine reports nothing when it has no voice (older build): then this file does nothing.
+ *
+ * cg_voipHud 1   0 hides the talking list (icons stay)
+ */
+static int voipCgTrap,voipNextIgnore,voipNoMicShown,voipIgnoreMask[2],voipState[7];
+static vmCvar_t voipHudCvar,voipBindsDone;
+
+static void voipCgInit(void){
+    char v[16]="";voipCgTrap=SystemCall(CG_TRAP_GETVALUE,v,(int)sizeof(v),"trap_TcpVoice")?atoi(v):0;
+    SystemCall(CG_CVAR_REGISTER,&voipHudCvar,"cg_voipHud","1",CVAR_ARCHIVE);
+    SystemCall(CG_CVAR_REGISTER,&voipBindsDone,"cg_voipBinds","0",CVAR_ARCHIVE);
+    voipNextIgnore=voipNoMicShown=0;memset(voipIgnoreMask,0,sizeof(voipIgnoreMask));memset(voipState,0,sizeof(voipState));voipSpeak[0]=voipSpeak[1]=0;
+    if(!voipCgTrap)return;
+    /* Push to talk gets a key once, and only one nothing else uses. */
+    if(!voipBindsDone.integer){
+        int first=-1,second=-1;SystemCall(CG_KEY_BINDINGTOKEYS,"+voip",&first,&second);
+        if(first<0){static const int keys[]={'b','h','z'};
+            for(size_t i=0;i<sizeof(keys)/sizeof(keys[0]);i++){char current[64]="";SystemCall(CG_KEY_GETBINDINGBUF,keys[i],current,sizeof(current));
+                if(!current[0]){SystemCall(CG_KEY_SETBINDING,keys[i],"+voip");break;}}}
+        SystemCall(CG_CVAR_SET,"cg_voipBinds","1");
+    }
+}
+/* Every frame: hand over the mute list, read who is talking. */
+static void voipCgFrame(int time){
+    if(!voipCgTrap)return;
+    SystemCall(CG_CVAR_UPDATE,&voipHudCvar);
+    if(time>=voipNextIgnore||time<voipNextIgnore-1000){
+        voipNextIgnore=time+500;voipIgnoreMask[0]=voipIgnoreMask[1]=0;
+        for(int i=0;i<MAX_CLIENTS;i++)if(config(CS_PLAYERS+i)[0]&&qolIsMuted(i))voipIgnoreMask[i>>5]|=(int)(1u<<(i&31));
+    }
+    SystemCall(voipCgTrap,voipState,voipIgnoreMask);
+    voipSpeak[0]=(unsigned)voipState[0];voipSpeak[1]=(unsigned)voipState[1];
+    for(int i=0;i<MAX_CLIENTS;i++)if(voipSpeaking(i)&&hudVoiceChat){vcSprite[i]=hudVoiceChat;if(vcSpriteUntil[i]<time+300)vcSpriteUntil[i]=time+300;}
+    if(voipState[4]<0&&voipState[2]==0&&!voipNoMicShown){voipNoMicShown=1;
+        addPopup("No microphone found for voice chat. Check Windows microphone privacy settings.",hudVoiceChat,hudNow);}
+}
+/* The talking list, under the round clock area at the left. */
+static void voipCgDraw(const playerState_t *p){
+    if(!voipCgTrap||!voipHudCvar.integer)return;
+    static const float back[4]={0,0,0,.45f},bar[4]={.35f,.85f,.35f,1},dim[4]={.3f,.3f,.3f,.8f};
+    float y=150;int shown=0;char line[80];
+    if(voipState[2]){
+        hudFill(4,y-11,120,14,back);if(hudVoiceChat)hudPic(6,y-11,13,13,hudVoiceChat);
+        hudText(22,y,.18f,hudWhite,"You",1);
+        const float w=60;hudFill(56,y-7,w,5,dim);hudFill(56,y-7,w*(voipState[3]>100?100:voipState[3])/100.f,5,bar);
+        y+=15;shown++;
+    }
+    for(int i=0;i<MAX_CLIENTS&&shown<6;i++){
+        if(i==p->clientNum||!voipSpeaking(i))continue;
+        teamName(i,line,sizeof(line));line[40]=0;
+        hudFill(4,y-11,150,14,back);if(hudVoiceChat)hudPic(6,y-11,13,13,hudVoiceChat);
+        hudText(22,y,.18f,hudWhite,line,1);y+=15;shown++;
+    }
+}
