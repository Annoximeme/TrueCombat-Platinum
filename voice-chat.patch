+/**
+ * @brief CL_VoipCloseMic
+ */
+static void CL_VoipCloseMic(void)
+{
+	if (voipMic)
+	{
+		SDL_CloseAudioDevice(voipMic);
+		voipMic = 0;
+	}
+}
+
+/**
+ * @brief CL_VoipOpenMic opens the microphone (paused) the first time it is needed.
+ */
+static qboolean CL_VoipOpenMic(void)
+{
+	SDL_AudioSpec want, have;
+	const char    *device;
+
+	if (voipMic)
+	{
+		return qtrue;
+	}
+	if (voipMicFailed)
+	{
+		return qfalse;
+	}
+	if (!SDL_WasInit(SDL_INIT_AUDIO) && SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: audio init failed: %s\n", SDL_GetError());
+		voipMicFailed = qtrue;
+		return qfalse;
+	}
+	Com_Memset(&want, 0, sizeof(want));
+	want.freq     = TCP_VOIP_RATE;
+	want.format   = AUDIO_S16SYS;
+	want.channels = 1;
+	want.samples  = TCP_VOIP_FRAME_SAMPLES / 2;
+	device        = cl_voipCaptureDevice->string[0] ? cl_voipCaptureDevice->string : NULL;
+	voipMic       = SDL_OpenAudioDevice(device, 1, &want, &have, 0); // SDL converts to the format we ask for
+	if (!voipMic && device)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: microphone \"%s\" not found, using the default.\n", device);
+		voipMic = SDL_OpenAudioDevice(NULL, 1, &want, &have, 0);
+	}
+	if (!voipMic)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: no microphone (%s). On Windows, check Settings > Privacy > Microphone > Let desktop apps access your microphone.\n", SDL_GetError());
+		voipMicFailed = qtrue;
+		return qfalse;
+	}
+	Com_Printf("Voice chat: microphone ready (%s).\n", device ? device : "system default");
+	return qtrue;
+}
+
+/**
+ * @brief CL_VoipStartSending
+ */
+static void CL_VoipStartSending(void)
+{
+	int error = 0;
+
+	if (voipSending || (!cl_voipTestTone->integer && !CL_VoipOpenMic()))
+	{
+		return;
+	}
+	if (!voipEncoder)
+	{
+		voipEncoder = opus_encoder_create(TCP_VOIP_RATE, 1, OPUS_APPLICATION_VOIP, &error);
+		if (!voipEncoder)
+		{
+			Com_Printf(S_COLOR_YELLOW "Voice chat: Opus encoder failed (%d).\n", error);
+			return;
+		}
+		opus_encoder_ctl(voipEncoder, OPUS_SET_BITRATE(24000));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_COMPLEXITY(5));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_INBAND_FEC(1));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_PACKET_LOSS_PERC(10));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_SIGNAL(OPUS_SIGNAL_VOICE));
+	}
+	else
+	{
+		opus_encoder_ctl(voipEncoder, OPUS_RESET_STATE);
+	}
+	if (cl_voipTestTone->integer)
+	{
+		voipToneAt = cls.realtime;
+	}
+	else
+	{
+		if (!cl_voipUseVAD->integer)
+		{
+			SDL_ClearQueuedAudio(voipMic);
+		}
+		SDL_PauseAudioDevice(voipMic, 0);
+	}
+	voipGen++;
+	if (cl_voipDebug->integer)
+	{
+		Com_Printf("TCP_NATIVE_VOIP send start gen=%d tone=%d\n", voipGen, cl_voipTestTone->integer);
+	}
+	voipSending   = qtrue;
+	voipOutFrames = 0;
+}
+
+/**
+ * @brief CL_VoipStopSending
+ */
+static void CL_VoipStopSending(void)
+{
+	if (voipMic && !cl_voipUseVAD->integer)
+	{
+		SDL_PauseAudioDevice(voipMic, 1);
+		SDL_ClearQueuedAudio(voipMic);
+	}
+	voipSending = qfalse;
+	voipLevel   = 0;
+}
+
+/**
+ * @brief CL_VoipGain applies the microphone gain and measures the level.
+ * @return the frame's rms level, 0..1
+ */
+static float CL_VoipGain(short *pcm)
+{
+	const float gain = Com_Clamp(0.25f, 4.f, cl_voipMicGain->value);
+	double      sum  = 0;
+	float       rms;
+	int         i;
+
+	for (i = 0; i < TCP_VOIP_FRAME_SAMPLES; i++)
+	{
+		int v = (int)(pcm[i] * gain);
+
+		v      = v > 32767 ? 32767 : v < -32768 ? -32768 : v;
+		pcm[i] = (short)v;
+		sum   += (double)v * v;
+	}
+	rms       = (float)sqrt(sum / TCP_VOIP_FRAME_SAMPLES) / 32768.f;
+	voipLevel = (int)(rms * 400.f);  // speech sits around 0.05 .. 0.25 rms
+	if (voipLevel > 100)
+	{
+		voipLevel = 100;
+	}
+	return rms;
+}
+
+/**
+ * @brief CL_VoipEncodeFrame encodes one frame (gain already applied) into the outgoing queue.
+ */
+static void CL_VoipEncodeFrame(const short *pcm)
+{
+	unsigned char packet[TCP_VOIP_MAX_BYTES];
+	const int     len = opus_encode(voipEncoder, pcm, TCP_VOIP_FRAME_SAMPLES, packet, sizeof(packet));
+
+	if (len > 0)
+	{
+		if (voipOutFrames == TCP_VOIP_MAX_FRAMES)
+		{
+			// the game is not sending packets fast enough: drop the oldest frame
+			memmove(voipOut[0], voipOut[1], sizeof(voipOut[0]) * (TCP_VOIP_MAX_FRAMES - 1));
+			memmove(voipOutLen, voipOutLen + 1, sizeof(voipOutLen[0]) * (TCP_VOIP_MAX_FRAMES - 1));
+			voipOutFrames--;
+			voipOutSeq++;
+		}
+		if (!voipOutFrames)
+		{
+			voipOutSeq = voipSeq;
+		}
+		Com_Memcpy(voipOut[voipOutFrames], packet, len);
+		voipOutLen[voipOutFrames] = (unsigned short)len;
+		voipOutFrames++;
+		voipLastSentAt = cls.realtime;
+	}
+	voipSeq++;
+}
+
+/**
+ * @brief CL_VoipFrame runs the microphone. Called every client frame before CL_SendCmd.
+ */
+void CL_VoipFrame(void)
+{
+	short    pcm[TCP_VOIP_FRAME_SAMPLES];
+	qboolean want;
+
+	if (!cl_voip)
+	{
+		return;
+	}
+	if (cl_voipCaptureDevice->modified)
+	{
+		cl_voipCaptureDevice->modified = qfalse;
+		CL_VoipStopSending();
+		CL_VoipCloseMic();
+		voipMicFailed = qfalse;
+	}
+	if (!CL_VoipActive())
+	{
+		if (voipSending)
+		{
+			CL_VoipStopSending();
+		}
+		if (voipMic && cl_voipUseVAD->integer)
+		{
+			SDL_PauseAudioDevice(voipMic, 1);
+		}
+		return;
+	}
+
+	if (cl_voipUseVAD->integer)
+	{
+		// open microphone: keep capturing, transmit while the level is above the threshold
+		if (!CL_VoipOpenMic())
+		{
+			return;
+		}
+		SDL_PauseAudioDevice(voipMic, 0);
+		while (SDL_GetQueuedAudioSize(voipMic) >= sizeof(pcm))
+		{
+			qboolean loud;
+
+			SDL_DequeueAudio(voipMic, pcm, sizeof(pcm));
+			loud = CL_VoipGain(pcm) >= cl_voipVADThreshold->value ? qtrue : qfalse;
+			if (!voipSending)
+			{
+				if (!loud)
+				{
+					continue;
+				}
+				CL_VoipStartSending();
+				if (!voipSending)
+				{
+					return;
+				}
+				voipLastVoiceAt = cls.realtime;
+			}
+			CL_VoipEncodeFrame(pcm);
+			if (loud)
+			{
+				voipLastVoiceAt = cls.realtime;
+			}
+			else if (cls.realtime - voipLastVoiceAt > 400)
+			{
+				voipSending = qfalse;  // hang time over; the microphone keeps listening
+				voipLevel   = 0;
+			}
+		}
+		return;
+	}
+
+	// push to talk; keep sending 150 ms after the key comes up so the last word isn't cut off
+	want = voipKeyDown || (voipSending && cls.realtime - voipReleaseAt < 150);
+	if (want && !voipSending)
+	{
+		CL_VoipStartSending();
+	}
+	else if (!want && voipSending)
+	{
+		CL_VoipStopSending();
+	}
+	if (!voipSending)
+	{
+		return;
+	}
+	if (cl_voipTestTone->integer)
+	{
+		int i;
+
+		if (cls.realtime - voipToneAt > 200)
+		{
+			voipToneAt = cls.realtime - 200;  // after a hitch, don't burst
+		}
+		while (cls.realtime - voipToneAt >= 20)
+		{
+			for (i = 0; i < TCP_VOIP_FRAME_SAMPLES; i++, voipTonePhase++)
+			{
+				pcm[i] = (short)(6000.0 * sin(voipTonePhase * (2.0 * M_PI * 440.0 / TCP_VOIP_RATE)));
+			}
+			voipTonePhase %= TCP_VOIP_RATE;
+			voipToneAt    += 20;
+			CL_VoipGain(pcm);
+			CL_VoipEncodeFrame(pcm);
+		}
+		return;
+	}
+	while (SDL_GetQueuedAudioSize(voipMic) >= sizeof(pcm))
+	{
+		SDL_DequeueAudio(voipMic, pcm, sizeof(pcm));
+		CL_VoipGain(pcm);
+		CL_VoipEncodeFrame(pcm);
+	}
+}
+
+/**
+ * @brief CL_WriteVoip adds the waiting voice frames to an outgoing packet (CL_WritePacket).
+ */
+void CL_WriteVoip(msg_t *buf)
+{
+	int i;
+
+	if (!voipOutFrames)
+	{
+		return;
+	}
+	if (!CL_VoipActive())
+	{
+		voipOutFrames = 0;
+		return;
+	}
+	MSG_WriteByte(buf, clc_voipOpus);
+	MSG_WriteByte(buf, voipGen);
+	MSG_WriteShort(buf, voipOutSeq);
+	MSG_WriteByte(buf, voipOutFrames);
+	for (i = 0; i < voipOutFrames; i++)
+	{
+		MSG_WriteShort(buf, voipOutLen[i]);
+		MSG_WriteData(buf, voipOut[i], voipOutLen[i]);
+	}
+	voipOutFrames = 0;
+}
+
+/**
+ * @brief CL_VoipPlay hands decoded speech to the sound system.
+ */
+static void CL_VoipPlay(int sender, const short *pcm, int samples)
+{
+	const float volume = Com_Clamp(0.f, 2.f, cl_voipVolume->value);
+
+	S_RawSamples(TCP_VOIP_STREAM_BASE + sender, samples, TCP_VOIP_RATE, 2, 1, (const byte *)pcm, volume, volume);
+}
+
+/**
+ * @brief CL_ParseVoip reads one svc_voipOpus message (CL_ParseServerMessage).
+ */
+void CL_ParseVoip(msg_t *msg)
+{
+	const int      sender = MSG_ReadByte(msg);
+	const int      gen    = MSG_ReadByte(msg);
+	unsigned short seq    = (unsigned short)MSG_ReadShort(msg);
+	const int      frames = MSG_ReadByte(msg);
+	unsigned short len[TCP_VOIP_MAX_FRAMES];
+	unsigned char  data[TCP_VOIP_MAX_FRAMES][TCP_VOIP_MAX_BYTES];
+	short          pcm[TCP_VOIP_FRAME_SAMPLES];
+	voipSpeaker_t  *sp;
+	int            i, error = 0;
+
+	if (frames < 1 || frames > TCP_VOIP_MAX_FRAMES || sender < 0 || sender >= MAX_CLIENTS)
+	{
+		Com_Error(ERR_DROP, "CL_ParseVoip: bad voice message");
+	}
+	for (i = 0; i < frames; i++)
+	{
+		len[i] = (unsigned short)(MSG_ReadShort(msg) & 0xffff);
+		if (len[i] < 1 || len[i] > TCP_VOIP_MAX_BYTES)
+		{
+			Com_Error(ERR_DROP, "CL_ParseVoip: bad voice frame");
+		}
+		MSG_ReadData(msg, data[i], len[i]);
+	}
+
+	if (cl_voipDebug && cl_voipDebug->integer > 1)
+	{
+		Com_Printf("TCP_NATIVE_VOIP recv slot=%d gen=%d seq=%d frames=%d muted=%d\n", sender, gen, seq, frames,
+		           (voipIgnore[sender >> 5] >> (sender & 31)) & 1);
+	}
+	if (!cl_voip || !cl_voip->integer || sender == clc.clientNum || (voipIgnore[sender >> 5] & (1u << (sender & 31))))
+	{
+		return;
+	}
+
+	sp = &voipSpeakers[sender];
+	if (!sp->decoder)
+	{
+		sp->decoder = opus_decoder_create(TCP_VOIP_RATE, 1, &error);
+		if (!sp->decoder)
+		{
+			return;
+		}
+		sp->gen = -1;
+	}
+
+	if (sp->gen != gen || cls.realtime - sp->lastAt > 1000)
+	{
+		// a new transmission: fresh decoder state, and 40 ms of silence so playback has a little cushion
+		static const short silence[TCP_VOIP_FRAME_SAMPLES * 2];
+
+		opus_decoder_ctl(sp->decoder, OPUS_RESET_STATE);
+		sp->gen     = gen;
+		sp->nextSeq = seq;
+		if (cl_voipDebug->integer)
+		{
+			Com_Printf("TCP_NATIVE_VOIP recv start slot=%d gen=%d\n", sender, gen);
+		}
+		CL_VoipPlay(sender, silence, TCP_VOIP_FRAME_SAMPLES * 2);
+	}
+	else
+	{
+		const short gap = (short)(seq - sp->nextSeq);
+
+		if (gap < 0)
+		{
+			return;  // old or duplicate
+		}
+		if (gap > 0 && gap <= 5)
+		{
+			// lost frames: conceal all but the last, and rebuild the last from this packet's FEC data
+			int k;
+
+			for (k = 0; k < gap - 1; k++)
+			{
+				const int n = opus_decode(sp->decoder, NULL, 0, pcm, TCP_VOIP_FRAME_SAMPLES, 0);
+
+				if (n > 0)
+				{
+					CL_VoipPlay(sender, pcm, n);
+				}
+			}
+			{
+				const int n = opus_decode(sp->decoder, data[0], len[0], pcm, TCP_VOIP_FRAME_SAMPLES, 1);
+
+				if (n > 0)
+				{
+					CL_VoipPlay(sender, pcm, n);
+				}
+			}
+		}
+	}
+
+	for (i = 0; i < frames; i++)
+	{
+		const int n = opus_decode(sp->decoder, data[i], len[i], pcm, TCP_VOIP_FRAME_SAMPLES, 0);
+
+		if (n > 0)
+		{
+			CL_VoipPlay(sender, pcm, n);
+		}
+	}
+	sp->nextSeq = (unsigned short)(seq + frames);
+	sp->lastAt  = cls.realtime;
+}
+
+/**
+ * @brief CL_VoipCgameState answers the cgame's voice call (trap_TcpVoice).
+ * @param[out] out out[0..1] speaking now (slots 0-31, 32-63), out[2] sending, out[3] microphone level 0..100,
+ *                 out[4] 1 voice available, 0 server without voice, -1 no microphone, out[5] cl_voip, out[6] open microphone
+ * @param[in] ignore ignore[0..1] players this client has muted
+ */
+void CL_VoipCgameState(int *out, const int *ignore)
+{
+	int i;
+
+	if (ignore)
+	{
+		voipIgnore[0] = (unsigned int)ignore[0];
+		voipIgnore[1] = (unsigned int)ignore[1];
+	}
+	if (!out)
+	{
+		return;
+	}
+	Com_Memset(out, 0, sizeof(int) * 7);
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if (voipSpeakers[i].decoder && voipSpeakers[i].lastAt && cls.realtime - voipSpeakers[i].lastAt < 250
+		    && !(voipIgnore[i >> 5] & (1u << (i & 31))))
+		{
+			out[i >> 5] |= (int)(1u << (i & 31));
+		}
+	}
+	out[2] = voipSending && cls.realtime - voipLastSentAt < 200;
+	out[3] = voipSending ? voipLevel : 0;
+	out[4] = !CL_VoipServerHasVoice() ? 0 : voipMicFailed ? -1 : 1;
+	out[5] = cl_voip->integer;
+	out[6] = cl_voipUseVAD->integer;
+}
