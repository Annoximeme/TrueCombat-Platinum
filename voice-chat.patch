+	if (out)
+	{
+		Com_Memset(out, 0, sizeof(int) * 7);
+	}
+}
+void CL_ParseVoip(msg_t *msg)
+{
+	int frames, i;
+
+	// never asked for (no cl_voip in the userinfo), but read it properly anyway
+	MSG_ReadByte(msg);
+	MSG_ReadByte(msg);
+	MSG_ReadShort(msg);
+	frames = MSG_ReadByte(msg);
+	if (frames < 1 || frames > TCP_VOIP_MAX_FRAMES)
+	{
+		Com_Error(ERR_DROP, "CL_ParseVoip: bad voice message");
+	}
+	for (i = 0; i < frames; i++)
+	{
+		int  len = MSG_ReadShort(msg) & 0xffff;
+		byte skip[TCP_VOIP_MAX_BYTES];
+
+		if (len < 1 || len > TCP_VOIP_MAX_BYTES)
+		{
+			Com_Error(ERR_DROP, "CL_ParseVoip: bad voice frame");
+		}
+		MSG_ReadData(msg, skip, len);
+	}
+}
+
+#endif
