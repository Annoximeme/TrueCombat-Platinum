diff --git a/reference/etlegacy/libs/opus/tcp_opus.cmake b/reference/etlegacy/libs/opus/tcp_opus.cmake
new file mode 100644
index 0000000..539ef84
--- /dev/null
+++ b/reference/etlegacy/libs/opus/tcp_opus.cmake
@@ -0,0 +1,20 @@
+# libopus 1.5.2 for TrueCombat: Platinum voice chat (client only; the server never decodes voice).
+# Source: the official release tarball https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
+# (or GitHub xiph/opus tag v1.5.2), unpacked so that libs/opus/include/opus.h exists.
+# Plain C build: no SIMD dispatch, no deep PLC / DRED, float API.
+file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/sources.txt" TCP_OPUS_FILES)
+set(TCP_OPUS_SOURCES "")
+foreach(f ${TCP_OPUS_FILES})
+	list(APPEND TCP_OPUS_SOURCES "${CMAKE_CURRENT_LIST_DIR}/${f}")
+endforeach()
+add_library(tcp_opus STATIC ${TCP_OPUS_SOURCES})
+target_include_directories(tcp_opus PUBLIC "${CMAKE_CURRENT_LIST_DIR}/include")
+target_include_directories(tcp_opus PRIVATE
+	"${CMAKE_CURRENT_LIST_DIR}"
+	"${CMAKE_CURRENT_LIST_DIR}/celt"
+	"${CMAKE_CURRENT_LIST_DIR}/silk"
+	"${CMAKE_CURRENT_LIST_DIR}/silk/float")
+target_compile_definitions(tcp_opus PRIVATE OPUS_BUILD USE_ALLOCA HAVE_LRINT HAVE_LRINTF PACKAGE_VERSION="1.5.2")
+if(NOT MSVC)
+	target_compile_options(tcp_opus PRIVATE -O2 -w)
+endif()
