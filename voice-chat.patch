+/**
+ * @brief CL_VoipActive
+ * @return qtrue when this client may send voice right now
+ */
+static qboolean CL_VoipActive(void)
+{
+	return cl_voip && cl_voip->integer && cls.state == CA_ACTIVE && !clc.demo.playing && CL_VoipServerHasVoice();
