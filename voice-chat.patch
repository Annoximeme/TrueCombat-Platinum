+void CL_VoipInit(void)
+{
+	cl_voip              = Cvar_Get("cl_voip", "1", CVAR_ARCHIVE | CVAR_USERINFO);
+	cl_voipVolume        = Cvar_Get("cl_voipVolume", "1", CVAR_ARCHIVE);
+	cl_voipMicGain       = Cvar_Get("cl_voipMicGain", "1", CVAR_ARCHIVE);
+	cl_voipUseVAD        = Cvar_Get("cl_voipUseVAD", "0", CVAR_ARCHIVE);
+	cl_voipVADThreshold  = Cvar_Get("cl_voipVADThreshold", "0.08", CVAR_ARCHIVE);
+	cl_voipCaptureDevice = Cvar_Get("cl_voipCaptureDevice", "", CVAR_ARCHIVE);
+	cl_voipMuteEnemies   = Cvar_Get("cl_voipMuteEnemies", "0", CVAR_ARCHIVE | CVAR_USERINFO);
+	cl_voipTestTone      = Cvar_Get("cl_voipTestTone", "0", CVAR_TEMP);
+	cl_voipDebug         = Cvar_Get("cl_voipDebug", "0", CVAR_TEMP);
+	cl_voipCaptureDevice->modified = qfalse;
+	Cmd_AddCommand("+voip", CL_VoipDown_f, "Push to talk (voice chat).");
+	Cmd_AddCommand("-voip", CL_VoipUp_f, "Push to talk (voice chat).");
