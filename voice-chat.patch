diff --git a/reference/etlegacy/src/server/sv_voip.c b/reference/etlegacy/src/server/sv_voip.c
new file mode 100644
index 0000000..cc0310a
--- /dev/null
+++ b/reference/etlegacy/src/server/sv_voip.c
@@ -0,0 +1,301 @@
+/*
+ * TrueCombat: Platinum - native voice chat, server relay.
+ *
+ * The server never decodes voice. It checks each message from a client (size, rate), then
+ * copies it to every client the game module allows to hear that speaker, and writes the queued
+ * messages into each client's next snapshot packet.
+ *
+ * Cvars:
+ *   sv_voip 1          0 turns voice off on this server
+ *   sv_voice           (read-only, serverinfo) 1 while voice is available: sv_voip 1 and a
+ *                      game module that sets the hearing rules
+ *   sv_voipMaxFrames 60  frames per second one speaker may send (50 is real time)
+ */
+
+#include "server.h"
+#include "../qcommon/tcp_voip.h"
+
+static cvar_t *sv_voip;
+static cvar_t *sv_voice;
+static cvar_t *sv_voipMaxFrames;
+
+/// svVoipHear[r] bit s: client r hears client s. Set by the game module every frame.
+static unsigned int svVoipHear[MAX_CLIENTS][2];
+static qboolean     svVoipGameReady;
+
+static qboolean        svVoipRecv[MAX_CLIENTS];          ///< userinfo cl_voip 1
+static int             svVoipTokens[MAX_CLIENTS];        ///< rate limit, in frames x 1000
+static int             svVoipTokenTime[MAX_CLIENTS];
+static int             svVoipHead[MAX_CLIENTS], svVoipCount[MAX_CLIENTS];
+static tcpVoipPacket_t svVoipQueue[MAX_CLIENTS][TCP_VOIP_QUEUE];
+
+/**
+ * @brief SV_VoipInit registers the cvars (once, from SV_Init).
+ */
+void SV_VoipInit(void)
+{
+	sv_voip          = Cvar_Get("sv_voip", "1", CVAR_ARCHIVE);
+	sv_voice         = Cvar_Get("sv_voice", "0", CVAR_ROM | CVAR_SERVERINFO);
+	sv_voipMaxFrames = Cvar_Get("sv_voipMaxFrames", "60", CVAR_ARCHIVE);
+	Cvar_CheckRange(sv_voipMaxFrames, 50, 100, qtrue);
+}
+
+/**
+ * @brief SV_VoipUpdateAvailable keeps sv_voice (the serverinfo flag clients look at) in step.
+ */
+static void SV_VoipUpdateAvailable(void)
+{
+	const char *want = (sv_voip && sv_voip->integer && svVoipGameReady) ? "1" : "0";
+
+	if (sv_voice && strcmp(sv_voice->string, want))
+	{
+		Cvar_Set("sv_voice", want);
+	}
+}
+
+/**
+ * @brief SV_VoipGameStart forgets the hearing rules of the previous game module.
+ * A game module without trap_TcpVoiceMatrix never sets them, so voice stays off.
+ */
+void SV_VoipGameStart(void)
+{
+	int i;
+
+	svVoipGameReady = qfalse;
+	Com_Memset(svVoipHear, 0, sizeof(svVoipHear));
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		svVoipHead[i] = svVoipCount[i] = 0;
+	}
+	SV_VoipUpdateAvailable();
+}
+
+/**
+ * @brief SV_VoipSetMatrix stores who hears whom (trap_TcpVoiceMatrix).
+ * @param[in] masks two ints per receiving client: senders 0-31, senders 32-63
+ * @param[in] count number of receiving clients in masks
+ */
+void SV_VoipSetMatrix(const int *masks, int count)
+{
+	int i;
+
+	if (!masks)
+	{
+		return;
+	}
+	if (count > MAX_CLIENTS)
+	{
+		count = MAX_CLIENTS;
+	}
+	Com_Memset(svVoipHear, 0, sizeof(svVoipHear));
+	for (i = 0; i < count; i++)
+	{
+		svVoipHear[i][0] = (unsigned int)masks[i * 2];
+		svVoipHear[i][1] = (unsigned int)masks[i * 2 + 1];
+	}
+	svVoipGameReady = qtrue;
+	SV_VoipUpdateAvailable();
+}
+
+/**
+ * @brief SV_VoipFrame follows changes of sv_voip.
+ */
+void SV_VoipFrame(void)
+{
+	if (sv_voip && sv_voip->modified)
+	{
+		sv_voip->modified = qfalse;
+		SV_VoipUpdateAvailable();
+	}
+}
+
+/**
+ * @brief SV_VoipUserinfo reads cl_voip from a client's userinfo.
+ */
+void SV_VoipUserinfo(client_t *cl)
+{
+	const int n    = (int)(cl - svs.clients);
+	qboolean  recv = atoi(Info_ValueForKey(cl->userinfo, "cl_voip")) > 0 ? qtrue : qfalse;
+
+	if (n < 0 || n >= MAX_CLIENTS)
+	{
+		return;
+	}
+	if (!recv)
+	{
+		svVoipHead[n] = svVoipCount[n] = 0;
+	}
+	svVoipRecv[n] = recv;
+}
+
+/**
+ * @brief SV_VoipDrop clears a leaving client's queue.
+ */
+void SV_VoipDrop(client_t *cl)
+{
+	const int n = (int)(cl - svs.clients);
+
+	if (n >= 0 && n < MAX_CLIENTS)
+	{
+		svVoipRecv[n] = qfalse;
+		svVoipHead[n] = svVoipCount[n] = 0;
+		svVoipTokens[n] = svVoipTokenTime[n] = 0;
+	}
+}
+
+/**
+ * @brief SV_VoipRateOk spends one token per frame; refills at sv_voipMaxFrames per second, burst of 10 frames.
+ */
+static qboolean SV_VoipRateOk(int n, int frames)
+{
+	const int now   = svs.time;
+	const int burst = 10 * 1000;
+	int       elapsed;
+
+	if (!svVoipTokenTime[n])
+	{
+		svVoipTokenTime[n] = now;
+		svVoipTokens[n]    = burst;
+	}
+	elapsed = now - svVoipTokenTime[n];
+	if (elapsed > 0)
+	{
+		svVoipTokens[n] += elapsed * sv_voipMaxFrames->integer;
+		if (svVoipTokens[n] > burst)
+		{
+			svVoipTokens[n] = burst;
+		}
+		svVoipTokenTime[n] = now;
+	}
+	if (svVoipTokens[n] < frames * 1000)
+	{
+		return qfalse;
+	}
+	svVoipTokens[n] -= frames * 1000;
+	return qtrue;
+}
+
+/**
+ * @brief SV_UserVoip reads one clc_voipOpus message and relays it.
+ * The message is always read completely, so the rest of the packet stays in step.
+ */
+void SV_UserVoip(client_t *cl, msg_t *msg)
+{
+	tcpVoipPacket_t packet;
+	const int       sender = (int)(cl - svs.clients);
+	int             i, frames, r;
+	qboolean        ok = qtrue;
+
+	Com_Memset(&packet, 0, sizeof(packet));
+	packet.gen = (unsigned char)MSG_ReadByte(msg);
+	packet.seq = (unsigned short)MSG_ReadShort(msg);
+	frames     = MSG_ReadByte(msg);
+	if (frames < 1 || frames > TCP_VOIP_MAX_FRAMES)
+	{
+		// can't tell how long the message is: skip the rest of the packet
+		msg->readcount = msg->cursize + 1;
+		return;
+	}
+	for (i = 0; i < frames; i++)
+	{
+		const int len = MSG_ReadShort(msg) & 0xffff;
+
+		if (len > TCP_VOIP_MAX_BYTES || len == 0)
+		{
+			msg->readcount = msg->cursize + 1;
+			return;
+		}
+		packet.len[i] = (unsigned short)len;
+		MSG_ReadData(msg, packet.data[i], len);
+	}
+	if (msg->readcount > msg->cursize)
+	{
+		return;
+	}
+	packet.frames = (unsigned char)frames;
+	packet.sender = (unsigned char)sender;
+
+	if (!sv_voip->integer || !svVoipGameReady || cl->state != CS_ACTIVE || sender < 0 || sender >= MAX_CLIENTS)
+	{
+		ok = qfalse;
+	}
+	else if (cl->gentity && (cl->gentity->r.svFlags & SVF_BOT))
+	{
+		ok = qfalse;
+	}
+	else if (!SV_VoipRateOk(sender, frames))
+	{
+		ok = qfalse;
+	}
+	if (!ok)
+	{
+		return;
+	}
+
+	for (r = 0; r < sv_maxclients->integer && r < MAX_CLIENTS; r++)
+	{
+		client_t *to = &svs.clients[r];
+		int      slot;
+
+		if (r == sender || to->state != CS_ACTIVE || !svVoipRecv[r])
+		{
+			continue;
+		}
+		if (to->gentity && (to->gentity->r.svFlags & SVF_BOT))
+		{
+			continue;
+		}
+		if (!(svVoipHear[r][sender >> 5] & (1u << (sender & 31))))
+		{
+			continue;
+		}
+		if (svVoipCount[r] >= TCP_VOIP_QUEUE)
+		{
+			// the receiver is not taking packets fast enough: drop the oldest
+			svVoipHead[r] = (svVoipHead[r] + 1) % TCP_VOIP_QUEUE;
+			svVoipCount[r]--;
+		}
+		slot                 = (svVoipHead[r] + svVoipCount[r]) % TCP_VOIP_QUEUE;
+		svVoipQueue[r][slot] = packet;
+		svVoipCount[r]++;
+	}
+}
+
+/**
+ * @brief SV_WriteVoipToClient adds the queued voice to a snapshot message, as far as it fits.
+ */
+void SV_WriteVoipToClient(client_t *cl, msg_t *msg)
+{
+	const int n = (int)(cl - svs.clients);
+
+	if (n < 0 || n >= MAX_CLIENTS || !svVoipCount[n])
+	{
+		return;
+	}
+	while (svVoipCount[n])
+	{
+		const tcpVoipPacket_t *p   = &svVoipQueue[n][svVoipHead[n]];
+		int                   size = 6, i;
+
+		for (i = 0; i < p->frames; i++)
+		{
+			size += 2 + p->len[i];
+		}
+		if (msg->cursize + size > msg->maxsize - 1024)
+		{
+			break;  // keep room for the end of the message; the rest goes with the next snapshot
+		}
+		MSG_WriteByte(msg, svc_voipOpus);
+		MSG_WriteByte(msg, p->sender);
+		MSG_WriteByte(msg, p->gen);
+		MSG_WriteShort(msg, p->seq);
+		MSG_WriteByte(msg, p->frames);
+		for (i = 0; i < p->frames; i++)
+		{
+			MSG_WriteShort(msg, p->len[i]);
+			MSG_WriteData(msg, p->data[i], p->len[i]);
+		}
+		svVoipHead[n] = (svVoipHead[n] + 1) % TCP_VOIP_QUEUE;
+		svVoipCount[n]--;
+	}
+}
