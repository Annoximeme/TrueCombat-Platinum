diff --git a/reference/etlegacy/src/client/cl_voip.c b/reference/etlegacy/src/client/cl_voip.c
new file mode 100644
index 0000000..614c953
--- /dev/null
+++ b/reference/etlegacy/src/client/cl_voip.c
@@ -0,0 +1,733 @@
+/*
+ * TrueCombat: Platinum - native voice chat, client side.
+ *
+ * Microphone: SDL2 audio capture at 48 kHz mono, independent of the sound backend.
+ * Codec:      Opus, 20 ms frames at about 24 kbps, with in-band FEC for lost packets.
+ * Network:    clc_voipOpus / svc_voipOpus inside the normal game packets (qcommon/tcp_voip.h).
+ * Playback:   one raw sound stream per speaker (stream TCP_VOIP_STREAM_BASE + slot).
+ *
+ * Cvars (archived):
+ *   cl_voip 1                voice on (userinfo; 0 = never send or play voice)
+ *   cl_voipVolume 1          voice playback volume (0 .. 2)
+ *   cl_voipMicGain 1         microphone gain (0.25 .. 4)
+ *   cl_voipUseVAD 0          1 = open microphone: send whenever you speak (no key needed)
+ *   cl_voipVADThreshold 0.08 open microphone level (0 .. 1)
+ *   cl_voipCaptureDevice ""  microphone name ("" = system default); voip_devices lists them
+ *   cl_voipMuteEnemies 0     1 = never hear the other team, not even in warmup (userinfo)
+ * Test aids (not archived): cl_voipTestTone 1 sends a 440 Hz tone instead of the microphone,
+ *   cl_voipDebug 1 prints every transmission start and received frame counts (TCP_NATIVE_VOIP lines).
+ * Commands: +voip / -voip (push to talk), voip_devices.
+ * Muting single players goes through the game's mute list (mute / unmute / mute menu).
+ *
+ * Without TCP_VOIP (no libopus in the build) everything here is a no-op and the client never
+ * says it can play voice.
+ */
+
+#include "client.h"
+#include "../qcommon/tcp_voip.h"
+
+#ifdef TCP_VOIP
+
+#include <SDL2/SDL.h>
+#include "opus.h"
+
+static cvar_t *cl_voip;
+static cvar_t *cl_voipVolume;
+static cvar_t *cl_voipMicGain;
+static cvar_t *cl_voipUseVAD;
+static cvar_t *cl_voipVADThreshold;
+static cvar_t *cl_voipCaptureDevice;
+static cvar_t *cl_voipMuteEnemies;
+static cvar_t *cl_voipTestTone;
+static cvar_t *cl_voipDebug;
+static int    voipToneAt;                        ///< test tone: realtime covered so far
+static int    voipTonePhase;
+
+/* ---------------------------------------------------------------- sending */
+static SDL_AudioDeviceID voipMic;
+static qboolean          voipMicFailed;          ///< opening the microphone failed; retried when the device cvar changes
+static OpusEncoder       *voipEncoder;
+static qboolean          voipKeyDown;            ///< push-to-talk held
+static qboolean          voipSending;            ///< currently transmitting
+static int               voipReleaseAt;          ///< when push-to-talk was let go (a short tail is still sent)
+static int               voipLastVoiceAt;        ///< open microphone: last frame above the threshold
+static unsigned char     voipGen;
+static unsigned short    voipSeq;
+static int               voipLevel;              ///< microphone level 0..100, for the HUD
+static int               voipLastSentAt;
+
+static int            voipOutFrames;
+static unsigned short voipOutSeq;
+static unsigned short voipOutLen[TCP_VOIP_MAX_FRAMES];
+static unsigned char  voipOut[TCP_VOIP_MAX_FRAMES][TCP_VOIP_MAX_BYTES];
+
+/* ---------------------------------------------------------------- receiving */
+typedef struct
+{
+	OpusDecoder *decoder;
+	int gen;                                    ///< -1 = no stream yet
+	unsigned short nextSeq;
+	int lastAt;                                 ///< cls.realtime of the last frame
+} voipSpeaker_t;
+
+static voipSpeaker_t voipSpeakers[MAX_CLIENTS];
+static unsigned int  voipIgnore[2];             ///< muted players (set by cgame)
+
+/**
+ * @brief CL_VoipServerHasVoice
+ * @return qtrue when the server advertises voice (serverinfo sv_voice 1)
+ */
+static qboolean CL_VoipServerHasVoice(void)
+{
+	const char *info;
+
+	if (!cl.gameState.stringOffsets[CS_SERVERINFO])
+	{
+		return qfalse;
+	}
+	info = cl.gameState.stringData + cl.gameState.stringOffsets[CS_SERVERINFO];
+	return atoi(Info_ValueForKey(info, "sv_voice")) > 0 ? qtrue : qfalse;
+}
