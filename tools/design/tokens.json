{
  "_about": "TrueCombat: Platinum design tokens (Direction A, 'Command'). The one source for colours, type and shape across the website, launcher, in-game menus and HUD, staff portal and Discord bot. Edit here, then run: python tools/design/gen_tokens.py",
  "color": {
    "ink":      {"hex": "#090b0f", "use": "deepest ground: caption bars, page edges"},
    "bg":       {"hex": "#0d1016", "use": "page ground"},
    "panel":    {"hex": "#141922", "use": "cards and panels"},
    "panel2":   {"hex": "#1a202b", "use": "raised surfaces, fields"},
    "line":     {"hex": "#262e3b", "use": "hairlines on solid ground"},
    "lineHot":  {"hex": "#5a667a", "use": "hovered borders"},
    "fg":       {"hex": "#e8eaef", "use": "primary text"},
    "muted":    {"hex": "#9aa3b3", "use": "secondary text"},
    "dim":      {"hex": "#868f9f", "use": "labels, hints"},
    "steel":    {"hex": "#b0b8c6", "use": "chips, neutral icons"},
    "red":      {"hex": "#d63b3b", "use": "Platinum red: primary action, focus, selection"},
    "redHi":    {"hex": "#ef5050", "use": "primary hover, highlights on dark"},
    "redEdge":  {"hex": "#a82a2e", "use": "pressed primary, button edge"},
    "amber":    {"hex": "#e7a73c", "use": "warnings, compass lamp, counts"},
    "ok":       {"hex": "#4fbf7a", "use": "online, verified, success"},
    "danger":   {"hex": "#c98a8c", "use": "destructive text (Disconnect, Exit)"},
    "staff":    {"hex": "#f08a24", "use": "staff orange: reserved for staff names and badges"},
    "teamTerrorists": {"hex": "#e04848", "use": "Terrorists"},
    "teamSpecops":    {"hex": "#3f7fe0", "use": "Special Forces"}
  },
  "alpha": {
    "hairline": 0.12,
    "hairlineStrong": 0.24,
    "track": 0.09,
    "scrim": 0.72
  },
  "font": {
    "display": {"family": "Saira Condensed", "weights": [600, 700], "use": "headings, buttons, labels; upper case, +3% tracking"},
    "body":    {"family": "IBM Plex Sans", "weights": [400, 500, 600], "use": "running text and values"},
    "mono":    {"family": "JetBrains Mono", "weights": [400, 500], "use": "numbers, versions, pings, codes"}
  },
  "shape": {
    "radius": 0,
    "radiusLauncher": 6,
    "tick": 10,
    "tickWeight": 2,
    "stroke": 2,
    "_note": "Square corners with corner ticks (viewfinder brackets) everywhere except the launcher, which keeps its approved 6 px rounding."
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 420,
    "ease": [0.2, 0.7, 0.2, 1]
  }
}
