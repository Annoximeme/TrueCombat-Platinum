+++ b/analysis_scripts/x64/release_canary.py
@@ -0,0 +1,86 @@
+"""Post-publish canary: check the release exactly as players' launchers see it.
+
+A publish (a full release or a launcher-only hotfix) is not done until this passes. It downloads, from the
+public URLs (github.com, redirected to release-assets.githubusercontent.com):
+  - releases/latest/download/update.txt: signature valid against the public key built into launchers
+    (release_src/platinum_update_key.h), version as expected, every URL https;
+  - files.txt: its SHA-256 matches files_sha256;
+  - 3 random per-file assets (each under 300 MB): size and SHA-256 match files.txt;
+  - the launcher named by the feed (launcher=): size and SHA-256 match, version marker as advertised, and, with
+    --launcher, byte-identical to the file that passed the launcher repair suite;
+  - TrueCombat-Platinum-Setup.exe answers on releases/latest/download (the website's download button).
+Writes experiments/release-canary/<version>-<UTC time>.json; exit 0 only when everything passed.
+
+  python analysis_scripts/x64/release_canary.py --version 0.38.1-sandbox35 [--launcher <shipped exe>] [--seed N]
+"""
+from pathlib import Path
+import argparse, hashlib, json, random, re, sys, time, urllib.request
+ROOT = Path(__file__).resolve().parents[2]
+p = argparse.ArgumentParser()
+p.add_argument('--version', required=True)
+p.add_argument('--repo', default='Annoximeme/TrueCombat-Platinum')
+p.add_argument('--launcher', type=Path, default=None, help='the launcher that passed the gate; the published one must be identical')
+p.add_argument('--samples', type=int, default=3)
+p.add_argument('--seed', type=int, default=None)
+args = p.parse_args()
+checks = []
+def check(name, ok, detail=''):
+    checks.append({'check': name, 'pass': bool(ok), 'detail': detail}); print(('PASS ' if ok else 'FAIL ') + name + (': ' + detail if detail else ''), flush=True)
+    return ok
+def fetch(url, limit=400 << 20):
+    request = urllib.request.Request(url, headers={'User-Agent': 'TrueCombatPlatinumLauncher/canary'})
+    with urllib.request.urlopen(request, timeout=60) as r:
+        data = r.read(limit + 1); final = r.geturl()
+    assert len(data) <= limit, f'{url} is larger than {limit} bytes'
+    return data, final
+def public_key():
+    from cryptography.hazmat.primitives.asymmetric import ec
+    raw = bytes(int(x, 16) for x in re.findall(r'0x([0-9a-fA-F]{2})', (ROOT/'release_src/platinum_update_key.h').read_text()))
+    assert len(raw) == 64
+    return ec.EllipticCurvePublicNumbers(int.from_bytes(raw[:32], 'big'), int.from_bytes(raw[32:], 'big'), ec.SECP256R1()).public_key()
+def signature_ok(text):
+    from cryptography.hazmat.primitives import hashes
+    from cryptography.hazmat.primitives.asymmetric import ec
+    from cryptography.hazmat.primitives.asymmetric.utils import encode_dss_signature
+    from cryptography.exceptions import InvalidSignature
+    marker = text.rfind(b'\nsignature=')
+    if marker < 0: return False
+    body, sig = text[:marker + 1], bytes.fromhex(text[marker + 11:].strip().decode())
+    try:
+        public_key().verify(encode_dss_signature(int.from_bytes(sig[:32], 'big'), int.from_bytes(sig[32:], 'big')), body, ec.ECDSA(hashes.SHA256())); return True
+    except InvalidSignature: return False
+
+base = f'https://github.com/{args.repo}/releases'
+try:
+    feed, final = fetch(f'{base}/latest/download/update.txt', 64 << 10)
+    check('update.txt reachable', True, final.split('?')[0])
+    check('update.txt signature', signature_ok(feed))
+    fields = dict(l.split('=', 1) for l in feed.decode('utf-8').splitlines() if '=' in l)
+    check('latest version', fields.get('version') == args.version, fields.get('version', ''))
+    check('https only', all(v.startswith('https://') for k, v in fields.items() if k in ('package', 'files', 'launcher', 'page')))
+    listing, final = fetch(fields['files'], 4 << 20)
+    check('files.txt sha256', hashlib.sha256(listing).hexdigest() == fields.get('files_sha256', '').lower(), final.split('?')[0].split('/')[2])
+    entries = [l.split(' ', 3) for l in listing.decode('utf-8').splitlines() if len(l.split(' ', 3)) == 4]
+    pool = [e for e in entries if int(e[1]) < 300 << 20]
+    rng = random.Random(args.seed)
+    folder = fields['files'].rsplit('/', 1)[0]
+    for digest, size, asset, rel in rng.sample(pool, min(args.samples, len(pool))):
+        data, final = fetch(f'{folder}/{asset}', int(size) + 1)
+        check(f'asset {rel}', len(data) == int(size) and hashlib.sha256(data).hexdigest() == digest.lower(), f'{int(size)} bytes from {final.split("?")[0].split("/")[2]}')
+    if 'launcher' in fields:
+        data, _ = fetch(fields['launcher'], 64 << 20)
+        ok = len(data) == int(fields['launcher_bytes']) and hashlib.sha256(data).hexdigest() == fields['launcher_sha256'].lower()
+        marker = f"TrueCombatPlatinumLauncher/{fields.get('launcher_version', '')}\0".encode('utf-16-le')
+        check('launcher asset', ok and marker in data, fields.get('launcher_version', ''))
+        if args.launcher:
+            check('launcher is the gated build', hashlib.sha256(data).hexdigest() == hashlib.sha256(args.launcher.read_bytes()).hexdigest())
+    request = urllib.request.Request(f'{base}/latest/download/TrueCombat-Platinum-Setup.exe', method='HEAD', headers={'User-Agent': 'TrueCombatPlatinumLauncher/canary'})
+    with urllib.request.urlopen(request, timeout=60) as r: check('website installer', r.status == 200, r.geturl().split('?')[0].split('/')[2])
+except Exception as e:
+    check('canary run', False, f'{type(e).__name__}: {e}')
+passed = bool(checks) and all(c['pass'] for c in checks)
+out = ROOT/'experiments'/'release-canary'; out.mkdir(parents=True, exist_ok=True)
+stamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
+(out/f'{args.version}-{stamp}.json').write_text(json.dumps({'version': args.version, 'when': stamp, 'passed': passed, 'checks': checks}, indent=2), encoding='utf-8')
+print('canary:', 'PASSED - publish complete' if passed else 'FAILED - the publish is NOT done; fix and re-run')
+sys.exit(0 if passed else 1)
diff --git a/tests/launcher_repair/README.md b/tests/launcher_repair/README.md
new file mode 100644
index 0000000..d911507
--- /dev/null
+++ b/tests/launcher_repair/README.md
@@ -0,0 +1,59 @@
+# Launcher update and repair gate
+
+Since launcher 2.6.2, no launcher ships unless this suite has passed on **exactly that file**
+(same SHA-256). It came out of the 0.38.0 antivirus incident: on a player's PC, the antivirus removed the
+new engine from the update, the launcher kept the old one next to the new data, and Settings > Updates
+only said "Update check failed", with no reason, no repair and nothing in a log.
+
+## What it covers
+
+| case | broken state | what must happen |
+|---|---|---|
+| `friend` | previous release with an even older engine, HD textures on, leftover `updates\staging` and `package.zip.part` | leftovers cleared on start, update to the current release, every file (HD included) matches the signed list, next start is clean |
+| `engine_missing` | current release without `engine\platinum-engine.bin` | repaired on start; the next start reports "Repaired 1 file" |
+| `corrupt_pak` | one byte flipped in a pak (same size) | Verify and repair finds it, replaces it and re-hashes it |
+| `av_write_denied` | a game file cannot be written (access denied, as a blocking scanner answers) | the failure names the file and asks for an antivirus exception; it is fetched once the block is gone |
+| `av_deleted` | the staged engine vanishes right after it is written | the result names the file; the next start repairs it |
+| `blocked_host` | the asset host drops every connection while the feed host answers (a web shield) | the failure names the blocked host |
+| `offline` | nothing answers | "Could not reach ..." with the Windows error |
+| `bad_signature` | one byte of update.txt changed | rejected as unsigned |
+| `update_failed` | restart after a failed apply (`--update-failed`) | Settings > Updates shows the reason (screenshot in the run's `out` folder) |
+| `self_update` | the **previous released** launcher, in a broken install with an update pending | updates itself to the launcher under test |
+| `self_current` | the launcher under test | reports itself current |
+
+Errors 225 and 226 (virus detected or removed) take the same code path as access denied. Without an
+antivirus they cannot be produced on demand, so they are covered by `av_write_denied` and code review.
+
+## How it runs
+
+Everything runs on loopback. The release's own `update.txt` is rewritten to point at a local server and
+re-signed with the release key, which never leaves the PC. Each case installs a real copy (no hard links:
+Easy Anti-Cheat refuses them), and the copies are deleted afterwards. It uses CPU and disk only: no GPU and
+no `suite.lock`, so it can run next to an in-game pass. A full run takes about 5 minutes.
+
+```
+python analysis_scripts/x64/launcher_release_build.py --out <dir>\TrueCombatPlatinum.exe --symbols <dir>
+python tests/launcher_repair/run_suite.py --launcher <dir>\TrueCombatPlatinum.exe ^
+    --previous-launcher dist\assets-<current release>\TrueCombatPlatinum-Launcher.exe ^
+    --dist dist --current <current release> --old <previous release> ^
+    --old-engine <engine of an older release> --work G:\TrueCombatWork\lrs
+python analysis_scripts/x64/launcher_gate.py <dir>\TrueCombatPlatinum.exe
+```
+
+A complete run is recorded in `experiments/launcher-gate/<sha256>.json`. The launcher build is reproducible
+(`launcher_release_build.py` is the only way a shipped launcher is built), so the file the packager builds
+has the same SHA-256 as the one the suite tested.
+
+## Where it is enforced
+
+- `package_from_candidate.py` (full packages and `--launcher-only`) builds the launcher, then refuses to go on
+  unless `launcher_gate.py` passes for it.
+- `make_update_feed.py` refuses to name a launcher in any feed, including a `--launcher-hotfix`, unless that
+  launcher passed.
+- `preflight_release.py` (0.39.0 and later) reports BLOCK while the candidate's launcher has no passing run.
+- `release_canary.py` runs after every publish. It downloads the live update.txt, files.txt and 3 random assets
+  from release-assets.githubusercontent.com, plus the launcher and the website installer, and checks the
+  signature and every SHA-256. The publish is not done until it passes.
+
+CI: the suite needs a full release (several GB) and the signing key, so it runs on the release PC only, not in
+the cloud kit gate or GitHub Actions. The kit gate already builds the launcher with `-Werror`.
