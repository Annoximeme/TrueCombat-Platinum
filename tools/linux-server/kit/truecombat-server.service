# systemd unit. Copy to /etc/systemd/system/, adjust User and the paths, then:
#   systemctl daemon-reload && systemctl enable --now truecombat-server
[Unit]
Description=TrueCombat: Platinum dedicated server
After=network-online.target
Wants=network-online.target

[Service]
User=truecombat
WorkingDirectory=/opt/truecombat-server
ExecStart=/opt/truecombat-server/start.sh
# With update-server.sh use ExecStart=/opt/truecombat-server/current/start.sh
# and add Environment=HOME_DIR=/opt/truecombat-server/home
Environment=PORT=27960
Restart=always
RestartSec=10
# SIGTERM makes the server finish the match report and shut down cleanly
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
