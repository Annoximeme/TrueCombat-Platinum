diff --git a/b/game_src/native/tcp_link.h b/game_src/native/tcp_link.h
new file mode 100644
index 0000000..a04c905
--- /dev/null
+++ b/game_src/native/tcp_link.h
@@ -0,0 +1,62 @@
+/* TrueCombat: Platinum - Discord account linking (server side).
+ *
+ * A player gets a one-time code from the Discord bot (/link) and enters it in
+ * game, either as the console command "link CODE" or as "!link CODE" in chat
+ * (never shown to other players). The server writes
+ *   <fs_homepath>/<fs_game>/links/CODE.json   {"code","guid","name","time"}
+ * The bot runs on the same machine, reads the file, turns the guid into the
+ * public player id the leaderboards use and deletes the file. Nothing is sent
+ * over the network and the guid never leaves the server.
+ */
+#ifndef TCP_LINK_H
+#define TCP_LINK_H
+
+static int linkLastRequest[MAX_CLIENTS];
+
+static void linkTell(int n,const char *text)
+{
+    char line[200];snprintf(line,sizeof(line),"print \"%s\n\"",text);
+    SystemCall(G_SEND_SERVER_COMMAND,n,line);
+}
+
+/* Codes are 6 characters from the bot's alphabet; dashes and spaces are ignored. */
+static int linkCode(const char *in,char *out)
+{
+    int len=0;
+    for(const char *c=in;*c;c++){
+        char ch=*c;
+        if(ch=='-'||ch==' ')continue;
+        if(ch>='a'&&ch<='z')ch=(char)(ch-32);
+        if(!((ch>='A'&&ch<='Z')||(ch>='0'&&ch<='9'))||len>=6)return 0;
+        out[len++]=ch;
+    }
+    out[len]=0;return len==6;
+}
+
+static void TCP_LinkRequest(int n,const char *arg)
+{
+    char code[8],info[MAX_INFO_STRING],guid[40],name[48],safe[48],body[256],path[64];
+    if(n<0||n>=maxClients||!clients[n].connected)return;
+    if(!linkCode(arg?arg:"",code)){linkTell(n,"Usage: link <code>. Get your code with /link in the TrueCombat Discord.");return;}
+    if(linkLastRequest[n]&&levelTime-linkLastRequest[n]<5000){linkTell(n,"Please wait a few seconds before trying again.");return;}
+    linkLastRequest[n]=levelTime;
+    SystemCall(G_GET_USERINFO,n,info,sizeof(info));
+    TCP_InfoValue(info,"cl_guid",guid,sizeof(guid));
+    int ok=(int)strlen(guid)==32;
+    for(int i=0;ok&&guid[i];i++){char g=guid[i];ok=(g>='0'&&g<='9')||(g>='a'&&g<='f')||(g>='A'&&g<='F');}
+    if(!ok){linkTell(n,"Linking needs a game profile key. Restart the game from the launcher and try again.");return;}
+    SystemCall(G_GET_CONFIGSTRING,CS_PLAYERS+n,info,sizeof(info));
+    TCP_InfoValue(info,"n",name,sizeof(name));
+    int j=0;for(int i=0;name[i]&&j<(int)sizeof(safe)-1;i++){unsigned char ch=(unsigned char)name[i];if(ch>=32&&ch<127&&ch!='"'&&ch!='\\')safe[j++]=(char)ch;}
+    safe[j]=0;
+    snprintf(body,sizeof(body),"{\"schema\":\"tcp-link/1\",\"code\":\"%s\",\"guid\":\"%s\",\"name\":\"%s\",\"time\":%d}\n",
+             code,guid,safe,levelTime);
+    snprintf(path,sizeof(path),"links/%s.json",code);
+    fileHandle_t f;
+    if(SystemCall(G_FS_FOPEN_FILE,path,&f,FS_WRITE)<0||!f){linkTell(n,"Linking is not available on this server.");return;}
+    SystemCall(G_FS_WRITE,body,(int)strlen(body),f);SystemCall(G_FS_FCLOSE_FILE,f);
+    linkTell(n,"^2Link request sent.^7 Head back to Discord, it will confirm in a few seconds.");
+    char log[96];snprintf(log,sizeof(log),"TCP_NATIVE_LINK slot=%d\n",n);print(log);
+}
+
+#endif
