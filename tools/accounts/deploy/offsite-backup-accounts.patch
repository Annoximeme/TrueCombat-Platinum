+def snapshot_accounts():
+    """A consistent copy of the accounts database (WAL mode, so never copy the file itself)."""
+    if not os.path.exists(ACCOUNTS_DB):
+        return
+    os.makedirs(os.path.dirname(ACCOUNTS_SNAP), mode=0o700, exist_ok=True)
+    tmp = ACCOUNTS_SNAP + ".tmp"
+    if os.path.exists(tmp):
+        os.remove(tmp)
+    src = sqlite3.connect(f"file:{ACCOUNTS_DB}?mode=ro", uri=True)
+    dst = sqlite3.connect(tmp)
+    src.backup(dst)
+    src.close()
+    dst.execute("VACUUM")       # same contents give the same bytes, so an unchanged night re-encrypts nothing
+    dst.close()
+    os.chmod(tmp, 0o600)
+    os.replace(tmp, ACCOUNTS_SNAP)
+
+
