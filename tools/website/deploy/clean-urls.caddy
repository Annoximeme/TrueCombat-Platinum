# truecombat.eu: addresses without .html.
# Imported from the truecombat.eu site block in /etc/caddy/Caddyfile by install-clean-urls.sh.
#   /maps        serves maps.html
#   /maps.html   301 to /maps (old links and bookmarks keep working, the query string is kept)
#   /index.html  301 to /,  /de/index.html  301 to /de/
# Only plain path characters are redirected, and the path may not start with // or a
# backslash, so a crafted address can never send a visitor to another site.

@tcp_html_q {
	path_regexp tcp_page ^(?:((?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/)index|((?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)+))\.html$
	expression {http.request.uri.query} != ""
}
redir @tcp_html_q {re.tcp_page.1}{re.tcp_page.2}?{http.request.uri.query} 301

@tcp_html {
	path_regexp tcp_page ^(?:((?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*/)index|((?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)+))\.html$
	expression {http.request.uri.query} == ""
}
redir @tcp_html {re.tcp_page.1}{re.tcp_page.2} 301

# a page file wins over a folder of the same name (press.html next to press/)
try_files {path}.html {path}
