[Unit]
Description=TrueCombat: Platinum devlog reads and ratings (no visitor tracking)
After=network-online.target

[Service]
User=tcpsvc
Group=tcpsvc
# Add --public-reads to show read counts on the site (ratings appear after 5 votes either way)
ExecStart=/usr/bin/python3 /opt/tcp/server-bridge/tcp_devlog.py --db /var/lib/tcp-devlog/devlog.db --key-file ${CREDENTIALS_DIRECTORY}/key --site-root /var/www/truecombat --listen 127.0.0.1:8092
LoadCredential=key:/etc/tcp-devlog/key
Restart=on-failure
RestartSec=5
StateDirectory=tcp-devlog
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/tcp-devlog
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
