diff --git a/reference/etlegacy/src/sys/sys_win32.c b/reference/etlegacy/src/sys/sys_win32.c
index 982007c..8cb369c 100644
--- a/reference/etlegacy/src/sys/sys_win32.c
+++ b/reference/etlegacy/src/sys/sys_win32.c
@@ -1126,6 +1126,41 @@ void Sys_SetProcessProperties(void)
 
 WinVars_t g_wv;
 
+#ifdef DEDICATED
+/**
+ * @brief TCP: keep the 1 ms timer when the server window is hidden or minimized.
+ * Windows 11 otherwise ignores timeBeginPeriod for such processes. Looked up at run time,
+ * so older Windows versions simply skip it.
+ */
+static void Sys_KeepTimerResolution(void)
+{
+	typedef struct
+	{
+		ULONG Version;
+		ULONG ControlMask;
+		ULONG StateMask;
+	} tcpPowerThrottling_t;
+	typedef BOOL (WINAPI *setProcInfo_t)(HANDLE, int, LPVOID, DWORD);
+	setProcInfo_t        setProcInfo;
+	tcpPowerThrottling_t state;
+	HMODULE              kernel = GetModuleHandleA("kernel32.dll");
+
+	if (!kernel)
+	{
+		return;
+	}
+	setProcInfo = (setProcInfo_t)(void *)GetProcAddress(kernel, "SetProcessInformation");
+	if (!setProcInfo)
+	{
+		return;
+	}
+	state.Version     = 1;      // PROCESS_POWER_THROTTLING_CURRENT_VERSION
+	state.ControlMask = 0x5;    // EXECUTION_SPEED | IGNORE_TIMER_RESOLUTION
+	state.StateMask   = 0;      // opt out of both
+	setProcInfo(GetCurrentProcess(), 4 /* ProcessPowerThrottling */, &state, sizeof(state));
+}
+#endif
+
 /**
  * @brief Windows specific initialization
  */
@@ -1160,6 +1195,10 @@ void Sys_PlatformInit(void)
 
 #ifdef DEDICATED
 	Sys_ShowConsoleWindow(1, qtrue);
+	// TCP: 1 ms timer resolution, otherwise Windows sleeps the server loop in 15.6 ms steps
+	// and sv_fps 128 cannot hold its 7/8 ms frames
+	Sys_KeepTimerResolution();
+	timeBeginPeriod(1);
 #endif
 
 	// no abort/retry/fail errors
@@ -1170,6 +1209,9 @@ NORETURN_MSVC void _attribute((noreturn)) Sys_PlatformExit(int code)
 {
 #if defined(LEGACY_DUMP_MEMLEAKS)
 	_CrtDumpMemoryLeaks();
+#endif
+#ifdef DEDICATED
+	timeEndPeriod(1);
 #endif
 	exit(code);
 }
