diff --git a/reference/etlegacy/src/renderer_dx12/dx12_core.cpp b/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
index 5b12be3..f396170 100755
--- a/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
+++ b/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
@@ -717,6 +717,15 @@ float2 DetailSlope(int id, float2 uv)
 // 0.39.0: parallax depth on brick, cobble, stone and rubble (matPad.x: depth in texture space, 0 off; matPad.y: full
 // strength out to this many units, gone at twice it). The height is the albedo's brightness, so mortar joints and the
 // gaps between cobbles sink in. Ten steps plus one refinement, only close up; world textures only, never the silhouette.
+// 0.39.0: matPad.z 1 = the HD pack's height map in the rmao alpha (1 = top) instead of the albedo's brightness.
+float ParallaxDepthAt(float2 uv, float2 gx, float2 gy)
+{
+	if (matPad.z > 0.5)
+		return 1.0 - texRmao.SampleGrad(samp0, uv, gx, gy).a;
+	// audit F01: the albedo is read one mip softer, so colour noise and the hard mortar edge make a smooth slope
+	// instead of jagged steps
+	return 1.0 - saturate((Luma(tex0.SampleGrad(samp0, uv, gx * 2.0, gy * 2.0).rgb) - 0.12) * 1.6);
+}
 float2 ParallaxUv(VO i)
 {
 	float k = matPad.x * saturate(2.0 - length(i.eye) / max(matPad.y, 1.0));
@@ -724,29 +733,36 @@ float2 ParallaxUv(VO i)
 		return i.uv0;
 	float3 v = normalize(-i.eye), ng = normalize(i.normal);
 	float vz = dot(v, ng);
-	if (vz < 0.05)
+	// 0.39.0 audit F01: fades out toward grazing angles. The offset grows with 1/vz, and a march of a few
+	// layers then jumps across thin mortar: stepped spikes and smeared slices on brick seen along the wall.
+	k *= saturate((vz - 0.2) / 0.3);
+	// ceilings and other downward-facing surfaces stay flat, whatever their texture is called (world draws only, so
+	// modelView is the camera's: its z column is world up in view space)
+	k *= saturate((dot(ng, normalize(mul((float3x3)modelView, float3(0.0, 0.0, 1.0)))) + 0.85) / 0.25);
+	if (k <= 0.0005)
 		return i.uv0;
 	float3 t = i.tangent.xyz - ng * dot(ng, i.tangent.xyz);
 	if (dot(t, t) < 1e-8)
 		return i.uv0;
 	t = normalize(t);
 	float3 b = cross(ng, t) * (i.tangent.w < 0.0 ? -1.0 : 1.0);
-	float2 dir = float2(dot(v, t), dot(v, b)) / max(vz, 0.3) * k;
+	float2 dir = float2(dot(v, t), dot(v, b)) / max(vz, 0.5) * k;
 	float2 gx = ddx(i.uv0), gy = ddy(i.uv0);
-	const int steps = 10;
-	const float layer = 1.0 / steps;
+	// more layers when oblique (8 face-on, 24 at the fade): no visible slices
+	int steps = (int)lerp(24.0, 8.0, saturate((vz - 0.2) / 0.8));
+	float layer = 1.0 / steps;
 	float2 uv = i.uv0, duv = dir * layer;
 	float depth = 0.0;
-	float h = 1.0 - saturate((Luma(tex0.SampleGrad(samp0, uv, gx, gy).rgb) - 0.12) * 1.6);
+	float h = ParallaxDepthAt(uv, gx, gy);
 	[loop] for (int s = 0; s < steps && depth < h; s++)
 	{
 		uv -= duv;
 		depth += layer;
-		h = 1.0 - saturate((Luma(tex0.SampleGrad(samp0, uv, gx, gy).rgb) - 0.12) * 1.6);
+		h = ParallaxDepthAt(uv, gx, gy);
 	}
 	float2 prev = uv + duv;
 	float after = h - depth;
-	float before = (1.0 - saturate((Luma(tex0.SampleGrad(samp0, prev, gx, gy).rgb) - 0.12) * 1.6)) - (depth - layer);
+	float before = ParallaxDepthAt(prev, gx, gy) - (depth - layer);
 	float w = after / min(after - before, -0.0001);
 	return lerp(uv, prev, saturate(w));
 }
