+	float3 V    = normalize(-P);
+	float3 R    = reflect(-V, N);
+	float  fres = 0.02 + 0.98 * pow(1.0 - saturate(dot(N, V)), 5.0);
+	float  stepLen = max(dist * 0.015, 3.0);
+	float3 Q    = P + N * 0.5;
+	float3 hit  = 0.0;
+	float  found = 0.0;
+	[loop] for (int i = 0; i < 28; i++)
+	{
+		Q    += R * stepLen;
+		stepLen *= 1.13;
+		if (-Q.z <= 1.0)
