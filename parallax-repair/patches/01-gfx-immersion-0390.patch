+	float3 Pr = ViewPos(pixel + float2(1, 0), EyeDistance(LoadDepth(ClampRect(p + int2(1, 0)))));
+	float3 Pl = ViewPos(pixel - float2(1, 0), EyeDistance(LoadDepth(ClampRect(p - int2(1, 0)))));
+	float3 Pd = ViewPos(pixel + float2(0, 1), EyeDistance(LoadDepth(ClampRect(p + int2(0, 1)))));
+	float3 Pu = ViewPos(pixel - float2(0, 1), EyeDistance(LoadDepth(ClampRect(p - int2(0, 1)))));
+	float3 dx = abs(Pr.z - P.z) < abs(P.z - Pl.z) ? Pr - P : P - Pl;
+	float3 dy = abs(Pd.z - P.z) < abs(P.z - Pu.z) ? Pd - P : P - Pu;
+	float3 N  = normalize(cross(dx, dy));
+	if (dot(N, -P) < 0.0)
+		N = -N;
+	float3 Nw = float3(dot(x4.xyz, N), dot(x5.xyz, N), dot(x6.xyz, N));
