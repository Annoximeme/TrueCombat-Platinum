+/* 0.39.0: world-view extras for this view (DX_SetPostExtra): aim-down-sights focus, sun shafts and glare, wet patches. */
+static void DX_PostExtras(void)
+{
+	float       v[28];
+	qboolean    any = qfalse;
+	const float tanX = tanf(DEG2RAD(backEnd.refdef.fov_x * 0.5f)), tanY = tanf(DEG2RAD(backEnd.refdef.fov_y * 0.5f));
+	const float *axis = &backEnd.refdef.viewaxis[0][0];
+	const float *org  = backEnd.refdef.vieworg;
+	const float height = (float)(dxs.lastHeight > 0 ? dxs.lastHeight : 1080);
+	const dxMapLook_t *look = DX_MapLook();
+	const qboolean ultra = r_dx12Materials->integer && !DX_ClassicForced();
