+float PNoise(float2 p)
+{
+	float2 i = floor(p), f = frac(p);
+	f = f * f * (3.0 - 2.0 * f);
+	return lerp(lerp(PHash(i), PHash(i + float2(1, 0)), f.x), lerp(PHash(i + float2(0, 1)), PHash(i + float2(1, 1)), f.x), f.y);
