diff --git a/game_src/native/tcp_gfx039_cg.h b/game_src/native/tcp_gfx039_cg.h
new file mode 100644
index 0000000..c2e2ca1
--- /dev/null
+++ b/game_src/native/tcp_gfx039_cg.h
@@ -0,0 +1,151 @@
+/* GPL-3.0-or-later. 0.39.0 graphics immersion (cgame). Included by tcp_cgame.c after tcp_immersion_cg.h.
+ *
+ *  - Ranked look: serverinfo tcp_rk (Ranked or a clan match) -> cl_tcpRanked, which the DX12 renderer reads to keep
+ *    sun shafts, sun glare and the map colour mood off; the lens effects below and muzzle-lit smoke are off too.
+ *  - Aim-down-sights focus: the aim blend (eased over 180 ms) -> r_dx12AdsFocus; the DX12 post pass softens the rear
+ *    of the player's own gun (never the world). Off through a magnified scope and in photo mode.
+ *  - Water ripples: rings spread on the surface around anyone wading or swimming (more while moving) and where a
+ *    bullet goes into water. Flat polys on the surface (both renderers); cg_impactEffects 0 keeps the bullet rings off.
+ *  - Lens: drops run down the screen edges for a few seconds after the head comes out of water; on Snow, frost
+ *    creeps into the screen corners outdoors and melts indoors. Only the outer edge of the screen, never the centre.
+ *    cg_lensEffects 0 turns both off; always off on Ranked and in clan matches.
+ * Debug: gfxTest ripple | drops | frost (console). */
+
+static int vxCamActive(void); /* tcp_vux_cg.h (photo mode) */
+static vmCvar_t gfxLensCvar;
+static qhandle_t gfxShRipple,gfxShDrop,gfxShFrost;
+static int gfxRanked=-1;
+
+static void gfxMedia(void){
+    static int done;if(done)return;done=1;
+    SystemCall(CG_CVAR_REGISTER,&gfxLensCvar,"cg_lensEffects","1",CVAR_ARCHIVE);
+    gfxShRipple=(qhandle_t)SystemCall(CG_R_REGISTERSHADER,"gfx/platinum/gfx039/ripple");
+    gfxShDrop=(qhandle_t)SystemCall(CG_R_REGISTERSHADER,"gfx/platinum/gfx039/drop");
+    gfxShFrost=(qhandle_t)SystemCall(CG_R_REGISTERSHADER,"gfx/platinum/gfx039/frost");
+    char m[96];snprintf(m,sizeof(m),"TCP_GFX media ripple=%d drop=%d frost=%d\n",gfxShRipple,gfxShDrop,gfxShFrost);SystemCall(CG_PRINT,m);
+}
+
+/* from refreshMovementSettings (serverinfo changes) */
+static void gfxServerInfo(void){
+    char v[8]="";TCP_InfoValue(config(CS_SERVERINFO),"tcp_rk",v,sizeof(v));
+    const int rk=atoi(v)!=0;gpRanked=rk;
+    if(rk!=gfxRanked){gfxRanked=rk;SystemCall(CG_CVAR_SET,"cl_tcpRanked",rk?"1":"0");}
+}
+
+/* ---- aim-down-sights focus ------------------------------------------------------------------------------------ */
+static void gfxAdsFrame(const playerState_t *p,int time){
+    static float blend,sent=-1.f;static int last;
+    const int dt=last&&time>last&&time-last<250?time-last:0;last=time;
+    const int scoped=p->holdable[TCP_HOLD_SCOPE10]>10; /* a magnified scope draws its own overlay */
+    const int want=p->holdable[TCP_HOLD_AIMED]&&!scoped&&p->stats[STAT_HEALTH]>0&&p->pm_type==PM_NORMAL&&!vxCamActive();
+    const float step=dt/180.f;
+    blend=want?fminf(1.f,blend+step):fmaxf(0.f,blend-step);if(!dt)blend=want?1.f:0.f;
+    if(fabsf(blend-sent)>=.04f||((blend==0.f||blend==1.f)&&blend!=sent)){
+        char v[16];snprintf(v,sizeof(v),"%.2f",blend);SystemCall(CG_CVAR_SET,"r_dx12AdsFocus",v);sent=blend;}
+}
+
+/* ---- water ripples -------------------------------------------------------------------------------------------- */
+#define GFX_RIPPLES 48
+typedef struct {vec3_t at;int start,life;float r0,r1,alpha;} gfxRipple_t;
+static gfxRipple_t gfxRipples[GFX_RIPPLES];
+static int gfxWadeNext[MAX_GENTITIES];
+static void gfxRippleAdd(const vec3_t at,float r0,float r1,int life,float alpha,int time){
+    gfxRipple_t *slot=&gfxRipples[0];
+    for(int i=0;i<GFX_RIPPLES;i++){gfxRipple_t *q=&gfxRipples[i];
+        if(!q->start||time-q->start>=q->life||time<q->start){slot=q;break;}
+        if(q->start<slot->start)slot=q;}
+    VectorCopy(at,slot->at);slot->start=time?time:1;slot->life=life;slot->r0=r0;slot->r1=r1;slot->alpha=alpha;
+}
+/* the water surface above or at `at` (traced down from 64 u above); 0 when there is none */
+static int gfxWaterSurface(const vec3_t at,vec3_t out){
+    trace_t tr;static const vec3_t z={0,0,0};vec3_t from={at[0],at[1],at[2]+64.f},to={at[0],at[1],at[2]-32.f};
+    if(SystemCall(CG_CM_POINTCONTENTS,from,0)&TCP_MASK_WATER)return 0; /* deep under: no surface close above */
+    SystemCall(CG_CM_BOXTRACE,&tr,from,to,z,z,0,TCP_MASK_WATER);
+    if(tr.fraction>=1.f||tr.startsolid)return 0;
+    VectorCopy(tr.endpos,out);out[2]+=.6f;return 1;
+}
+/* every player in water (level 1-2: wading; 3 with the head just under still breaks the surface), from the player loop */
+static void gfxWade(int number,int level,const vec3_t origin,const vec3_t velocity,int time){
+    if(number<0||number>=MAX_GENTITIES||level<=0||!gfxShRipple)return;
+    if(gfxWadeNext[number]&&time<gfxWadeNext[number]&&gfxWadeNext[number]-time<2000)return;
+    const float speed=sqrtf(velocity[0]*velocity[0]+velocity[1]*velocity[1]);
+    gfxWadeNext[number]=time+(speed>40.f?260:1100);
+    vec3_t s;if(!gfxWaterSurface(origin,s))return;
+    if(speed>40.f){s[0]-=velocity[0]*.06f;s[1]-=velocity[1]*.06f;} /* rings trail a little behind a walker */
+    gfxRippleAdd(s,10.f,speed>40.f?58.f:40.f,speed>40.f?1500:2200,speed>40.f?.55f:.35f,time);
+}
+/* a bullet into water (ffImpactWater) */
+static void gfxBulletRipple(const vec3_t at,int effects,int time){
+    if(!effects||!gfxShRipple)return;
+    vec3_t s={at[0],at[1],at[2]+.6f};
