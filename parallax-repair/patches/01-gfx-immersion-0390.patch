+	if (backEnd.viewParms.isPortal || tanX <= 0.0f || tanY <= 0.0f)
+	{
+		DX_SetPostExtra(NULL, 0);
+		return;
+	}
+	/* aim down sights: the cgame's fraction; focus 16 units ahead (front sight), full softness at 7 */
+	if (r_dx12AdsDof->value > 0.0f && r_dx12AdsFocus->value > 0.0f)
+	{
+		v[0] = Com_Clamp(0.0f, 1.0f, r_dx12AdsDof->value) * Com_Clamp(0.0f, 1.0f, r_dx12AdsFocus->value);
+		v[1] = 16.0f;
+		v[2] = 7.0f;
+		v[3] = 2.5f * height / 1080.0f;
+		any  = qtrue;
+	}
+	/* the sun: from q3map_sun or the light grid (the same source as the sun shadows) */
+	if (ultra && !DX_RankedLook() && (r_dx12SunShafts->value > 0.0f || r_dx12SunGlare->value > 0.0f) && DX_ShadowSun())
+	{
+		vec3_t d;
+		float  z, x, y;
+
+		VectorCopy(dxsh.sun, d);
+		z = DotProduct(d, backEnd.refdef.viewaxis[0]);
+		if (z > 0.05f)
+		{
+			x = -DotProduct(d, backEnd.refdef.viewaxis[1]) / (z * tanX);
+			y = DotProduct(d, backEnd.refdef.viewaxis[2]) / (z * tanY);
+			if (x > -2.5f && x < 2.5f && y > -2.5f && y < 2.5f)
+			{
+				float m = MAX(dxsh.sunColor[0], MAX(dxsh.sunColor[1], dxsh.sunColor[2]));
+
+				v[4]  = x * 0.5f + 0.5f;
+				v[5]  = 0.5f - y * 0.5f;
+				v[6]  = Com_Clamp(0.0f, 1.0f, r_dx12SunShafts->value);
+				v[7]  = Com_Clamp(0.0f, 1.0f, r_dx12SunGlare->value);
+				v[8]  = m > 0.0f ? dxsh.sunColor[0] / m : 1.0f;
+				v[9]  = m > 0.0f ? dxsh.sunColor[1] / m : 1.0f;
+				v[10] = m > 0.0f ? dxsh.sunColor[2] / m : 1.0f;
+				v[11] = Com_Clamp(0.0f, 1.0f, (z - 0.05f) / 0.3f);
+				any   = qtrue;
+			}
+		}
+	}
+	/* wet patches: per map, with the view's rotation and origin for the world-space pattern */
+	if (ultra && look && look->wet > 0.0f && r_dx12WetPatches->value > 0.0f)
+	{
+		v[12] = Com_Clamp(0.0f, 1.0f, r_dx12WetPatches->value);
+		v[13] = look->wet;
+		v[14] = backEnd.refdef.time * 0.001f;
+		v[15] = 220.0f;
+		/* eye space: x right, y up, -z forward (Q3 axes: [0] forward, [1] left, [2] up) */
+		for (i = 0; i < 3; i++)
+		{
+			v[16 + i * 4 + 0] = -axis[3 + i];
+			v[16 + i * 4 + 1] = axis[6 + i];
+			v[16 + i * 4 + 2] = -axis[0 + i];
+			v[16 + i * 4 + 3] = org[i];
+		}
+		any = qtrue;
+	}
+	DX_SetPostExtra(any ? v : NULL, any ? 28 : 0);
+}
