diff --git a/reference/etlegacy/src/renderercommon/tcp_lightmap_smooth.h b/reference/etlegacy/src/renderercommon/tcp_lightmap_smooth.h
new file mode 100644
index 0000000..a589128
--- /dev/null
+++ b/reference/etlegacy/src/renderercommon/tcp_lightmap_smooth.h
@@ -0,0 +1,412 @@
+/*
+ * TrueCombat: Platinum - smoother lightmaps (0.39.0).
+ *
+ * The maps ship 256x256 (Harbour 512x512) external lightmaps (maps/<map>/lm_NNNN.tga). Seen up close, the
+ * baked shadows are blocky and bilinear filtering shows stair steps along every shadow edge. At load time each
+ * lightmap is doubled in size with a Mitchell-Netravali filter that only mixes texels of the same lightmap chart:
+ *
+ *   1. the BSP's surfaces are rasterized in lightmap space, so every texel knows which chart it belongs to
+ *      (surfaces that share a lightmap vertex are one chart, as q3map2 merges coplanar faces);
+ *   2. q3map2's padding texels around each chart (lit, beyond the triangles) join the nearest chart;
+ *   3. the 2x upscale only takes taps from the centre texel's chart, weights renormalized.
+ *
+ * Brightness is unchanged (the filter is normalized), so dark corners stay exactly as dark: no visibility change.
+ * Both renderers (DX12 and OpenGL) include this header; r_lightmapSmooth 0 restores the original lightmaps.
+ * Cost: load time only (a few ms per lightmap) and 4x the lightmap memory (about 15-60 MB per map).
+ */
+#ifndef TCP_LIGHTMAP_SMOOTH_H
+#define TCP_LIGHTMAP_SMOOTH_H
+
+#include <math.h>
+
+static struct
+{
+	const dsurface_t *surfs;
+	int              numSurfs;
+	const drawVert_t *verts;
+	int              numVerts;
+	const int        *indexes;
+	int              numIndexes;
+	char             worldDir[MAX_QPATH];
+	int              active;
+} lmSmooth;
+
+static cvar_t *r_lightmapSmooth;
+
+/* RE_LoadWorldMap: the BSP lumps stay valid until the file is freed at the end of the load */
+static void TCP_LightmapSmoothBegin(const byte *base, const lump_t *surfs, const lump_t *verts, const lump_t *indexes,
+                                    const char *worldDir)
+{
+	if (!r_lightmapSmooth)
+	{
+		r_lightmapSmooth = ri.Cvar_Get("r_lightmapSmooth", "1", CVAR_ARCHIVE | CVAR_LATCH);
+	}
+	Com_Memset(&lmSmooth, 0, sizeof(lmSmooth));
+	if (!r_lightmapSmooth->integer || !worldDir)
+	{
+		return;
+	}
+	lmSmooth.surfs      = (const dsurface_t *)(base + surfs->fileofs);
+	lmSmooth.numSurfs   = surfs->filelen / (int)sizeof(dsurface_t);
+	lmSmooth.verts      = (const drawVert_t *)(base + verts->fileofs);
+	lmSmooth.numVerts   = verts->filelen / (int)sizeof(drawVert_t);
+	lmSmooth.indexes    = (const int *)(base + indexes->fileofs);
+	lmSmooth.numIndexes = indexes->filelen / (int)sizeof(int);
+	Q_strncpyz(lmSmooth.worldDir, worldDir, sizeof(lmSmooth.worldDir));
+	lmSmooth.active = 1;
+}
+
+static void TCP_LightmapSmoothEnd(void)
+{
+	Com_Memset(&lmSmooth, 0, sizeof(lmSmooth));
+}
+
+static int lmsFind(int *parent, int i)
+{
+	while (parent[i] != i)
+	{
+		parent[i] = parent[parent[i]];
+		i         = parent[i];
+	}
+	return i;
+}
+
+static void lmsUnion(int *parent, int a, int b)
+{
+	a = lmsFind(parent, a);
+	b = lmsFind(parent, b);
+	if (a != b)
+	{
+		parent[a < b ? b : a] = a < b ? a : b;
+	}
+}
+
+/* chart ids are surface numbers + 1; 0 = no chart */
+static void lmsRasterTri(int *ids, int w, int h, const float *a, const float *b, const float *c, int id)
+{
+	float ax = a[0] * w, ay = a[1] * h, bx = b[0] * w, by = b[1] * h, cx = c[0] * w, cy = c[1] * h;
+	float area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
+	int   x0, x1, y0, y1, x, y;
+
+	if (fabsf(area) < 1e-6f)
+	{
+		return;
+	}
+	x0 = (int)floorf(fminf(ax, fminf(bx, cx)) - 0.5f);
+	x1 = (int)ceilf(fmaxf(ax, fmaxf(bx, cx)) + 0.5f);
+	y0 = (int)floorf(fminf(ay, fminf(by, cy)) - 0.5f);
+	y1 = (int)ceilf(fmaxf(ay, fmaxf(by, cy)) + 0.5f);
+	if (x1 < 0 || y1 < 0 || x0 >= w || y0 >= h || x1 - x0 > w + 2 || y1 - y0 > h + 2)
+	{
+		return; /* off the page or wrapped coordinates: leave it to dilation */
+	}
+	x0 = x0 < 0 ? 0 : x0;
+	y0 = y0 < 0 ? 0 : y0;
+	x1 = x1 >= w ? w - 1 : x1;
+	y1 = y1 >= h ? h - 1 : y1;
+	for (y = y0; y <= y1; y++)
+	{
+		for (x = x0; x <= x1; x++)
+		{
+			float px = x + 0.5f, py = y + 0.5f;
+			float w0 = ((bx - px) * (cy - py) - (by - py) * (cx - px)) / area;
+			float w1 = ((cx - px) * (ay - py) - (cy - py) * (ax - px)) / area;
+			float w2 = 1.0f - w0 - w1;
+			/* a small tolerance: q3map2 samples at texel centres, so a chart's border texels sit on its edges */
+			if (w0 >= -0.02f && w1 >= -0.02f && w2 >= -0.02f && !ids[y * w + x])
+			{
+				ids[y * w + x] = id;
+			}
+		}
+	}
+}
+
+static float lmsMitchell(float x)
+{
+	const float B = 1.0f / 3.0f, C = 1.0f / 3.0f;
+	x = fabsf(x);
+	if (x < 1.0f)
+	{
+		return ((12.0f - 9.0f * B - 6.0f * C) * x * x * x + (-18.0f + 12.0f * B + 6.0f * C) * x * x + (6.0f - 2.0f * B)) / 6.0f;
+	}
+	if (x < 2.0f)
+	{
+		return ((-B - 6.0f * C) * x * x * x + (6.0f * B + 30.0f * C) * x * x + (-12.0f * B - 48.0f * C) * x + (8.0f * B + 24.0f * C)) / 6.0f;
+	}
+	return 0.0f;
+}
+
+/*
+ * Called by R_FindImageFile for lightmap images after R_ProcessLightmap. Returns a new RGBA buffer (Com_Allocate,
+ * caller frees with Com_Dealloc) twice the size, or NULL to keep the original.
+ */
+static byte *TCP_LightmapSmooth(const char *name, const byte *pic, int *width, int *height)
+{
+	const char *base;
+	int        index, w = *width, h = *height, i, j, k, x, y, ow, oh, pass;
+	int        *ids, *parent, *hashKey, hashSize;
+	byte       *src, *out;
+
+	if (!lmSmooth.active || w < 16 || h < 16 || w > 1024 || h > 1024)
+	{
+		return NULL;
+	}
+	base = strrchr(name, '/');
+	if (!base || Q_stricmpn(name, lmSmooth.worldDir, (int)strlen(lmSmooth.worldDir)) || sscanf(base + 1, "lm_%d", &index) != 1)
+	{
+		return NULL;
+	}
+
+	ids    = Com_Allocate(sizeof(int) * w * h);
+	parent = Com_Allocate(sizeof(int) * (lmSmooth.numSurfs + 1));
+	src    = Com_Allocate(w * h * 4);
+	if (!ids || !parent || !src)
+	{
+		Com_Dealloc(ids);
+		Com_Dealloc(parent);
+		Com_Dealloc(src);
+		return NULL;
+	}
+	Com_Memset(ids, 0, sizeof(int) * w * h);
+	Com_Memcpy(src, pic, w * h * 4);
+	for (i = 0; i <= lmSmooth.numSurfs; i++)
+	{
+		parent[i] = i;
+	}
+
+	/* surfaces sharing an exact lightmap vertex are one chart (open-addressed hash of the coordinate pair) */
+	hashSize = 1;
+	while (hashSize < lmSmooth.numVerts * 2 + 16)
+	{
+		hashSize <<= 1;
+	}
+	hashKey = Com_Allocate(sizeof(int) * 2 * hashSize);
+	if (hashKey)
+	{
+		for (i = 0; i < hashSize; i++)
+		{
+			hashKey[i * 2] = -1;
+		}
+	}
+
+	for (i = 0; i < lmSmooth.numSurfs; i++)
+	{
+		const dsurface_t *s   = &lmSmooth.surfs[i];
+		int              fv   = LittleLong(s->firstVert), nv = LittleLong(s->numVerts);
+		int              type = LittleLong(s->surfaceType);
+
+		if (LittleLong(s->lightmapNum) != index || fv < 0 || nv <= 0 || fv + nv > lmSmooth.numVerts)
+		{
+			continue;
+		}
+		if (hashKey)
+		{
+			for (j = 0; j < nv; j++)
+			{
+				const float  *lm = lmSmooth.verts[fv + j].lightmap;
+				unsigned int hv  = ((unsigned int)(lm[0] * 65536.0f) * 73856093u) ^ ((unsigned int)(lm[1] * 65536.0f) * 19349663u);
+				for (k = 0; k < hashSize; k++)
+				{
+					int slot = (int)((hv + (unsigned int)k) & (unsigned int)(hashSize - 1));
+					if (hashKey[slot * 2] < 0)
+					{
+						hashKey[slot * 2]     = fv + j;
+						hashKey[slot * 2 + 1] = i + 1;
+						break;
+					}
+					{
+						const float *o = lmSmooth.verts[hashKey[slot * 2]].lightmap;
+						if (o[0] == lm[0] && o[1] == lm[1])
+						{
+							lmsUnion(parent, hashKey[slot * 2 + 1], i + 1);
+							break;
+						}
+					}
+				}
+			}
+		}
+		if (type == MST_PATCH)
+		{
+			int pw = LittleLong(s->patchWidth), ph = LittleLong(s->patchHeight);
+			if (pw < 2 || ph < 2 || pw * ph > nv)
+			{
+				continue;
+			}
+			for (y = 0; y < ph - 1; y++)
+			{
+				for (x = 0; x < pw - 1; x++)
+				{
+					const drawVert_t *v = &lmSmooth.verts[fv + y * pw + x];
+					lmsRasterTri(ids, w, h, v[0].lightmap, v[1].lightmap, v[pw].lightmap, i + 1);
+					lmsRasterTri(ids, w, h, v[1].lightmap, v[pw + 1].lightmap, v[pw].lightmap, i + 1);
+				}
+			}
+		}
+		else if (type == MST_PLANAR || type == MST_TRIANGLE_SOUP)
+		{
+			int fi = LittleLong(s->firstIndex), ni = LittleLong(s->numIndexes);
+			if (fi < 0 || fi + ni > lmSmooth.numIndexes)
+			{
+				continue;
+			}
+			for (j = 0; j + 2 < ni; j += 3)
+			{
+				int a = LittleLong(lmSmooth.indexes[fi + j]), b = LittleLong(lmSmooth.indexes[fi + j + 1]), c = LittleLong(lmSmooth.indexes[fi + j + 2]);
+				if (a < 0 || b < 0 || c < 0 || a >= nv || b >= nv || c >= nv)
+				{
+					continue;
+				}
+				lmsRasterTri(ids, w, h, lmSmooth.verts[fv + a].lightmap, lmSmooth.verts[fv + b].lightmap, lmSmooth.verts[fv + c].lightmap, i + 1);
+			}
+		}
+	}
+	Com_Dealloc(hashKey);
+
+	/* nothing of this page is used by the BSP (another map's lightmap name, or a load from elsewhere) */
+	for (i = 0; i < w * h && !ids[i]; i++)
+	{
+	}
+	if (i == w * h)
+	{
+		Com_Dealloc(ids);
+		Com_Dealloc(parent);
+		Com_Dealloc(src);
+		return NULL;
+	}
+	for (i = 0; i < w * h; i++)
+	{
+		ids[i] = ids[i] ? lmsFind(parent, ids[i]) : 0;
+	}
+
+	/* chart padding: q3map2 pads every chart with lit texels beyond its triangles; those texels join the
+	 * nearest chart (3 rings), their colour is kept as baked */
+	for (pass = 0; pass < 3; pass++)
+	{
+		int changed = 0;
+		int *next   = Com_Allocate(sizeof(int) * w * h);
+		if (!next)
+		{
+			break;
+		}
+		Com_Memcpy(next, ids, sizeof(int) * w * h);
+		for (y = 0; y < h; y++)
+		{
+			for (x = 0; x < w; x++)
+			{
+				int dy, dx, best = 0;
+				if (ids[y * w + x])
+				{
+					continue;
+				}
+				for (dy = -1; dy <= 1 && !best; dy++)
+				{
+					for (dx = -1; dx <= 1; dx++)
+					{
+						int nx = x + dx, ny = y + dy;
+						if ((dx || dy) && nx >= 0 && ny >= 0 && nx < w && ny < h && ids[ny * w + nx])
+						{
+							best = ids[ny * w + nx];
+							break;
+						}
+					}
+				}
+				if (best)
+				{
+					next[y * w + x] = best;
+					changed         = 1;
+				}
+			}
+		}
+		Com_Memcpy(ids, next, sizeof(int) * w * h);
+		Com_Dealloc(next);
+		if (!changed)
+		{
+			break;
+		}
+	}
+
+	/* 2x Mitchell-Netravali upscale within the centre texel's chart */
+	ow  = w * 2;
+	oh  = h * 2;
+	out = Com_Allocate(ow * oh * 4);
+	if (!out)
+	{
+		Com_Dealloc(ids);
+		Com_Dealloc(parent);
+		Com_Dealloc(src);
+		return NULL;
+	}
+	/* a 2x upscale only ever samples at two phases (0.25 and 0.75 past a texel): weights per phase and tap */
+	{
+		float tw[2][4];
+		for (i = 0; i < 2; i++)
+		{
+			for (j = 0; j < 4; j++)
+			{
+				tw[i][j] = lmsMitchell((i ? 0.25f : 0.75f) - (float)(j - 1));
+			}
+		}
+	for (y = 0; y < oh; y++)
+	{
+		float sy = (y + 0.5f) * 0.5f - 0.5f;
+		int   cy = (int)floorf(sy);
+		for (x = 0; x < ow; x++)
+		{
+			float sx     = (x + 0.5f) * 0.5f - 0.5f;
+			int   cx     = (int)floorf(sx);
+			int   nearX  = (int)floorf((x + 0.5f) * 0.5f), nearY = (int)floorf((y + 0.5f) * 0.5f);
+			int   chart  = ids[(nearY < h ? nearY : h - 1) * w + (nearX < w ? nearX : w - 1)];
+			float acc[3] = { 0, 0, 0 }, total = 0;
+			int   ty, tx;
+			for (ty = cy - 1; ty <= cy + 2; ty++)
+			{
+				float wy = tw[y & 1][ty - cy + 1];
+				int   qy = ty < 0 ? 0 : (ty >= h ? h - 1 : ty);
+				for (tx = cx - 1; tx <= cx + 2; tx++)
+				{
+					int        qx = tx < 0 ? 0 : (tx >= w ? w - 1 : tx);
+					float      wt;
+					const byte *p;
+					if (chart && ids[qy * w + qx] != chart)
+					{
+						continue;
+					}
+					wt      = wy * tw[x & 1][tx - cx + 1];
+					p       = src + (qy * w + qx) * 4;
+					acc[0] += p[0] * wt;
+					acc[1] += p[1] * wt;
+					acc[2] += p[2] * wt;
+					total  += wt;
+				}
+			}
+			{
+				byte       *o = out + (y * ow + x) * 4;
+				const byte *n = src + ((nearY < h ? nearY : h - 1) * w + (nearX < w ? nearX : w - 1)) * 4;
+				if (total > 0.05f)
+				{
+					for (k = 0; k < 3; k++)
+					{
+						float v = acc[k] / total;
+						o[k] = (byte)(v < 0.0f ? 0 : (v > 255.0f ? 255 : (int)(v + 0.5f)));
+					}
+				}
+				else
+				{
+					o[0] = n[0];
+					o[1] = n[1];
+					o[2] = n[2];
+				}
+				o[3] = 255;
+			}
+		}
+	}
+	}
+	Com_Dealloc(ids);
+	Com_Dealloc(parent);
+	Com_Dealloc(src);
+	*width  = ow;
+	*height = oh;
+	return out;
+}
+
+#endif
diff --git a/reference/etlegacy/src/renderercommon/tcp_wind.h b/reference/etlegacy/src/renderercommon/tcp_wind.h
new file mode 100644
index 0000000..14e024a
--- /dev/null
+++ b/reference/etlegacy/src/renderercommon/tcp_wind.h
@@ -0,0 +1,112 @@
+/*
+ * TrueCombat: Platinum - wind on foliage and cloth (0.39.0).
+ *
+ * Tree branches, bushes, plants, ground grass and canvas tarps get a gentle sway from the same two vertex deforms
+ * map shaders have always been able to use ("deformVertexes wave" for a flutter along the normal, varied across the
+ * surface, and "deformVertexes move" for a slow drift with the wind). Shaders that already deform are left alone,
+ * as are trunks, the sky and 2D shaders. The movement is at most about 1.5 units, far smaller than a player, so it
+ * never reads as movement at the edge of the screen. r_windSway 0 turns it off (latched: vid_restart).
+ * Both renderers include this header from tr_shader.c (FinishShader).
+ */
+#ifndef TCP_WIND_H
+#define TCP_WIND_H
+
+static cvar_t *r_windSway;
+
+static int TCP_WindKind(const char *name)
+{
+	static const char *skip[]   = { "trunk", "stump", "log", "pot", "cabinet", "metal", "decal", "street", "road", "wall", "floor", NULL };
+	static const char *canopy[] = { "branch", "leaves", "leaf", "_fill", "radial", "bush", "plant", "palm", "fern", "hedge", "ivy",
+		                            "autospr", "tree2", "tree_oak", NULL };
+	static const char *grass[]  = { "grassfoliage", "sedimentfoliage", "grass_dry", "grass_mixed", NULL };
+	char lower[MAX_QPATH];
+	int  i;
+
+	Q_strncpyz(lower, name, sizeof(lower));
+	Q_strlwr(lower);
+	for (i = 0; skip[i]; i++)
+	{
+		if (strstr(lower, skip[i]))
+		{
+			return 0;
+		}
+	}
+	if (!Q_stricmpn(lower, "textures/liq/canvas", 19))
+	{
+		return 3; /* tarp */
+	}
+	for (i = 0; grass[i]; i++)
+	{
+		if (strstr(lower, grass[i]))
+		{
+			return 2;
+		}
+	}
+	/* canopy: model foliage, plus the two tree sprites in textures/ */
+	if (Q_stricmpn(lower, "models/", 7) && Q_stricmpn(lower, "textures/tree", 13))
+	{
+		return 0;
+	}
+	for (i = 0; canopy[i]; i++)
+	{
+		if (strstr(lower, canopy[i]))
+		{
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void TCP_WindAddWave(shader_t *sh, deform_t type, float amplitude, float frequency, float spread, float mx, float my)
+{
+	deformStage_t *ds;
+
+	if (sh->numDeforms >= MAX_SHADER_DEFORMS)
+	{
+		return;
+	}
+	ds = &sh->deforms[sh->numDeforms++];
+	Com_Memset(ds, 0, sizeof(*ds));
+	ds->deformation                 = type;
+	ds->deformationWave.func        = GF_SIN;
+	ds->deformationWave.base        = 0.0f;
+	ds->deformationWave.amplitude   = amplitude;
+	ds->deformationWave.phase       = 0.0f;
+	ds->deformationWave.frequency   = frequency;
+	ds->deformationSpread           = spread;
+	ds->moveVector[0]               = mx;
+	ds->moveVector[1]               = my;
+	ds->moveVector[2]               = 0.0f;
+}
+
+static void TCP_WindSway(shader_t *sh)
+{
+	int kind;
+
+	if (!r_windSway)
+	{
+		r_windSway = ri.Cvar_Get("r_windSway", "1", CVAR_ARCHIVE | CVAR_LATCH);
+	}
+	if (!r_windSway->integer || sh->isSky || sh->numDeforms || sh->lightmapIndex == LIGHTMAP_2D)
+	{
+		return;
+	}
+	kind = TCP_WindKind(sh->name);
+	if (kind == 1)
+	{
+		/* canopy: leaf flutter (spread 1/96: neighbouring leaves out of step) and a slow drift of the crown */
+		TCP_WindAddWave(sh, DEFORM_WAVE, 0.55f, 0.55f, 1.0f / 96.0f, 0, 0);
+		TCP_WindAddWave(sh, DEFORM_MOVE, 1.0f, 0.16f, 0, 0.8f, 0.6f);
+	}
+	else if (kind == 2)
+	{
+		TCP_WindAddWave(sh, DEFORM_WAVE, 0.35f, 0.7f, 1.0f / 64.0f, 0, 0);
+	}
+	else if (kind == 3)
+	{
+		/* tarp: a slow billow along the normal */
+		TCP_WindAddWave(sh, DEFORM_WAVE, 0.9f, 0.3f, 1.0f / 160.0f, 0, 0);
+	}
+}
+
+#endif
