@@ -0,0 +1,28 @@
+/* GPL-3.0-or-later. 0.39.0 graphics immersion: smoke lit by flashes (cgame). Included by tcp_cgame.c before
+ * tcp_viewfx.h, so the weapon media (muzzle flashes), the blast code and the M83 smoke can all use it.
+ *
+ * A pulse is a short burst of light at a point: an explosion (0.9 s, 420 u) or a muzzle flash (70 ms, 90 u). Smoke
+ * and dust sprites add the pulses near them to their own light-grid colour, so a grenade going off inside smoke
+ * lights the cloud from within. Muzzle flashes only light smoke right at the muzzle and are off on Ranked and in
+ * clan matches (serverinfo tcp_rk): a glowing cloud must never give a shooter away where it did not before. */
+#define GP_PULSES 24
+typedef struct {vec3_t at;float radius,rgb[3];int start,life;} gpPulse_t;
+static gpPulse_t gpPulses[GP_PULSES];
+static int gpNow,gpRanked;
+static void gpAdd(const vec3_t at,float radius,float r,float g,float b,int life,int muzzle){
+    if(muzzle&&gpRanked)return;
+    gpPulse_t *slot=&gpPulses[0];
+    for(int i=0;i<GP_PULSES;i++){gpPulse_t *q=&gpPulses[i];
+        if(!q->start||gpNow-q->start>=q->life||gpNow<q->start){slot=q;break;}
+        if(q->start<slot->start)slot=q;}
+    VectorCopy(at,slot->at);slot->radius=radius;slot->rgb[0]=r;slot->rgb[1]=g;slot->rgb[2]=b;slot->start=gpNow?gpNow:1;slot->life=life>1?life:1;
+}
+/* adds the light of the live pulses near `at` to rgb (0..1 light-grid scale) */
+static void gpLight(const vec3_t at,float *rgb){
+    for(int i=0;i<GP_PULSES;i++){const gpPulse_t *q=&gpPulses[i];
+        if(!q->start)continue;const int age=gpNow-q->start;if(age<0||age>=q->life)continue;
+        vec3_t d;VectorSubtract(at,q->at,d);const float dd=DotProduct(d,d);if(dd>=q->radius*q->radius)continue;
+        const float f=1.f-sqrtf(dd)/q->radius,k=f*f*(1.f-(float)age/(float)q->life);
+        for(int c=0;c<3;c++)rgb[c]+=q->rgb[c]*k*1.6f;}
+}
+static void gpRoundWipe(void){memset(gpPulses,0,sizeof(gpPulses));}
