 static void brStamp(char *out,size_t size){qtime_t t;memset(&t,0,sizeof(t));SystemCall(CG_REAL_TIME,&t);
     snprintf(out,size,"%04d%02d%02d-%02d%02d%02d",t.tm_year+1900,t.tm_mon+1,t.tm_mday,t.tm_hour,t.tm_min,t.tm_sec);}
+/* audit-06: the report screenshot must fit the 1 MB the upload takes (BU_SHOT_MAX; the receiving side has the same
+ * limit). The engine writes screenshots at r_screenshotJpegQuality (default 90): about 0.3-0.45 bytes a pixel, so
+ * anything from 1080p up could be over the limit and 1440p and 4K nearly always were ("screenshot kept locally: too
+ * large"). The report shot is now written at a quality picked from the pixel count (worst scenes measured, 25%
+ * headroom); the player's own setting comes back half a second later, on the real clock, and at shutdown. */
+static char brShotQSaved[16];static int brShotQRestoreAt,brShotQFrames;
+static int brShotQuality(void){
+    const float mp=(float)gl.vidWidth*(float)gl.vidHeight/1000000.f;
+    return mp<=1.6f?90:mp<=3.0f?75:mp<=3.8f?60:mp<=4.6f?50:mp<=5.5f?40:mp<=6.7f?30:mp<=7.6f?25:mp<=9.0f?20:mp<=11.3f?15:10;
+}
+static void brShotQualityRestore(int force){
+    if(!brShotQRestoreAt)return;
+    if(!force&&(++brShotQFrames<4||(int)SystemCall(CG_MILLISECONDS)-brShotQRestoreAt<0))return; /* the shot is written a frame or two after the command */
+    brShotQRestoreAt=0;SystemCall(CG_CVAR_SET,"r_screenshotJpegQuality",brShotQSaved[0]?brShotQSaved:"90");
+}
+static void brShotQualitySet(void){
+    if(!brShotQRestoreAt){SystemCall(CG_CVAR_VARIABLESTRINGBUFFER,"r_screenshotJpegQuality",brShotQSaved,sizeof(brShotQSaved));}
+    char q[8];snprintf(q,sizeof(q),"%d",brShotQuality());SystemCall(CG_CVAR_SET,"r_screenshotJpegQuality",q);
+    brShotQRestoreAt=(int)SystemCall(CG_MILLISECONDS)+500;if(!brShotQRestoreAt)brShotQRestoreAt=1;brShotQFrames=0;
+}
