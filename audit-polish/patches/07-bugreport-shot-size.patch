     char stamp[32];brStamp(stamp,sizeof(stamp));snprintf(br.shot,sizeof(br.shot),"bugreport-%s",stamp);
+    brShotQualitySet(); /* audit-06 */
     char cmd[96];snprintf(cmd,sizeof(cmd),"screenshotJPEG %s\n",br.shot);SystemCall(CG_SENDCONSOLECOMMAND,cmd); /* before the box is drawn */
     br.shotAt=hudNow;br.open=1;SystemCall(CG_KEY_SETCATCHER,(int)SystemCall(CG_KEY_GETCATCHER)|KEYCATCH_CGAME);
     SystemCall(CG_PRINT,"TCP_NATIVE_BUGREPORT open\n");
