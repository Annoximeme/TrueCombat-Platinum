+/*
+ * 0.40.0 doorways. A sound with a wall between it and the listener reaches them the way real sound does:
+ * through the nearest opening. 16 candidate points on two rings around the listener (and two around the
+ * source) are tested for a clear leg to the listener and a clear leg to the source; the shortest detour
+ * wins. The sound is then heard from the opening's direction at the length of the detour (so it is also a
+ * little quieter), and muffled far less than through the wall: a fight in the next room comes in through
+ * its door, not through the bricks. Searched at the start of a loud sound and every 250 ms while it plays
+ * and stays blocked; 4 searches a frame at most.
+ */
+static qboolean TCP_PortalLeg(const vec3_t a, const vec3_t b)
+{
+	trace_t tr;
+
+	TCP_SpatialTrace(&tr, a, b);
+	return !tr.startsolid && (tr.fraction >= 1.0f || tr.fraction * Distance(a, b) > Distance(a, b) - 12.0f);
+}
+
+static qboolean TCP_PortalFind(const vec3_t pos, vec3_t at, float *len)
+{
+	static const float ring[8][2] = { { 1, 0 }, { 0.707f, 0.707f }, { 0, 1 }, { -0.707f, 0.707f }, { -1, 0 }, { -0.707f, -0.707f }, { 0, -1 }, { 0.707f, -0.707f } };
+	const float        dist       = Distance(pos, lastListenerOrigin);
+	float              best       = dist * 2.2f;      // a longer detour than this loses to the sound through the wall
+	int                r, k;
+	qboolean           found = qfalse;
+
+	tcpPortalSearches++;
+	for (r = 0; r < 4; r++)
+	{
+		// rings: around the listener at 35 % and 70 % of the distance, around the source at 35 %, and close to the source
+		const float *c      = r < 2 ? lastListenerOrigin : pos;
+		float       radius  = dist * (r == 0 ? 0.35f : r == 1 ? 0.7f : r == 2 ? 0.35f : 0.15f);
+
+		radius = radius < 48.0f ? 48.0f : (radius > 1024.0f ? 1024.0f : radius);
+		for (k = 0; k < 8; k++)
+		{
+			vec3_t p;
+			float  l;
+
+			p[0] = c[0] + ring[k][0] * radius;
+			p[1] = c[1] + ring[k][1] * radius;
+			p[2] = (lastListenerOrigin[2] + pos[2]) * 0.5f + 16.0f;
+			l    = Distance(lastListenerOrigin, p) + Distance(p, pos);
+			if (l >= best)
+			{
+				continue;   // cheaper than the two traces
+			}
+			if (TCP_PortalLeg(lastListenerOrigin, p) && TCP_PortalLeg(p, pos))
+			{
+				best  = l;
+				found = qtrue;
+				VectorCopy(p, at);
+			}
+		}
+	}
+	if (found)
+	{
+		*len = best;
+		tcpPortalFound++;
+	}
+	return found;
+}
+
+/**
+ * @brief Search (when due) and return the occlusion through the opening, or -1 without one.
+ */
+static float TCP_PortalOcclusion(int i, const vec3_t pos, int now, qboolean force)
+{
+	tcpSrcSpatial_t *sp   = &tcpSpatial[i];
+	const float      dist = Distance(pos, lastListenerOrigin);
+	float            detour;
+	static int       frame, frameSearches;
+
+	if (!s_alPortals->integer || !TCP_Remastered() || !TCP_SpatialWorld() || srcList[i].ui)
+	{
+		sp->portal = qfalse;
+		return -1.0f;
+	}
+	if (force || now >= sp->nextPortal)
+	{
+		if (frame != now)
+		{
+			frame         = now;
+			frameSearches = 0;
+		}
+		if (force || frameSearches < 4)
+		{
+			frameSearches++;
+			sp->nextPortal = now + 250 + (i & 7) * 8;
+			sp->portal     = TCP_PortalFind(pos, sp->portalAt, &sp->portalLen);
+		}
+	}
+	if (!sp->portal || dist < 1.0f)
+	{
+		return -1.0f;
+	}
+	// a straight-through opening barely muffles; a dog-leg around corners muffles more
+	detour = (sp->portalLen / dist - 1.0f) / 1.2f;
+	detour = detour < 0.0f ? 0.0f : (detour > 1.0f ? 1.0f : detour);
+	return (0.15f + 0.45f * detour) * s_alOcclusion->value;
+}
+
+/**
+ * @brief Where the source is heard from: its own position, or the opening's direction at the detour's length.
+ * Smoothed (~120 ms) so a sound does not jump when the opening changes. Written every frame after
+ * S_AL_SrcUpdate, which writes the true position.
+ */
+static void TCP_PortalPlace(int i, const vec3_t pos, int dt)
+{
+	tcpSrcSpatial_t *sp = &tcpSpatial[i];
+	vec3_t           target, d;
+	float            k;
+
+	if (sp->portal && sp->occTarget > 0.0f)
+	{
+		VectorSubtract(sp->portalAt, lastListenerOrigin, d);
+		VectorNormalize(d);
+		VectorMA(lastListenerOrigin, sp->portalLen, d, target);
+	}
+	else if (sp->moved)
+	{
+		VectorCopy(pos, target);
+	}
+	else
+	{
+		return;
+	}
+	if (!sp->moved)
+	{
+		VectorCopy(pos, sp->heard);     // first time: glide from the true position
+	}
+	k = dt / 120.0f;
+	k = k > 1.0f ? 1.0f : (k < 0.0f ? 0.0f : k);
+	sp->heard[0] += (target[0] - sp->heard[0]) * k;
+	sp->heard[1] += (target[1] - sp->heard[1]) * k;
+	sp->heard[2] += (target[2] - sp->heard[2]) * k;
+	qalSourcefv(srcList[i].alSource, AL_POSITION, sp->heard);
+	sp->moved = !(sp->portal == qfalse && Distance(sp->heard, pos) < 4.0f);
+	if (sp->portal)
+	{
+		tcpPortalActive++;
+	}
+}
