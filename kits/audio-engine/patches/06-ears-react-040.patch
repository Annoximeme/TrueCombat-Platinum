 /* One shot. local: the listener's own weapon (non-positional, as before). */
+/* 0.40.0 ears react (Remastered, cl_remaster): an unsuppressed shot fired right beside the listener (under 160 u)
+ * dulls their hearing for a moment and leaves a faint ring: strength by calibre (pistol .35, SMG .4, rifle .5,
+ * sniper/shotgun .6) and closeness, recovery over 1 to 3 s. It feeds the same engine muffle as a blast
+ * (s_alConcussion, drawStun) but at most .45 deep (a blast reaches 1), so footsteps are never hidden longer than a
+ * real ear would hide them. Own shots do not count (they would never let go in a firefight). cg_concussionMuffle 0
+ * turns it off with the blast muffle. */
+static float taEarsPeak;static int taEarsStart,taEarsLen,taEarsClock; /* clock = snap.serverTime, set each frame by drawStun */
+static int taRemastered(void){char v[8]="";SystemCall(CG_CVAR_VARIABLESTRINGBUFFER,"cl_remaster",v,sizeof(v));return !v[0]||atoi(v)!=0;}
+static void taEarsShot(int weapon,float dist,int suppressed,int now){
+    if(suppressed||dist>=160.f||!taRemastered())return;
+    const tcp_gear_weapon *g=TCP_GearWeapon(weapon);if(!g)return;
+    float s=TCP_WeaponShotgun(weapon)||g->category==5?.6f:g->category==4?.5f:g->category==3?.4f:.35f;
+    s*=1.f-dist/160.f*.6f; /* at 160 u: 40 % */
+    const float cur=taEarsPeak*(taEarsLen>0&&now-taEarsStart<taEarsLen?1.f-(float)(now-taEarsStart)/(float)taEarsLen:0.f);
+    if(s<=cur)return;
+    taEarsPeak=s;taEarsStart=now;taEarsLen=1000+(int)(2000.f*(s/.6f)); /* 1 .. 3 s */
+}
+/* 0..0.45 muffle now (ease-out recovery). */
+static float taEarsNow(int now){
+    if(taEarsLen<=0||now-taEarsStart>=taEarsLen||now<taEarsStart)return 0.f;
+    const float t=1.f-(float)(now-taEarsStart)/(float)taEarsLen;return .45f/.6f*taEarsPeak*t*t;
+}
 static void taFire(int weapon,int shooter,const vec3_t muzzle,const vec3_t listener,int local,int seq,sfxHandle_t fallback){
     const taWeapon_t *w=taGetWeapon(weapon);
     sfxHandle_t fire=w&&w->fireCount?w->fire[(unsigned)(seq*2654435761u>>16)%(unsigned)w->fireCount]:fallback;
@@ -183,6 +205,7 @@
         if(taDebug.integer){char m[96];snprintf(m,sizeof(m),"TCP_NATIVE_OWN_FIRE weapon=%d sfx=%d fallback=%d\n",weapon,(int)fire,fire==fallback);SystemCall(CG_PRINT,m);} /* 0.36.0: which report an own shot played (cg_audioDebug) */
         return;}
     if(fire){vec3_t at;VectorCopy(muzzle,at);SystemCall(CG_S_STARTSOUNDEX,at,shooter,CHAN_WEAPON,fire,SND_PITCHVAR,127);}
+    taEarsShot(weapon,taDist(muzzle,listener),w&&w->suppressed,taEarsClock); /* 0.40.0 ears react */
     if(!w||!w->echoCount)return;
     vec3_t dir;VectorSubtract(muzzle,listener,dir);const float dist=taDist(muzzle,listener);if(dist>0)VectorScale(dir,1.f/dist,dir);
     if(dist<=512||dist>=(taOpenAL?6000:4096))return;
