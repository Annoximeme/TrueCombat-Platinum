+/*
+ * 0.40.0 loudness-priority mix. The loudest fresh event (your own shot, a close burst or blast) opens a short
+ * window: other gunfire, impacts, debris and casings that are more than 12 dB under it step back by up to
+ * 4 dB (30 ms down, 300 ms back), so every shot keeps its punch in a busy fight without a louder master.
+ * Never touched: footsteps, near-miss snaps, the tinnitus tone, voice, music, menus, ambience loops (those
+ * already duck), and your own sounds. The same rule for every player; s_alMixPriority 0 or Classic turns it off.
+ */
+static float TCP_Perceived(int i)
+{
+	const src_t *s = &srcList[i];
+	float       g  = s->scaleGain;
+	vec3_t      pos;
+
+	if (tcpEfx && tcpSpatial[i].attached)
+	{
+		g *= tcpSpatial[i].gain;
+	}
+	if (s->local)
+	{
+		return g;
+	}
+	if (TCP_SpatialOrigin(s, pos))
+	{
+		// OpenAL inverse distance clamped, as the sources are set up (reference distance s_alMinDistance)
+		const float ref = s_alMinDistance->value > 1.0f ? s_alMinDistance->value : 1.0f;
+		const float d   = Distance(pos, lastListenerOrigin);
+
+		if (d > ref)
+		{
+			g *= ref / (ref + s_alRolloff->value * (d - ref));
+		}
+	}
+	return g;
+}
+
+static void TCP_MixPriority(int now, int dt)
+{
+	float loud = 0.0f, k;
+	int   i;
+
+	tcpMixDucked = 0;
+	for (i = 0; i < srcCount; i++)
+	{
+		const src_t *s = &srcList[i];
+		int         cls;
+
+		if (!s->isActive || !s->isPlaying || s->isLooping || s->sfx < 0 || s->sfx >= numSfx || now - s->lastUsedTime > 150)
+		{
+			continue;
+		}
+		cls = knownSfx[s->sfx].tcpClass;
+		if (cls == TCPC_GUNFIRE || cls == TCPC_BLAST)
+		{
+			const float p = TCP_Perceived(i) * (cls == TCPC_BLAST ? 2.0f : 1.0f);
+
+			loud = p > loud ? p : loud;
+		}
+	}
+	// hold the loudest, ~350 ms fall
+	k           = dt / 350.0f;
+	tcpLoudPeak = loud > tcpLoudPeak ? loud : tcpLoudPeak * (1.0f - (k > 1.0f ? 1.0f : k));
+	for (i = 0; i < srcCount; i++)
+	{
+		src_t *s = &srcList[i];
+		int   cls;
+		float target = 1.0f, old = tcpMixGain[i] > 0.0f ? tcpMixGain[i] : 1.0f, now_g;
+
+		if (!s->isActive || !s->isPlaying || s->sfx < 0 || s->sfx >= numSfx)
+		{
+			continue;
+		}
+		cls = knownSfx[s->sfx].tcpClass;
+		if (s_alMixPriority->integer && TCP_Remastered() && tcpLoudPeak > 0.02f && !s->local && !s->ui && !s->isLooping
+		    && (cls == TCPC_GUNFIRE || cls == TCPC_IMPACT || cls == TCPC_DEBRIS || cls == TCPC_CASING || cls == TCPC_OTHER))
+		{
+			const float r = TCP_Perceived(i) / old / tcpLoudPeak;    // its own level without the mix gain
+
+			if (r < 0.25f)
+			{
+				const float depth = (0.25f - r) / 0.25f;
+
+				target = powf(10.0f, -4.0f * (depth > 1.0f ? 1.0f : depth) / 20.0f);
+				tcpMixDucked++;
+			}
+		}
+		k     = dt / (target < old ? 30.0f : 300.0f);
+		now_g = old + (target - old) * (k > 1.0f ? 1.0f : (k < 0.0f ? 0.0f : k));
+		if (fabsf(now_g - old) > 0.005f || (target == 1.0f && old != 1.0f && fabsf(now_g - 1.0f) < 0.005f))
+		{
+			if (target == 1.0f && fabsf(now_g - 1.0f) < 0.005f)
+			{
+				now_g = 1.0f;
+			}
+			tcpMixGain[i] = now_g;
+			s->scaleGain  = s->scaleGain / old * now_g;
+			S_AL_Gain(s->alSource, s->scaleGain);
+		}
+	}
+}
