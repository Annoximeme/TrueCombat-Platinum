+static qboolean tcpEfx;    // defined with the spatial audio below
+static void     TCP_SpatialTrace(trace_t *tr, const vec3_t start, const vec3_t end);
+static qboolean TCP_SpatialWorld(void);
+/*
+ * 0.40.0 timing and wall slaps. Travel delay applies to every player (Classic too, cheat-protected cvar) so
+ * nobody hears a shot earlier than anyone else; wall slaps are Remastered only.
+ * - Travel delay: gunfire and blasts more than 400 units away start after distance / speed of sound
+ *   (13504 units/s, 1 unit = 1 inch): about 0.3 s per 100 m. The supersonic crack the cgame plays when a
+ *   bullet passes the listener therefore lands before the report, as at a real range.
+ * - Wall slaps: the walls around the listener (7 traces, within 40 m, refreshed every 150 ms) throw back up to
+ *   two short copies of each gunshot or blast, from the wall, delayed by the extra path, at least 10 dB under
+ *   the direct sound and further down with the extra distance. One set per shooter per 90 ms and six slaps
+ *   per 100 ms at most, so full auto stays clean. Own shots slap too.
+ * Queued in tcpDelayQ and started from TCP_DelayFrame (S_AL_Update); a queued sound skips both again.
+ */
+#define TCP_SND_DELAYED BIT(30)
+#define TCP_SND_SLAP    BIT(29)
+#define TCP_DELAY_Q     96
+#define TCP_UNITS_PER_S 13504.0f
+typedef struct
+{
+	int at;             // Sys_Milliseconds to start
+	qboolean hasOrigin;
+	vec3_t origin;
+	int entnum, entchannel, flags, volume;
+	sfxHandle_t sfx;
+} tcpDelayed_t;
+static tcpDelayed_t tcpDelayQ[TCP_DELAY_Q];
+static int          tcpDelayCount, tcpDelayQueued, tcpDelayDropped, tcpSlapsPlayed;
+static vec3_t       tcpWallAt[7];
+static float        tcpWallDist[7];
+static int          tcpWallNext, tcpSlapShooter[MAX_GENTITIES + 1], tcpSlapWindow, tcpSlapWindowCount;
+static void S_AL_StartSoundEx(vec3_t origin, int entnum, int entchannel, sfxHandle_t sfx, int flags, int volume);
+static qboolean TCP_Remastered(void);
+
+static int TCP_SfxClassOf(sfxHandle_t sfx)
+{
+	return (sfx >= 0 && sfx < numSfx) ? knownSfx[sfx].tcpClass : TCPC_OTHER;
+}
+
+static qboolean TCP_DelayPush(int at, const vec3_t origin, int entnum, int entchannel, sfxHandle_t sfx, int flags, int volume)
+{
+	tcpDelayed_t *d;
+
+	if (tcpDelayCount >= TCP_DELAY_Q)
+	{
+		tcpDelayDropped++;
+		return qfalse;
+	}
+	d             = &tcpDelayQ[tcpDelayCount++];
+	d->at         = at;
+	d->hasOrigin  = origin != NULL;
+	if (origin)
+	{
+		VectorCopy(origin, d->origin);
+	}
+	d->entnum     = entnum;
+	d->entchannel = entchannel;
+	d->sfx        = sfx;
+	d->flags      = flags | TCP_SND_DELAYED;
+	d->volume     = volume;
+	tcpDelayQueued++;
+	return qtrue;
+}
+
+/**
+ * @brief Start every queued sound that is due. Order inside the queue does not matter.
+ */
+static void TCP_DelayFrame(void)
+{
+	const int now = Sys_Milliseconds();
+	int       i;
+
+	for (i = 0; i < tcpDelayCount; )
+	{
+		if (now - tcpDelayQ[i].at >= 0)
+		{
+			tcpDelayed_t d = tcpDelayQ[i];
+
+			tcpDelayQ[i] = tcpDelayQ[--tcpDelayCount];
+			if (d.entnum < 0 || d.entnum >= MAX_GENTITIES)
+			{
+				continue;
+			}
+			S_AL_StartSoundEx(d.hasOrigin ? d.origin : NULL, d.entnum, d.entchannel, d.sfx, d.flags, d.volume);
+			continue;
+		}
+		i++;
+	}
+}
+
+static float TCP_Attenuation(float d)
+{
+	const float ref = s_alMinDistance->value > 1.0f ? s_alMinDistance->value : 1.0f;
+
+	return d > ref ? ref / (ref + s_alRolloff->value * (d - ref)) : 1.0f;
+}
+
+/**
+ * @brief Walls around the listener: 6 horizontal directions and up, within 40 m (1575 units).
+ */
+static void TCP_WallProbe(int now)
+{
+	static const float dirs[7][3] = { { 1, 0, 0 }, { 0.5f, 0.866f, 0 }, { -0.5f, 0.866f, 0 }, { -1, 0, 0 }, { -0.5f, -0.866f, 0 }, { 0.5f, -0.866f, 0 }, { 0, 0, 1 } };
+	int                k;
+
+	if (now - tcpWallNext < 0)
+	{
+		return;
+	}
+	tcpWallNext = now + 150;
+	for (k = 0; k < 7; k++)
+	{
+		trace_t tr;
+		vec3_t  end;
+
+		VectorMA(lastListenerOrigin, 1575.0f, dirs[k], end);
+		TCP_SpatialTrace(&tr, lastListenerOrigin, end);
+		if (tr.startsolid || tr.fraction >= 1.0f || (tr.surfaceFlags & SURF_SKY) || tr.fraction * 1575.0f < 24.0f)
+		{
+			tcpWallDist[k] = -1.0f;
+			continue;
+		}
+		tcpWallDist[k] = tr.fraction * 1575.0f;
+		VectorMA(lastListenerOrigin, tcpWallDist[k] - 12.0f, dirs[k], tcpWallAt[k]);   // just off the wall, on our side
+	}
+}
+
+/**
+ * @brief Queue up to two wall slaps of a gunshot from src (the listener's own position for own shots).
+ * baseDelay = when the direct sound arrives (ms from now).
+ */
+static void TCP_Slaps(const vec3_t src, int shooter, sfxHandle_t sfx, int flags, int volume, int baseDelay)
+{
+	const int now    = Sys_Milliseconds();
+	const float dir  = Distance(src, lastListenerOrigin);
+	const float aDir = TCP_Attenuation(dir);
+	int       k, pick[2] = { -1, -1 };
+	float     g[7], best[2] = { 0.0f, 0.0f };
+
+	if (!s_alWallSlaps->integer || !TCP_SpatialWorld() || dir > 1575.0f * 2.0f)
+	{
+		return;
+	}
+	if (shooter >= 0 && shooter <= MAX_GENTITIES && tcpSlapShooter[shooter] && now - tcpSlapShooter[shooter] < 90)
+	{
+		return;
+	}
+	if (now - tcpSlapWindow >= 100)
+	{
+		tcpSlapWindow      = now;
+		tcpSlapWindowCount = 0;
+	}
+	if (tcpSlapWindowCount >= 6)
+	{
+		return;
+	}
+	TCP_WallProbe(now);
+	for (k = 0; k < 7; k++)
+	{
+		float path;
+
+		g[k] = 0.0f;
+		if (tcpWallDist[k] < 0.0f)
+		{
+			continue;
+		}
+		path = Distance(src, tcpWallAt[k]) + tcpWallDist[k];
+		if ((path - dir) < TCP_UNITS_PER_S * 0.008f)
+		{
+			continue;   // under 8 ms: fuses with the direct sound, adds nothing
+		}
+		// the reflection travels the longer path; OpenAL will attenuate it over the wall's short distance only
+		g[k] = 0.32f * (TCP_Attenuation(path) / (aDir > 0.0f ? aDir : 1.0f)) * aDir / TCP_Attenuation(tcpWallDist[k]);
+		if (g[k] > best[0])
+		{
+			best[1] = best[0];
+			pick[1] = pick[0];
+			best[0] = g[k];
+			pick[0] = k;
+		}
+		else if (g[k] > best[1])
+		{
+			best[1] = g[k];
+			pick[1] = k;
+		}
+	}
+	if (shooter >= 0 && shooter <= MAX_GENTITIES)
+	{
+		tcpSlapShooter[shooter] = now;
+	}
+	for (k = 0; k < 2; k++)
+	{
+		int   w = pick[k], vol;
+		float path;
+
+		if (w < 0 || best[k] < 0.02f)
+		{
+			continue;
+		}
+		if (dir > 32.0f)
+		{
+			// a remote shot only slaps off a wall it can reach
+			trace_t tr;
+
+			TCP_SpatialTrace(&tr, src, tcpWallAt[w]);
+			if (tr.startsolid || tr.fraction < 0.97f)
+			{
+				continue;
+			}
+		}
+		path = Distance(src, tcpWallAt[w]) + tcpWallDist[w];
+		vol  = (int)(volume * (best[k] > 0.32f ? 0.32f : best[k]));
+		if (vol < 2)
+		{
+			continue;
+		}
+		if (TCP_DelayPush(now + baseDelay + (int)((path - dir) / TCP_UNITS_PER_S * 1000.0f), tcpWallAt[w], ENTITYNUM_WORLD, CHAN_AUTO, sfx,
+		                  (flags & ~(SND_LISTENER | SND_LONGRANGE)) | TCP_SND_SLAP, vol))
+		{
+			tcpSlapsPlayed++;
+			tcpSlapWindowCount++;
+		}
+	}
+}
+
+/**
+ * @brief Gunfire or blast that should arrive late and/or slap: queue it. qtrue = queued, do not start now.
+ */
+static qboolean TCP_TimingStart(vec3_t origin, const vec3_t sorigin, int entnum, int entchannel, sfxHandle_t sfx, int flags, int volume)
+{
+	const int cls = TCP_SfxClassOf(sfx);
+	float     dist;
+	int       delay = 0;
+
+	if ((flags & TCP_SND_DELAYED) || (cls != TCPC_GUNFIRE && cls != TCPC_BLAST))
+	{
+		return qfalse;
+	}
+	dist = Distance(sorigin, lastListenerOrigin);
+	// the delay is the same for every player, Classic included, so nobody hears a shot earlier than anyone else
+	if (s_alTravelDelay->integer && dist > 400.0f)
+	{
+		delay = (int)(dist / TCP_UNITS_PER_S * 1000.0f);
+	}
+	if (tcpEfx && TCP_Remastered())
+	{
+		TCP_Slaps(sorigin, entnum, sfx, flags, volume, delay);
+	}
+	if (delay > 0)
+	{
+		return TCP_DelayPush(Sys_Milliseconds() + delay, origin, entnum, entchannel, sfx, flags, volume);
+	}
+	return qfalse;
+}
