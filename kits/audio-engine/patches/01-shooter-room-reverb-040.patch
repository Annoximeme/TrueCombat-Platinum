+/*
+ * 0.40.0 shooter's room. A gunshot or blast more than TCP_ZONE_MIN units away rings in the room it was
+ * fired in, not only in the listener's: a rifle fired inside the warehouse booms out of it to a player in
+ * the street, a shot in the street stays dry to a player in the corridor. Each such source gets a third
+ * send into one of TCP_ZONES extra reverb slots tuned to its own room (14-ray probe at the source, cached
+ * per 128-unit cell). Its send into the listener's room drops to 40 %, and the shooter's-room send is
+ * muffled by the same walls as the dry sound, so a hall heard through a doorway blooms out muffled.
+ * A slot is only retuned once its last sound has rung out; until then the closest tuned slot is shared.
+ */
+#define TCP_ZONES      3
+#define TCP_ZONE_MIN   384.0f
+#define TCP_ZONE_CELLS 256
+typedef struct
+{
+	ALuint effect, slot;
+	tcpReverb_t r;
+	float roomOpen, roomSize;
+	int lastUse;        // Sys_Milliseconds of the last sound sent to it
+	qboolean tuned;
+} tcpZone_t;
+typedef struct
+{
+	int key, used;
+	float roomOpen, roomSize;
+	qboolean valid;
+} tcpZoneCell_t;
+static tcpZone_t     tcpZones[TCP_ZONES];
+static tcpZoneCell_t tcpZoneCells[TCP_ZONE_CELLS];
+static ALuint        tcpListenerSendFilter;      // the listener's-room send of a zoned source: 40 %
+static int           tcpZoneCount, tcpZoneAssigns, tcpZoneRetunes, tcpZoneShares, tcpZoneProbes, tcpZoneSkips;
+
+/**
+ * @brief 0.40.0: the new engine behaviour sits behind the Remastered option ("Visuals: Remastered / Classic",
+ * cl_remaster, registered by the remaster switch). Classic keeps the 0.39 engine sound. Unset = Remastered.
+ */
+static qboolean TCP_Remastered(void)
+{
+	const char *v = Cvar_VariableString("cl_remaster");
+
+	return !v[0] || atoi(v) != 0;
+}
+
+static float TCP_RoomDistance(float o1, float s1, float o2, float s2)
+{
+	const float ls = (float)fabs(log((s1 + 32.0f) / (s2 + 32.0f)));
+
+	return (float)fabs(o1 - o2) * 2.0f + ls;  // 0.5 openness ~ a 2.7x size difference
+}
+
+/**
+ * @brief The room at a point, from the cell cache or a fresh probe.
+ */
+static qboolean TCP_ZoneRoom(const vec3_t at, float *roomOpen, float *roomSize, int now)
+{
+	const int      cx = (int)floor(at[0] / 128.0f), cy = (int)floor(at[1] / 128.0f), cz = (int)floor(at[2] / 128.0f);
+	const int      key = (cx * 73856093) ^ (cy * 19349663) ^ (cz * 83492791);
+	tcpZoneCell_t *c   = &tcpZoneCells[(unsigned)key % TCP_ZONE_CELLS];
+	vec3_t         probe;
+
+	if (c->valid && c->key == key)
+	{
+		c->used   = now;
+		*roomOpen = c->roomOpen;
+		*roomSize = c->roomSize;
+		return qtrue;
+	}
+	VectorCopy(at, probe);
+	probe[2] += 8.0f;       // off the floor a muzzle or impact can sit on
+	tcpZoneProbes++;
+	if (!TCP_RoomProbe(probe, roomOpen, roomSize))
+	{
+		return qfalse;
+	}
+	c->key      = key;
+	c->used     = now;
+	c->roomOpen = *roomOpen;
+	c->roomSize = *roomSize;
+	c->valid    = qtrue;
+	return qtrue;
+}
+
+/**
+ * @brief Pick the shooter's-room slot for a source in this room: one already tuned close enough, else a
+ * free one retuned, else the closest. -1 when the listener's room is close enough already.
+ */
+static int TCP_ZonePick(float roomOpen, float roomSize, int now)
+{
+	tcpReverb_t r;
+	int         i, best = -1, freeSlot = -1;
+	float       bestD = 1e9f;
+
+	if (TCP_RoomDistance(roomOpen, roomSize, tcpRoomOpen, tcpRoomSize) < 0.35f)
+	{
+		return -1;      // same kind of space as the listener's: their room already sounds right
+	}
+	for (i = 0; i < tcpZoneCount; i++)
+	{
+		tcpZone_t   *z = &tcpZones[i];
+		const float d  = z->tuned ? TCP_RoomDistance(roomOpen, roomSize, z->roomOpen, z->roomSize) : 1e9f;
+
+		if (d < bestD)
+		{
+			bestD = d;
+			best  = i;
+		}
+		// rung out: a tail lasts its decay time, plus a margin for the last shots' own length
+		if (!z->tuned || now - z->lastUse > (int)(z->r.decay * 1000.0f) + 600)
+		{
+			if (freeSlot < 0 || tcpZones[freeSlot].lastUse > z->lastUse)
+			{
+				freeSlot = i;
+			}
+		}
+	}
+	if (best >= 0 && bestD < 0.35f)
+	{
+		return best;
+	}
+	if (freeSlot >= 0)
+	{
+		tcpZone_t *z = &tcpZones[freeSlot];
+
+		TCP_RoomParams(roomOpen, roomSize, &r);
+		z->r        = r;
+		z->roomOpen = roomOpen;
+		z->roomSize = roomSize;
+		z->tuned    = qtrue;
+		TCP_ReverbWrite(z->effect, z->slot, &z->r, s_alReverbGain->value);
+		tcpZoneRetunes++;
+		return freeSlot;
+	}
+	tcpZoneShares++;
+	return best;
+}
+
+/**
+ * @brief Source start: route loud distant world sounds into their own room. Clears the routing otherwise.
+ */
+static void TCP_ZoneStart(int i, const vec3_t pos)
+{
+	tcpSrcSpatial_t *sp  = &tcpSpatial[i];
+	src_t           *s   = &srcList[i];
+	const int        cls = (s->sfx >= 0 && s->sfx < numSfx) ? knownSfx[s->sfx].tcpClass : TCPC_OTHER;
+	const int        now = Sys_Milliseconds();
+	float            roomOpen, roomSize;
+	int              z;
+
+	if (!tcpZoneCount)
+	{
+		return;
+	}
+	if (sp->zone)
+	{
+		// a recycled source: clear the old routing
+		qalSource3i(s->alSource, AL_AUXILIARY_SEND_FILTER, AL_EFFECTSLOT_NULL, 2, AL_FILTER_NULL);
+		qalSource3i(s->alSource, AL_AUXILIARY_SEND_FILTER, (ALint)tcpReverbSlot, 1, AL_FILTER_NULL);
+		sp->zone = 0;
+	}
+	if (!s_alSourceReverb->integer || !s_alReverb->integer || !TCP_Remastered() || !tcpReverbSet || !TCP_SpatialWorld() || s->isLooping
+	    || (cls != TCPC_GUNFIRE && cls != TCPC_BLAST) || Distance(pos, lastListenerOrigin) < TCP_ZONE_MIN)
+	{
+		return;
+	}
+	if (!TCP_ZoneRoom(pos, &roomOpen, &roomSize, now))
+	{
+		tcpZoneSkips++;
+		return;
+	}
+	z = TCP_ZonePick(roomOpen, roomSize, now);
+	if (z < 0)
+	{
+		tcpZoneSkips++;
+		return;
+	}
+	tcpZones[z].lastUse = now;
+	sp->zone            = z + 1;
+	sp->zoneGain        = sp->zoneGainHF = -1.0f;    // written by TCP_SpatialApply
+	qalSource3i(s->alSource, AL_AUXILIARY_SEND_FILTER, (ALint)tcpReverbSlot, 1, (ALint)tcpListenerSendFilter);
+	qalSource3i(s->alSource, AL_AUXILIARY_SEND_FILTER, (ALint)tcpZones[z].slot, 2,
+	            sp->sendFilter ? (ALint)sp->sendFilter : AL_FILTER_NULL);
+	tcpZoneAssigns++;
+}
+
+/**
+ * @brief The shooter's-room send follows the dry path's wall muffling (a bit less: a big room's sound
+ * also leaks out through every opening) and air absorption.
+ */
+static void TCP_ZoneApply(int i, float air)
+{
+	tcpSrcSpatial_t *sp = &tcpSpatial[i];
+	float           gain, gainHF;
+
+	if (!sp->zone || !sp->sendFilter)
+	{
+		return;
+	}
+	gain   = 1.0f - 0.35f * sp->occ;
+	gainHF = (1.0f - 0.75f * sp->occ) * air;
+	if (gainHF < 0.05f)
+	{
+		gainHF = 0.05f;
+	}
+	if (fabsf(gain - sp->zoneGain) < 0.01f && fabsf(gainHF - sp->zoneGainHF) < 0.01f)
+	{
+		return;
+	}
+	sp->zoneGain   = gain;
+	sp->zoneGainHF = gainHF;
+	tcp_alFilterf(sp->sendFilter, AL_LOWPASS_GAIN, gain);
+	tcp_alFilterf(sp->sendFilter, AL_LOWPASS_GAINHF, gainHF);
+	// filter changes take hold when the filter is (re)attached to the send
+	qalSource3i(srcList[i].alSource, AL_AUXILIARY_SEND_FILTER, (ALint)tcpZones[sp->zone - 1].slot, 2, (ALint)sp->sendFilter);
+}
