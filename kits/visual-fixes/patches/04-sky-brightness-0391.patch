diff --git a/reference/etlegacy/src/renderer_dx12/dx12_core.cpp b/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
--- a/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
+++ b/reference/etlegacy/src/renderer_dx12/dx12_core.cpp
@@ -1352,6 +1352,18 @@
 	return LoadDepth(ClampRect(q)) >= 0.99999;
 }
 
+// 0.39.1: open sky as a fraction of a 5x5 px footprint. A single pixel flips with the anti-aliasing jitter on
+// wires, antennas and roof edges, which made the shafts and the glare flicker over the sky.
+float SkyCover(float2 q)
+{
+	float s = 0.0;
+	[unroll] for (int i = 0; i < 4; i++)
+	{
+		s += IsSky(int2(q + float2((i & 1) ? 2.0 : -2.0, (i & 2) ? 2.0 : -2.0))) ? 1.0 : 0.0;
+	}
+	return s * 0.25;
+}
+
 // Sun shafts: march towards the sun and count open sky (screen-space light scattering), plus a soft glare
 // around a visible sun disc. Display space, added like bloom; the caller caps the total.
 float3 SunLight(float2 pixel)
@@ -1371,24 +1383,24 @@
 		[unroll] for (int i = 0; i < 20; i++)
 		{
 			pos   += delta;
-			illum += (IsSky(int2(pos)) ? 1.0 : 0.0) * decay;
+			illum += SkyCover(pos) * decay;
 			total += decay;
 			decay *= 0.93;
 		}
 		// rays are the light that passed through gaps: the pixel itself being sky adds nothing new
-		float self = IsSky(int2(pixel)) ? 0.55 : 1.0;
+		float self = lerp(1.0, 0.55, SkyCover(pixel));
 		light += (illum / total) * self * saturate(1.0 - r / 1.4) * saturate(1.0 - r / 1.4) * x1.z;
 	}
 	if (x1.w > 0.0 && r < 0.6)
 	{
-		// how much of the disc is open sky (12 taps on a 1% ring)
-		float vis = 0.0;
+		// how much of the disc is open sky (0.39.1: 12 footprints on a 1.5% and a 3% ring, plus the centre)
+		float vis = SkyCover(x1.xy);
 		[unroll] for (int i = 0; i < 12; i++)
 		{
-			float a = i * 0.5235988;
-			vis += IsSky(int2(x1.xy + float2(cos(a), sin(a)) * h * 0.01)) ? 1.0 : 0.0;
+			float a = i * 0.5235988 + ((i & 1) ? 0.2617994 : 0.0);
+			vis += SkyCover(x1.xy + float2(cos(a), sin(a)) * h * ((i & 1) ? 0.03 : 0.015));
 		}
-		vis /= 12.0;
+		vis /= 13.0;
 		float q = r / 0.06, s = r / 0.25;
 		light += vis * (exp(-q * q) * 0.6 + exp(-s * s) * 0.25) * x1.w;
 	}
