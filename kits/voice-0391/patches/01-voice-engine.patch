 /**
+ * @brief CL_VoipUpdateMeter refreshes cl_voipMeter (Options > Voice) about ten times a second.
+ * The bar is the loudest frame since the last update on the decibel scale of CL_VoipGain;
+ * '|' marks the voice activation level.
+ */
+static void CL_VoipUpdateMeter(void)
+{
+	char text[64];
+	int  i, mark, fill;
+	float thr;
+
+	if (cls.realtime - voipMeterAt < 100 && cls.realtime >= voipMeterAt)
+	{
+		return;
+	}
+	voipMeterAt = cls.realtime;
+	if (voipMicFailed)
+	{
+		Q_strncpyz(text, "No microphone found", sizeof(text));
+	}
+	else if (!voipMic || cls.realtime - voipMeterHeardAt > 500)
+	{
+		Q_strncpyz(text, cl_voipMicTest->integer ? "Waiting for the microphone..." : "Microphone idle: start the mic test", sizeof(text));
+	}
+	else if (voipSilentFrames >= 150)
+	{
+		Q_strncpyz(text, "Silence only: muted or blocked by Windows", sizeof(text));
+	}
+	else
+	{
+		thr  = Com_Clamp(0.001f, 1.f, cl_voipVADThreshold->value);
+		mark = (int)((20.f * log10f(thr) + 60.f) * (24.f / 60.f));
+		mark = mark < 0 ? 0 : mark > 23 ? 23 : mark;
+		fill = (voipMeterLevel * 24 + 50) / 100;
+		text[0] = '[';
+		for (i = 0; i < 24; i++)
+		{
+			text[1 + i] = (cl_voipUseVAD->integer && i == mark) ? '|' : i < fill ? '#' : '.';
+		}
+		Com_sprintf(text + 25, sizeof(text) - 25, "] %d%%%s", voipMeterLevel,
+		            cl_voipUseVAD->integer ? (voipMeterLevel > mark * 100 / 24 ? "  sending" : "") : "");
+	}
+	voipMeterLevel = 0;
+	if (strcmp(cl_voipMeter->string, text))
+	{
+		Cvar_Set("cl_voipMeter", text);
+	}
+}
