diff --git a/game_src/tests/freeaim_deadzone_probe.c b/game_src/tests/freeaim_deadzone_probe.c
new file mode 100644
index 0000000..056a764
--- /dev/null
+++ b/game_src/tests/freeaim_deadzone_probe.c
@@ -0,0 +1,98 @@
+/* GPL-3.0-or-later. 0.39.3 free aim deadzone probe (test only): cg_freeAim 2/3. At the hip the mouse moves the
+ * weapon inside the box and the view turns only past its edge; the weapon's world direction (view + offset) is
+ * always exactly the mouse input, at every frame rate. Aiming down the sights eases the offset to the centre
+ * while the view turns by the same amount (the weapon keeps its world direction). Snapshot pack/unpack carries
+ * the mode and the offsets, so the client replay matches the server. Shots leave along view + offset.
+ * Build: -DMODLIB -I <etlegacy/src> with tcp_lagpredict.c, tcp_move.c and the combat sources. */
+#include "../native/tcp_lagpredict.h"
+#include "../native/tcp_native_combat.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#define CHECK(c,...) do{if(!(c)){printf("FAIL %s:%d ",__FILE__,__LINE__);printf(__VA_ARGS__);puts("");return 1;}}while(0)
+static unsigned rng=777;static int rnd(int lo,int hi){rng=rng*1103515245u+12345u;return lo+(int)((rng>>8)%(unsigned)(hi-lo+1));}
+static int s16(int v){return (int)(int16_t)(uint16_t)(v&0xffff);}
+/* One command as qagame runs it: input angles now (shorts), delta_angles, view from both. */
+typedef struct {tcp_aim_state a;int delta[2],prev[2],now[2];float view[3];} sim_t;
+static void simInit(sim_t *s){memset(s,0,sizeof(*s));}
+static void simStep(sim_t *s,int mode,int msec,int dp,int dy){
+    s->now[0]=s16(s->prev[0]+dp);s->now[1]=s16(s->prev[1]+dy);
+    for(int k=0;k<2;k++)s->view[k]=(float)s16(s->now[k]+s->delta[k])*(360.f/65536.f);
+    TCP_FreeAimFrame(&s->a,mode,msec,s->now,s->prev,&s->delta[0],&s->delta[1],s->view);
+    s->prev[0]=s->now[0];s->prev[1]=s->now[1];
+}
+static int viewShort(const sim_t *s,int k){return s16(s->now[k]+s->delta[k]);}
+int main(void){
+    const int boxP[4]={0,0,455,728},boxY[4]={0,0,728,1274};
+    /* 1. Hip: inside the box only the weapon moves; the weapon's world direction is the input, exactly. */
+    for(int mode=2;mode<=3;mode++){sim_t s;simInit(&s);
+        simStep(&s,mode,8,0,0);
+        simStep(&s,mode,8,100,-300);
+        CHECK(viewShort(&s,0)==0&&viewShort(&s,1)==0,"mode %d: view moved inside the box (%d,%d)",mode,viewShort(&s,0),viewShort(&s,1));
+        CHECK(s.a.free_pitch==100&&s.a.free_yaw==-300,"mode %d offsets %d %d",mode,s.a.free_pitch,s.a.free_yaw);
+        /* push past the edge: the gun stops at the edge, the view takes the rest */
+        simStep(&s,mode,8,0,-3000);
+        CHECK(s.a.free_yaw==-boxY[mode],"mode %d yaw edge %d",mode,s.a.free_yaw);
+        CHECK(viewShort(&s,1)==-3300+boxY[mode],"mode %d view yaw %d",mode,viewShort(&s,1));
+        CHECK(s.a.free_pitch==100&&viewShort(&s,0)==0,"mode %d pitch disturbed by a yaw push",mode);
+        /* back the other way: gun travels across the box before the view turns again */
+        simStep(&s,mode,8,0,boxY[mode]*2);
+        CHECK(s.a.free_yaw==boxY[mode]&&viewShort(&s,1)==-3300+boxY[mode],"mode %d return travel",mode);
+        float w[3];TCP_WeaponAngles(&s.a,s.view,w);
+        CHECK(fabsf(w[1]-(float)s16(s.now[1])*(360.f/65536.f))<1e-3f,"mode %d weapon yaw %.4f vs input %.4f",mode,w[1],(float)s16(s.now[1])*(360.f/65536.f));
+    }
+    /* 2. Random walk at 1/2/4/8 ms frames: view + offset == input on both axes after every command, the offsets
+     * never leave the box, and the view never moves while the weapon is inside the box. */
+    {int steps=0;for(int mode=2;mode<=3;mode++)for(int ms=1;ms<=8;ms*=2){sim_t s;simInit(&s);
+        for(int i=0;i<40000;i++){const int big=rnd(0,20)==0;int dp=big?rnd(-900,900):rnd(-12,12),dy=big?rnd(-1500,1500):rnd(-20,20);
+            const int op=s.a.free_pitch,oy=s.a.free_yaw,vp=viewShort(&s,0),vy=viewShort(&s,1);
+            simStep(&s,mode,ms,dp,dy);steps++;
+            CHECK(s16(viewShort(&s,0)+s.a.free_pitch-s.now[0])==0&&s16(viewShort(&s,1)+s.a.free_yaw-s.now[1])==0,
+                  "mode %d %d ms step %d: weapon %d,%d input %d,%d",mode,ms,i,viewShort(&s,0)+s.a.free_pitch,viewShort(&s,1)+s.a.free_yaw,s.now[0],s.now[1]);
+            CHECK(abs(s.a.free_pitch)<=boxP[mode]&&abs(s.a.free_yaw)<=boxY[mode],"box");
+            if(abs(op+dp)<=boxP[mode])CHECK(viewShort(&s,0)==vp,"pitch view moved inside the box");
+            if(abs(oy+dy)<=boxY[mode])CHECK(viewShort(&s,1)==vy,"yaw view moved inside the box");}}
+     printf("deadzone walk: %d commands at 1/2/4/8 ms, weapon direction == mouse input exactly, view still inside the box\n",steps);}
+    /* 3. Aimed: the offset eases to the centre, the view turns by the same amount (the weapon holds its world
+     * direction with no input), and the time to settle is about the same at every frame rate. */
+    {double t90[9]={0};for(int ms=1;ms<=8;ms*=2){sim_t s;simInit(&s);
+        simStep(&s,3,ms,0,0);simStep(&s,3,ms,600,-1200);s.a.aimed=1;
+        const int wp=viewShort(&s,0)+s.a.free_pitch,wy=viewShort(&s,1)+s.a.free_yaw;int t=0;
+        while(s.a.free_pitch||s.a.free_yaw){simStep(&s,3,ms,0,0);t+=ms;
+            CHECK(viewShort(&s,0)+s.a.free_pitch==wp&&viewShort(&s,1)+s.a.free_yaw==wy,"aimed ease moved the weapon");
+            if(!t90[ms]&&abs(s.a.free_yaw)<=120)t90[ms]=t;
+            CHECK(t<2000,"aimed ease never settles (%d ms frames)",ms);}
+        /* aimed input turns the view 1:1 */
+        const int vy=viewShort(&s,1);simStep(&s,3,ms,0,250);CHECK(viewShort(&s,1)==s16(vy+250)&&!s.a.free_yaw,"aimed input");}
+     CHECK(t90[1]>60&&t90[1]<140&&t90[8]>60&&t90[8]<140,"settle 90%% times %.0f / %.0f ms",t90[1],t90[8]);
+     printf("aimed: weapon holds its direction while the sights come to it; 90%% settled in %.0f/%.0f/%.0f/%.0f ms at 1/2/4/8 ms frames\n",t90[1],t90[2],t90[4],t90[8]);}
+    /* 4. Pack / unpack: mode 0-3 and the offsets ride the snapshot; continuing from an unpacked state gives the
+     * same result as the server's own state (client replay == server). */
+    {tcp_native_gun g;CHECK(TCP_GunInit(&g,100),"gun");
+     for(int mode=0;mode<4;mode++){sim_t s;simInit(&s);for(int i=0;i<50;i++)simStep(&s,mode,8,rnd(-60,60),rnd(-90,90));
+        tcp_lag_source src;memset(&src,0,sizeof(src));src.aim=&s.a;src.gun=&g;src.freeAim=mode;src.lastAngles[0]=s.prev[0];src.lastAngles[1]=s.prev[1];
+        playerState_t ps;memset(&ps,0,sizeof(ps));TCP_LagPack(&ps,&src);
+        tcp_lag_pred lp;CHECK(TCP_LagUnpack(&lp,&ps),"unpack");
+        CHECK(lp.freeAim==mode&&lp.aim.free_mode==mode&&lp.aim.free_pitch==s.a.free_pitch&&lp.aim.free_yaw==s.a.free_yaw,"round trip mode %d",mode);
+        sim_t c=s;c.a=lp.aim;
+        for(int i=0;i<200;i++){const int dp=rnd(-80,80),dy=rnd(-120,120),ms=rnd(1,9);simStep(&s,mode,ms,dp,dy);simStep(&c,mode,ms,dp,dy);
+            CHECK(s.delta[0]==c.delta[0]&&s.delta[1]==c.delta[1]&&s.a.free_pitch==c.a.free_pitch&&s.a.free_yaw==c.a.free_yaw,"replay diverged mode %d",mode);}}
+     puts("pack/unpack: modes 0-3 and offsets round trip; replay from the snapshot matches the server");}
+    /* 5. Mode change starts centred; off leaves the view alone. */
+    {sim_t s;simInit(&s);simStep(&s,2,8,0,0);simStep(&s,2,8,50,50);CHECK(s.a.free_pitch==50,"setup");
+     simStep(&s,0,8,10,10);CHECK(!s.a.free_pitch&&!s.a.free_yaw&&s.a.free_mode==0,"switch off");
+     float v[3]={1,2,0},w[3];TCP_WeaponAngles(&s.a,v,w);CHECK(w[0]==1&&w[1]==2,"off weapon angles");}
+    /* 6. Hip shots leave along view + offset: the mean of 400 M4 hip shots moves by exactly the offset (the hip
+     * sway point itself stays where TC:E puts it). */
+    {tcp_native_gun g;CHECK(TCP_GunInit(&g,100),"gun");float view[3]={-5,40,0},muzzle[3]={0,0,0};double mean[2][2];
+     for(int pass=0;pass<2;pass++){tcp_aim_state a;memset(&a,0,sizeof(a));a.free_mode=3;a.phase=250;if(pass){a.free_pitch=500;a.free_yaw=-1000;}
+        float w[3];TCP_WeaponAngles(&a,view,w);double m[3]={0,0,0};
+        for(int k=0;k<400;k++){g.seed=(uint32_t)(k*7919+3);float e[3];CHECK(TCP_AimEndpoint(&a,&g,w,muzzle,0,0,e),"endpoint");
+            double l=sqrt(e[0]*e[0]+e[1]*e[1]+e[2]*e[2]);for(int i=0;i<3;i++)m[i]+=e[i]/l;}
+        mean[pass][1]=atan2(m[1],m[0])*180/M_PI;mean[pass][0]=-atan2(m[2],sqrt(m[0]*m[0]+m[1]*m[1]))*180/M_PI;}
+     const double dp=mean[1][0]-mean[0][0],dy=mean[1][1]-mean[0][1],wp=500*360.0/65536,wy=-1000*360.0/65536;
+     CHECK(fabs(dp-wp)<.05&&fabs(dy-wy)<.05,"hip mean shot moved %.3f,%.3f for an offset of %.3f,%.3f",dp,dy,wp,wy);
+     printf("hip M4, offset (%.2f, %.2f) deg: mean shot moved (%.3f, %.3f) deg\n",wp,wy,dp,dy);}
+    puts("PASS: free aim deadzone");return 0;
+}
