index 0000000..372fbb7
--- /dev/null
+++ b/game_src/tests/stairs_map_probe.c
@@ -0,0 +1,59 @@
+/* GPL-3.0-or-later. 0.39.2 stairs and curbs map probe (test tool, not shipped): loads a map's collision with the
+ * engine's own cm_*.c, finds every step 2-18 u high that a player stands at (flat floor, near-vertical face, flat
+ * top), and walks TCP_Move into it from a standstill at a given frame time. Prints the steps that need a jump.
+ * Build (Linux): gcc -O2 -DMODLIB -I <etlegacy/src> stairs_map_probe.c ../native/tcp_move.c stairs_map_cm.o
+ *   <etlegacy/src>/qcommon/{cm_load,cm_patch,cm_polylib,cm_test,cm_trace,q_shared,q_math}.c (built -DDEDICATED) -lm
+ * Run: stairs_map_probe <map.bsp> [verbose 0/1] [frame ms 8/4/2/1]. */
+#include "../native/tcp_native.h"
+#include <stdio.h>
+#include <stdlib.h>
+void G_LoadMap(const char*);void G_Trace(trace_t*,const vec3_t,const vec3_t,const vec3_t,const vec3_t,int);int G_Contents(const vec3_t);void G_Bounds(vec3_t,vec3_t);
+static void tr(trace_t *t,const vec3_t a,const vec3_t lo,const vec3_t hi,const vec3_t b,int skip){(void)skip;G_Trace(t,a,lo,hi,b,TCP_MOVE_MASK);}
+static int pc(const vec3_t p,int pass){(void)pass;return G_Contents(p);}
+static const vec3_t mn={-14,-14,-24},mx={14,14,46},z0={0,0,0};
+static int MS=8;
+static int supported(const vec3_t o){
+    for(int i=0;i<5;i++){float ox=i==4?0:(i&1?13:-13),oy=i==4?0:(i&2?13:-13);vec3_t a={o[0]+ox,o[1]+oy,o[2]-23},b={a[0],a[1],o[2]-26};trace_t t;G_Trace(&t,a,z0,z0,b,TCP_MOVE_MASK);if(t.fraction==1||t.startsolid||t.plane.normal[2]<.95f)return 0;}
+    return 1;}
+static void walk(const vec3_t o,float yaw,int total,vec3_t out,float stopAt){
+    playerState_t p;memset(&p,0,sizeof(p));memcpy(p.origin,o,12);p.weapon=44;p.stats[TCP_STAT_STAMINA]=TCP_SPRINT_MAX;p.stats[TCP_STAT_PRIMARY_CLASS]=4;
+    p.viewangles[1]=yaw;p.groundEntityNum=ENTITYNUM_WORLD;p.viewheight=TCP_STAND_VIEWHEIGHT;
+    usercmd_t c;memset(&c,0,sizeof(c));c.forwardmove=127;c.angles[1]=ANGLE2SHORT(yaw);
+    const float dx=cosf(yaw*(float)M_PI/180),dy=sinf(yaw*(float)M_PI/180);
+    for(int t=MS;t<=total;t+=MS){c.serverTime=t;TCP_Move(&p,&c,tr);if((p.origin[0]-o[0])*dx+(p.origin[1]-o[1])*dy>=stopAt)break;}
+    memcpy(out,p.origin,12);}
+int main(int argc,char**argv){
+    if(argc<2){printf("usage: stairs_map_probe <map.bsp> [verbose] [ms]\n");return 2;}
+    G_LoadMap(argv[1]);TCP_SetContents(pc);const int verbose=argc>2?atoi(argv[2]):0;if(argc>3)MS=atoi(argv[3]);
+    vec3_t lo,hi;G_Bounds(lo,hi);int cand=0,fail=0;
+    for(float x=lo[0]+16;x<hi[0]-16;x+=32)for(float y=lo[1]+16;y<hi[1]-16;y+=32){
+        float z=hi[2]-50;
+        for(int lvl=0;lvl<8&&z>lo[2]+30;lvl++){
+            vec3_t a={x,y,z},b={x,y,lo[2]};trace_t t;G_Trace(&t,a,mn,mx,b,TCP_MOVE_MASK);
+            if(t.startsolid){z-=40;continue;}
+            if(t.fraction==1)break;
+            vec3_t P;memcpy(P,t.endpos,12);z=P[2]-90;
+            if(t.plane.normal[2]<.95f||!supported(P))continue;
+            for(int d=0;d<8;d++){
+                const float yaw=d*45.f,dx=cosf(yaw*(float)M_PI/180),dy=sinf(yaw*(float)M_PI/180);
+                vec3_t f={P[0]+dx*20,P[1]+dy*20,P[2]};G_Trace(&t,P,mn,mx,f,TCP_MOVE_MASK);
+                if(t.fraction==1||t.startsolid||fabsf(t.plane.normal[2])>.1f||-(t.plane.normal[0]*dx+t.plane.normal[1]*dy)<.7f)continue;
+                const float dist=t.fraction*20;
+                for(int h=1;h<=18;h++){
+                    vec3_t up={P[0],P[1],P[2]+h};G_Trace(&t,P,mn,mx,up,TCP_MOVE_MASK);if(t.fraction<1)break;
+                    vec3_t f2={up[0]+dx*20,up[1]+dy*20,up[2]};G_Trace(&t,up,mn,mx,f2,TCP_MOVE_MASK);
+                    if(t.fraction*20<dist+6)continue;
+                    vec3_t s;memcpy(s,t.endpos,12);vec3_t dn={s[0],s[1],s[2]-h-1};G_Trace(&t,s,mn,mx,dn,TCP_MOVE_MASK);
+                    if(t.startsolid||t.fraction==1||t.plane.normal[2]<.95f)break;
+                    const float rise=t.endpos[2]-P[2];if(rise<2)break;
+                    {vec3_t q={t.endpos[0]+dx*16,t.endpos[1]+dy*16,t.endpos[2]-23},q2={q[0],q[1],q[2]-3};trace_t u;G_Trace(&u,q,z0,z0,q2,TCP_MOVE_MASK);if(u.fraction==1||u.startsolid||u.plane.normal[2]<.95f)break;}
+                    cand++;vec3_t o;walk(P,yaw,1000,o,dist+10);
+                    const float adv=(o[0]-P[0])*dx+(o[1]-P[1])*dy;
+                    if(!(o[2]>P[2]+rise-1.5f&&adv>dist+6)){fail++;if(verbose)printf("NEEDS A JUMP at %.0f %.0f %.3f yaw %.0f step %.1f u\n",P[0],P[1],P[2],yaw,rise);}
+                    break;
+                }
+            }
+        }
+    }
+    printf("%s at %d ms: %d steps, %d need a jump (%.1f%%)\n",argv[1],MS,cand,fail,cand?100.*fail/cand:0);return 0;
+}
