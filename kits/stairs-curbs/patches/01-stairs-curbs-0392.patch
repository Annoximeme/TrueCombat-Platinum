+#include <stdlib.h>
+#include <stdarg.h>
+cvar_t *com_sv_running;
+static cvar_t dummy;
+cvar_t *Cvar_Get(const char *n,const char *v,cvarFlags_t f){static cvar_t c[64];static int k;cvar_t*x=&c[k++%64];x->value=atof(v);x->integer=atoi(v);x->string=(char*)v;return x;}
+void QDECL Com_Printf(const char *fmt,...){}
+void QDECL Com_DPrintf(const char *fmt,...){}
+void QDECL Com_Error(int code,const char *fmt,...){va_list a;va_start(a,fmt);vfprintf(stderr,fmt,a);va_end(a);exit(2);}
+unsigned Com_BlockChecksum(const void *b,size_t l){return 0;}
+void *Hunk_Alloc(size_t size,ha_pref p){return calloc(1,size);}
+void *(Z_Malloc)(size_t size){return calloc(1,size);}
