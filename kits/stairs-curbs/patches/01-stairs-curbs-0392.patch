+static const char *mapPath;
+int FS_ReadFile(const char *qpath,void **buffer){
+    FILE*f=fopen(strstr(qpath,".bsp")?mapPath:qpath,"rb");if(!f){if(buffer)*buffer=0;return -1;}
+    fseek(f,0,SEEK_END);long n=ftell(f);fseek(f,0,SEEK_SET);if(!buffer){fclose(f);return n;}
+    char*b=malloc(n+1);fread(b,1,n,f);b[n]=0;fclose(f);*buffer=b;return n;}
