diff --git a/game_src/native/tcp_immersion2_cg.h b/game_src/native/tcp_immersion2_cg.h
new file mode 100644
index 0000000..30d9019
--- /dev/null
+++ b/game_src/native/tcp_immersion2_cg.h
@@ -0,0 +1,123 @@
+/* GPL-3.0-or-later. TrueCombat: Platinum 0.39.0 immersion 2 (Gianni 2026-11-16 21:54Z picked B, C and D). Client only,
+ * sound and screen tint only: no aim, sway, spread or balance change.
+ *
+ *  B. Gear and mechanical sounds. Every footstep (own and other players, from tcp_audio.h taPlayStep) adds a quiet
+ *     gear rustle: walking or crouched softest, running louder, sprinting adds a magazine/gear rattle every other step;
+ *     prone crawling and standing still make none (no steps). Heard at the footstep ranges (walk 1200, run 1800,
+ *     sprint 2400 u) and always quieter than the step itself. The rustle and rattle are derived from sounds the game
+ *     ships (carpet footsteps, the M4 reload, a casing; imm2 tools/make_foley.py) in zz_platinum_immersion.pk3.
+ *     Firing the last round of a magazine gives the dry click (TC:E sound/weapons/misc/fire_dry.wav), own player.
+ *     cg_gearSounds 0 mutes both (default 1).
+ *  C. Low health (25 or less, own player): the 0.37.1 near-death breathing and pulsing edge (tcp_hud_vitals_cg.h
+ *     pvCues, drawn with pvEdgeRamp) now come with a slow heartbeat (1.2 s, quickening to 0.85 s near 1 HP; the
+ *     hard-hit heartbeat of tcp_viewfx.h waits while it runs), a slight muffle of game sound (the concussion
+ *     low-pass path, at most 0.22; follows cg_concussionMuffle) and gently drained colour (a grey wash, at most 14 %:
+ *     never hides a player). All of it eases out over ~0.5 s when healed and stops at death (the death camera takes
+ *     over). cg_lowHealthSound 0 mutes the heartbeat and the muffle; the colour drain is a fixed cue like the edge.
+ *  D. Heavy breathing after sprinting (own player): when stamina runs low after a sprint, breaths in and out, fast and
+ *     loud while spent, settling over a few seconds as stamina comes back. Not while the near-death breathing (C) or
+ *     the scope breathing (cg_enableBreath) runs, not when dead. cg_sprintBreath 0 mutes it (default 1).
+ * Console: imTest2 gear [sprint] | click | lowhp <0..1|off> | breath <0..1|off> (own screen, any server). */
+#ifndef TCP_IMMERSION2_CG_H
+#define TCP_IMMERSION2_CG_H
+
+static vmCvar_t im2GearCvar,im2LowCvar,im2BreathCvar;
+static sfxHandle_t im2Gear[4],im2Rattle[4],im2Dry,im2BreathIn[2],im2BreathOut[2];
+static int im2RattleStep[MAX_CLIENTS];
+
+/* ---- B. gear rustle and rattle on each footstep ------------------------------------------------------------- */
+/* From taPlayStep: kind 1 walk/crouch, 2 run, 3 sprint (TA_STEP_*); jump marks a jump or a landing. */
+static void im2Step(int client,int local,const vec3_t origin,const vec3_t listener,int kind,int jump){
+    if(kind<1||kind>3||client<0||client>=MAX_CLIENTS)return;
+    SystemCall(CG_CVAR_UPDATE,&im2GearCvar);if(!im2GearCvar.integer)return;
+    static const int vol[4]={0,22,36,48},range[4]={1,1200,1800,2400};
+    int v=vol[kind]+(jump?10:0);
+    if(!local){const float d=taDist(origin,listener);v=(int)(v*(1.f-d/range[kind]));if(v<=2)return;}
+    const sfxHandle_t g=im2Gear[rand()&3];
+    if(g){if(local)taLocal(g,CHAN_AUTO,v,SND_PITCHVAR);else{vec3_t at;VectorCopy(origin,at);SystemCall(CG_S_STARTSOUNDEX,at,client,CHAN_AUTO,g,SND_PITCHVAR,v);}}
+    if(kind==3&&((++im2RattleStep[client])&1)){const sfxHandle_t r=im2Rattle[rand()&3];const int rv=v*4/5;
+        if(r&&rv>2){if(local)taLocal(r,CHAN_AUTO,rv,SND_PITCHVAR);else{vec3_t at;VectorCopy(origin,at);SystemCall(CG_S_STARTSOUNDEX,at,client,CHAN_AUTO,r,SND_PITCHVAR,rv);}}}
+}
+/* The dry click when the own last round goes (shots up, magazine now empty). */
+static void im2DryClick(const playerState_t *p){
+    static int lastShots=-1,lastClient=-1;const int shots=p->stats[TCP_STAT_SHOTS];
+    if(p->clientNum!=lastClient){lastClient=p->clientNum;lastShots=shots;return;}
+    const int fired=((shots-lastShots)&65535)>0&&((shots-lastShots)&65535)<32768;lastShots=shots;
+    if(!fired||p->stats[STAT_HEALTH]<=0||(p->pm_flags&PMF_FOLLOW))return;
+    const int w=p->weapon;if(w==TCP_KNIFE_WEAPON||pmIsGrenade(w)||w==TCP_DYNAMITE_WEAPON||w==TCP_PLIERS_WEAPON||!TCP_GearWeapon(w))return;
+    if(p->holdable[TCP_HOLD_CLIPCAP]<=0||p->stats[TCP_STAT_CLIP]!=0)return;
+    SystemCall(CG_CVAR_UPDATE,&im2GearCvar);if(!im2GearCvar.integer||!im2Dry)return;
+    taLocal(im2Dry,CHAN_AUTO,110,0);
+}
+
+/* ---- C. low-health state --------------------------------------------------------------------------------------- */
+static float im2Low,im2LowForce=-1.f;static int im2LowLast,im2HeartAt;
+static float im2LowMuffle(void){SystemCall(CG_CVAR_UPDATE,&im2LowCvar);return im2LowCvar.integer?im2Low*.22f:0.f;}
+static void im2LowFrame(const playerState_t *p,int time){
+    const int health=p->stats[STAT_HEALTH],own=!(p->pm_flags&PMF_FOLLOW)&&p->pm_type==PM_NORMAL;
+    float target=own&&health>0&&health<=25?.35f+.65f*(1.f-(float)health/25.f):0.f;
+    if(im2LowForce>=0)target=im2LowForce;
+    const int dt=im2LowLast&&time>im2LowLast&&time-im2LowLast<250?time-im2LowLast:0;im2LowLast=time;
+    if(health<=0&&im2LowForce<0)im2Low=0; /* the death camera takes over at once */
+    else{const float step=dt/500.f;im2Low+=target>im2Low?fminf(step,target-im2Low):-fminf(step,im2Low-target);}
+    vfxLowHeart=im2Low>.05f;
+    SystemCall(CG_CVAR_UPDATE,&im2LowCvar);
+    if(im2Low>.05f&&im2LowCvar.integer&&vfxHeart&&time>=im2HeartAt){
+        SystemCall(CG_S_STARTLOCALSOUND,vfxHeart,CHAN_AUTO,(int)(70.f+50.f*im2Low));
+        im2HeartAt=time+(int)(1200.f-350.f*im2Low);
+    }else if(im2Low<=.05f)im2HeartAt=0;
+}
+static void im2LowScreen(void){
+    if(im2Low<=.01f)return;
+    const float c[4]={.42f,.42f,.42f,.14f*im2Low}; /* a grey wash: colour drained, contrast nearly unchanged */
+    SystemCall(CG_R_SETCOLOR,c);pic(0,0,(float)gl.vidWidth,(float)gl.vidHeight,0,0,1,1,white);SystemCall(CG_R_SETCOLOR,NULL);
+}
+
+/* ---- D. breathing after a sprint ---------------------------------------------------------------------------- */
+static int im2BreathAt,im2BreathStep,im2SprintAt;static float im2BreathForce=-1.f,im2Exert;
+static void im2Breath(const playerState_t *p,int time){
+    const int own=!(p->pm_flags&PMF_FOLLOW)&&p->pm_type==PM_NORMAL&&p->stats[STAT_HEALTH]>0;
+    const float speed=sqrtf(p->velocity[0]*p->velocity[0]+p->velocity[1]*p->velocity[1]);
+    if(own&&p->sprintExertTime&&speed>150.f)im2SprintAt=time?time:1;
+    const float stamina=fminf(1.f,fmaxf(0.f,p->stats[TCP_STAT_STAMINA]*5e-5f));
+    float want=own&&im2SprintAt&&time-im2SprintAt<9000&&time>=im2SprintAt?fminf(1.f,fmaxf(0.f,(.75f-stamina)/.6f)):0.f;
+    if(im2BreathForce>=0)want=im2BreathForce;
+    im2Exert+=(want-im2Exert)*.05f; /* settles over a few seconds */
+    SystemCall(CG_CVAR_UPDATE,&im2BreathCvar);
+    const int busy=p->stats[STAT_HEALTH]<=25||vfxSnd.scopeStart!=0; /* near-death or scope breathing runs */
+    if(!im2BreathCvar.integer||busy||im2Exert<.12f){if(im2Exert<.12f)im2BreathAt=0;return;}
+    if(time<im2BreathAt)return;
+    const int in=!(im2BreathStep&1);const sfxHandle_t s=in?im2BreathIn[(im2BreathStep>>1)&1]:im2BreathOut[(im2BreathStep>>1)&1];
+    if(s)SystemCall(CG_S_STARTLOCALSOUND,s,CHAN_LOCAL_SOUND,(int)(35.f+60.f*im2Exert));
+    im2BreathAt=time+(int)((in?620.f:760.f)+900.f*(1.f-im2Exert));im2BreathStep++;
+}
+
+/* ---- wiring ------------------------------------------------------------------------------------------------- */
+static void im2Init(void){
+    SystemCall(CG_CVAR_REGISTER,&im2GearCvar,"cg_gearSounds","1",CVAR_ARCHIVE);
+    SystemCall(CG_CVAR_REGISTER,&im2LowCvar,"cg_lowHealthSound","1",CVAR_ARCHIVE);
+    SystemCall(CG_CVAR_REGISTER,&im2BreathCvar,"cg_sprintBreath","1",CVAR_ARCHIVE);
+    char n[64];
+    for(int i=0;i<4;i++){snprintf(n,sizeof(n),"sound/platinum/imm/gear%d.wav",i+1);im2Gear[i]=(sfxHandle_t)SystemCall(CG_S_REGISTERSOUND,n,qfalse);
+        snprintf(n,sizeof(n),"sound/platinum/imm/rattle%d.wav",i+1);im2Rattle[i]=(sfxHandle_t)SystemCall(CG_S_REGISTERSOUND,n,qfalse);}
+    im2Dry=(sfxHandle_t)SystemCall(CG_S_REGISTERSOUND,"sound/weapons/misc/fire_dry.wav",qfalse);
+    for(int i=0;i<2;i++){snprintf(n,sizeof(n),"sound/misc/breathin%d.wav",i+1);im2BreathIn[i]=(sfxHandle_t)SystemCall(CG_S_REGISTERSOUND,n,qfalse);
+        snprintf(n,sizeof(n),"sound/misc/breathout%d.wav",i+1);im2BreathOut[i]=(sfxHandle_t)SystemCall(CG_S_REGISTERSOUND,n,qfalse);}
+    memset(im2RattleStep,0,sizeof(im2RattleStep));im2Low=0;im2LowLast=im2HeartAt=0;im2BreathAt=im2BreathStep=im2SprintAt=0;im2Exert=0;
+    char m[160];snprintf(m,sizeof(m),"TCP_IMS2 media gear=%d rattle=%d dry=%d breath=%d heart=%d\n",im2Gear[0],im2Rattle[0],im2Dry,im2BreathIn[0],vfxHeart);SystemCall(CG_PRINT,m);
+}
+/* Once per frame (from the scene pass), own player state. */
+static void im2Frame(const playerState_t *p,int time){im2DryClick(p);im2LowFrame(p,time);im2Breath(p,time);}
+static int im2Command(const char *cmd){
+    if(_stricmp(cmd,"imTest2"))return 0;
+    char a[32]="",b[32]="";SystemCall(CG_ARGV,1,a,sizeof(a));SystemCall(CG_ARGV,2,b,sizeof(b));
+    const playerState_t *p=&snap.ps;vec3_t eye={p->origin[0],p->origin[1],p->origin[2]+p->viewheight};
+    if(!_stricmp(a,"gear")){const int kind=!_stricmp(b,"sprint")?3:!_stricmp(b,"walk")?1:2;im2RattleStep[p->clientNum]=0;im2Step(p->clientNum,1,p->origin,eye,kind,0);}
+    else if(!_stricmp(a,"click")){if(im2Dry)taLocal(im2Dry,CHAN_AUTO,110,0);}
+    else if(!_stricmp(a,"lowhp")){im2LowForce=!_stricmp(b,"off")||!b[0]?-1.f:fminf(1.f,fmaxf(0.f,(float)atof(b)));}
+    else if(!_stricmp(a,"breath")){im2BreathForce=!_stricmp(b,"off")||!b[0]?-1.f:fminf(1.f,fmaxf(0.f,(float)atof(b)));}
+    else{SystemCall(CG_PRINT,"imTest2 gear [walk|sprint] | click | lowhp <0..1|off> | breath <0..1|off>\n");return 1;}
+    char m[120];snprintf(m,sizeof(m),"TCP_IMS2 %s %s low=%.2f exert=%.2f\n",a,b,im2Low,im2Exert);SystemCall(CG_PRINT,m);
+    return 1;
+}
+#endif
