+/* 0.39.1: after a GPU crash (device removed), say what the GPU was doing: the last finished operation of each
+ * command list (Windows' auto-breadcrumbs, DRED) and, after a page fault, the address and the resources around it.
+ * Enabled before the device is made (r_dx12CrashReport, default 1; Windows 10 1903 or newer). Goes to the console
+ * log, which the crash report already carries. */
+const char *DredOpName(D3D12_AUTO_BREADCRUMB_OP op)
+{
+	static const char *names[] = { "SetMarker", "BeginEvent", "EndEvent", "DrawInstanced", "DrawIndexedInstanced",
+		"ExecuteIndirect", "Dispatch", "CopyBufferRegion", "CopyTextureRegion", "CopyResource", "CopyTiles",
+		"ResolveSubresource", "ClearRenderTargetView", "ClearUnorderedAccessView", "ClearDepthStencilView",
+		"ResourceBarrier", "ExecuteBundle", "Present", "ResolveQueryData", "BeginSubmission", "EndSubmission" };
+	return (unsigned)op < sizeof(names) / sizeof(names[0]) ? names[op] : "other";
+}
+
+void DredReport()
+{
+	static bool reported = false;
+	ComPtr<ID3D12DeviceRemovedExtendedData> dred;
+
+	if (reported || !dx.device || FAILED(dx.device.As(&dred)))
+	{
+		return;
+	}
+	reported = true;
+	D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT crumbs = {};
+	if (SUCCEEDED(dred->GetAutoBreadcrumbsOutput(&crumbs)))
+	{
+		int lists = 0;
+		for (const D3D12_AUTO_BREADCRUMB_NODE *node = crumbs.pHeadAutoBreadcrumbNode; node && lists < 8; node = node->pNext)
+		{
+			UINT32 done = node->pLastBreadcrumbValue ? *node->pLastBreadcrumbValue : 0;
+			if (!node->pCommandHistory || done >= node->BreadcrumbCount)
+			{
+				continue; // this list finished: not where the GPU stopped
+			}
+			lists++;
+			char name[64] = "?";
+			if (node->pCommandListDebugNameA)
+				snprintf(name, sizeof(name), "%s", node->pCommandListDebugNameA);
+			else if (node->pCommandListDebugNameW)
+				snprintf(name, sizeof(name), "%ls", node->pCommandListDebugNameW);
+			Log(0, "DX12 crash: list '%s' stopped after %u of %u operations:\n", name, done, node->BreadcrumbCount);
+			for (UINT32 k = done > 6 ? done - 6 : 0; k < node->BreadcrumbCount && k < done + 3; k++)
+			{
+				Log(0, "DX12 crash:   %s %u %s\n", k < done ? "done" : k == done ? "FAULT?" : "next", k, DredOpName(node->pCommandHistory[k]));
+			}
+		}
+		if (!lists)
+		{
+			Log(0, "DX12 crash: every recorded command list had finished\n");
+		}
+	}
+	D3D12_DRED_PAGE_FAULT_OUTPUT fault = {};
+	if (SUCCEEDED(dred->GetPageFaultAllocationOutput(&fault)) && fault.PageFaultVA)
+	{
+		Log(0, "DX12 crash: page fault at GPU address 0x%llx\n", (unsigned long long)fault.PageFaultVA);
+		int n = 0;
+		for (const D3D12_DRED_ALLOCATION_NODE *a = fault.pHeadExistingAllocationNode; a && n < 6; a = a->pNext, n++)
+		{
+			Log(0, "DX12 crash:   live there: %s (type %d)\n", a->ObjectNameA ? a->ObjectNameA : "unnamed", (int)a->AllocationType);
+		}
+		n = 0;
+		for (const D3D12_DRED_ALLOCATION_NODE *a = fault.pHeadRecentFreedAllocationNode; a && n < 6; a = a->pNext, n++)
+		{
+			Log(0, "DX12 crash:   freed there: %s (type %d)\n", a->ObjectNameA ? a->ObjectNameA : "unnamed", (int)a->AllocationType);
+		}
+	}
+}
