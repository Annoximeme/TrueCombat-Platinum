index 527d524..634054e 100644
--- a/game_src/native/tcp_voice_cg.h
+++ b/game_src/native/tcp_voice_cg.h
@@ -119,10 +119,25 @@ static int vcConsoleCommand(const char *cmd){
     snprintf(line,sizeof(line),"%s %s",to,id);SystemCall(CG_SENDCLIENTCOMMAND,line);
     char m[120];snprintf(m,sizeof(m),"TCP_NATIVE_VOICE send %s\n",line);SystemCall(CG_PRINT,m);return 1;
 }
-/* The voice sprite over the speaker's head (ET CG_PlayerSprites: 8 units above the head). */
+/* The voice sprite over the speaker's head (ET CG_PlayerSprites: 8 units above the head).
+ * 0.39.1: the sprite draws through walls, so over an enemy (a global vsay, a combat voice line, local voice chat) it
+ * gave away where he stood. Now only over team mates of the player you see the game through (free spectators see
+ * all, free-for-all players see none). Off for everyone with g_voiceSprites 0 in the server info (missing = on);
+ * off for yourself with cg_voiceSprites 0. */
+static vmCvar_t vcSprites;static int vcSpritesReg;
+static int playerTeam(int slot);
+static int vcSpriteAllowed(void){
+    if(!vcSpritesReg){vcSpritesReg=1;SystemCall(CG_CVAR_REGISTER,&vcSprites,"cg_voiceSprites","1",CVAR_ARCHIVE);}
+    SystemCall(CG_CVAR_UPDATE,&vcSprites);if(!vcSprites.integer)return 0;
+    char v[8]="";TCP_InfoValue(config(CS_SERVERINFO),"g_voiceSprites",v,sizeof(v));return !v[0]||atoi(v)!=0;
+}
 static void vcFrame(int serverTime,int time,int self){
+    if(!vcSpriteAllowed())return;
+    const int free=snap.ps.pm_type==PM_SPECTATOR,mine=self>=0&&self<MAX_CLIENTS?playerTeam(self):0;
+    if(!free&&!mine)return;
     for(int i=0;i<snap.numEntities;i++){const entityState_t *e=&snap.entities[i];
         if(e->eType!=ET_PLAYER||e->number==self||e->number<0||e->number>=MAX_CLIENTS||vcSpriteUntil[e->number]<=time||(e->eFlags&EF_DEAD))continue;
+        if(!free&&playerTeam(e->number)!=mine)continue;
         vec3_t origin,angles;pmFollowPose(e,serverTime,time,origin,angles);
         refEntity_t ref;memset(&ref,0,sizeof(ref));ref.reType=RT_SPRITE;ref.customShader=vcSprite[e->number];
         origin[2]+=48.f+(e->eFlags&EF_CROUCHING?-16.f:0.f);VectorCopy(origin,ref.origin);VectorCopy(origin,ref.oldorigin);ref.radius=10.f;
