+/* audit 0.38.1: health is derived from the head/body/legs damage totals on every hit, so regenerated health has to come off
+ * those totals (body first, then legs, then head); written to health alone it was lost again at the next hit. */
+static void cqbHeal(tcp_region_health *h,int target){
+    if(!h||h->health<=0||target<=h->health)return;if(target>100)target=100;
+    int32_t *part[3]={&h->body,&h->legs,&h->head};
+    for(int k=0;k<3&&h->health<target;k++)while(*part[k]>0&&h->health<target){
+        --*part[k];int32_t now=h->health;
+        if(!tcp_health_from_regions(h->head,h->body,h->legs,0,TCP_HEALTH_WIDE,&now)||now>target){++*part[k];break;}
+        if(now>h->health)h->health=now;}
+}
+/* Protected / Tank: torso hits lose 10 / 20 % of the damage. Returns the scale for this hit (1 = none); the caller applies
+ * the hit again with the scaled damage (audit 0.38.1: health given back afterwards was lost at the next hit). */
+static float cqbArmorScale(int victim,int branch){
+    if(branch!=TCP_REGION_BODY_OR_TIE)return 1.f;
+    return cqbHas(victim,0,CQB_PROTECTED)||cqbHas(victim,0,CQB_TANK)?TCP_CqbBodyDamageScale(cqbPerkLive[victim][0]):1.f;
 }
 static int cqbKnife(int n,int damage){return cqbHas(n,1,CQB_COMMANDO)?(int)((float)damage*CQB_KNIFE_SCALE):damage;}
