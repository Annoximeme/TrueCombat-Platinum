+/* audit-11 (0.39.1): the stock round countdown, round result and scoreboard counted every round played on the map, so
+ * the knife round was "Round 1", the first match round "Round 2", and the scoreboard said WARMUP in the countdown of a
+ * live match. -1 = knife round, 1.. = match round, 0 = no match running (stock texts). */
+static int matchCgRound(void) { return !cgMatch.active || cgMatch.state < 2 || cgMatch.state == 6 ? 0 : cgMatch.state == 2 ? -1 : cgMatch.round > 0 ? cgMatch.round : 1; }
+static int matchCgRounds(void) { return cgMatch.rounds > 0 ? cgMatch.rounds : 1; }
+static const char *matchCgStage(char *out, size_t size)
+{
+    if (!cgMatch.active || cgMatch.state < 2) return NULL;
+    if (cgMatch.state == 2) snprintf(out, size, "KNIFE ROUND");
+    else if (cgMatch.state == 6) snprintf(out, size, "FINAL");
+    else if (cgMatch.state == 5) snprintf(out, size, "HALF-TIME");
+    else snprintf(out, size, "ROUND %d / %d", cgMatch.round, cgMatch.rounds);
+    return out;
+}
