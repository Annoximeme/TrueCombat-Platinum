 #define TCP_STANCE_LEDGEGRAB 0x8
+/* audit-09 (0.39.1): the sprint state for the client. ps.sprintExertTime is not sent, so every frame's prediction
+ * started from 0: out of breath with the sprint key held, the client predicted a sprint the server did not run
+ * (gun in the sprint pose, position ahead of the server's). sprint() in tcp_move.c keeps the two bits; the client
+ * calls TCP_SprintRestore on the snapshot's state before it predicts. Older servers never set them. */
+#define TCP_STANCE_WINDED 0x10
+#define TCP_STANCE_SPRINTING 0x20
