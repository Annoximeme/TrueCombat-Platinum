+    const float at=(d[0]*x[0]+d[1]*x[1]+d[2]*x[2])/l2,gap=maxs[0]-at;
+    if(gap>.25f&&gap<6.f){VectorMA(flash->origin,gap,x,flash->origin);VectorCopy(flash->origin,flash->oldorigin);}
+}
